---
import Layout from '../layouts/Layout.astro';
import Statistics from '../components/Statistics.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Features from '../components/Features.astro';
import QuickStart from '../components/QuickStart.astro';
import AppStore from '../components/AppStore.astro';
import Community from '../components/Community.astro';
import Partners from '../components/Partners.astro';
import CTA from '../components/CTA.astro';
import Footer from '../components/Footer.astro';
import LanguageModal from '../components/LanguageModal.astro';
import {
  SITE_URL,
  createSoftwareApplicationSchema,
} from '../lib/seo';
import '../styles/global.css';

const siteUrl = Astro.site?.toString() ?? SITE_URL;
---

<Layout
  title="1Panel - 现代化、开源的 Linux 服务器运维管理面板"
  socialTitle="1Panel 官网 - 现代化、开源的 Linux 服务器运维管理面板"
  schemaName="1Panel 官网"
  description="1Panel 是一款现代化的开源 Linux 服务器运维管理面板，同时也是轻量级的 AI 管理平台。它通过直观的 Web 界面，为用户提供一站式的服务器管理能力。"
  canonical="/"
  keywords={[
    "1Panel",
    "1Panel 官网",
    "Linux 面板",
    "Linux 服务器运维管理面板",
    "开源 Linux 面板",
    "Docker 管理",
    "容器管理",
    "服务器运维",
    "应用商店",
    "网站管理",
    "数据库管理",
    "OpenClaw",
    "AI 模型管理",
    "本地 AI 部署",
    "AI 一体机",
    "AI 门户",
    "AI 网关",
  ]}
  structuredData={[createSoftwareApplicationSchema(siteUrl)]}
>
  <Statistics slot="head" />
  <Fragment slot="main">
    <Header />
    <main>
      <Hero />
      <Features />
      <AppStore />
      <QuickStart />
      <Community />
      <Partners />
    </main>
    <Footer />
    <LanguageModal />
  </Fragment>
</Layout>

<style>
  main {
    position: relative;
    z-index: 1;
  }
</style>
