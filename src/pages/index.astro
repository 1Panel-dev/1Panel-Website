---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Features from '../components/Features.astro';
import QuickStart from '../components/QuickStart.astro';
import AppStore from '../components/AppStore.astro';
import Footer from '../components/Footer.astro';
import { getTranslations, t, getBasePath } from '../i18n/utils';
import { SUPPORTED_LOCALES } from '../i18n/config';
const lang = 'en';
const translations = getTranslations(lang);
const basePath = getBasePath(undefined);
const title = t(translations, 'meta.defaultTitle');
const description = t(translations, 'meta.defaultDescription');
const ogDescription = t(translations, 'meta.ogDescription');
const canonicalUrl = new URL('/', Astro.site).href;
const softwareJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: '1Panel',
  applicationCategory: 'ServerApplication',
  operatingSystem: 'Linux',
  description,
  url: canonicalUrl,
  softwareVersion: 'V2',
  featureList: [
    'AI model deployment with Ollama',
    'Docker container management',
    'One-click website deployment (WordPress, PHP runtime)',
    'Database management (MySQL, PostgreSQL, Redis, MongoDB)',
    'File management with online editor',
    'SSL certificate management',
    'Backup and restore',
    'AI Portal — self-service API Key management',
    'AI Gateway — unified model access and routing',
    'Skills Hub — reusable skill marketplace',
    'VM management — KVM web UI',
    'Security ops reports — audit and compliance',
  ],
  offers: [
    {
      '@type': 'Offer',
      price: '0',
      priceCurrency: 'USD',
      description: 'Open-source edition — free forever',
    },
    {
      '@type': 'Offer',
      price: '80',
      priceCurrency: 'USD',
      description: 'Pro Edition subscription — per year',
    },
    {
      '@type': 'Offer',
      price: '200',
      priceCurrency: 'USD',
      description: 'Pro Edition perpetual license — one-time payment',
    },
  ],
  publisher: {
    '@type': 'Organization',
    name: 'FIT2CLOUD',
    url: 'https://www.fit2cloud.com/',
  },
  author: {
    '@type': 'Organization',
    name: 'FIT2CLOUD',
    url: 'https://www.fit2cloud.com/',
  },
};
---

<Layout title={title} description={description} ogDescription={ogDescription} lang={lang} basePath={basePath} canonicalUrl={canonicalUrl} enableHomepageStats={true}>
  <Fragment slot="head">
    {SUPPORTED_LOCALES.map((loc) => (
      <link
        rel="alternate"
        hreflang={loc}
        href={new URL(loc === 'en' ? '/' : `/${loc}`, Astro.site).href}
      />
    ))}
    <link rel="alternate" hreflang="x-default" href={new URL('/', Astro.site).href} />
    <!-- 性能：提前与应用图标 CDN 建立连接，省去首次取图时的 DNS + TCP + TLS 往返 -->
    <link rel="preconnect" href="https://apps-assets.fit2cloud.com" crossorigin />
    <link rel="dns-prefetch" href="https://apps-assets.fit2cloud.com" />
    <!-- 性能：预载首屏 LCP 图片（WebP），避免等 HTML 解析完才开始下载 -->
    <link rel="preload" as="image" href="/images/overview-full.webp" type="image/webp" fetchpriority="high" />
    <script type="application/ld+json" set:html={JSON.stringify(softwareJsonLd)} />
  </Fragment>
  <Fragment slot="main">
    <Header lang={lang} basePath={basePath} translations={translations} />
    <main>
      <Hero lang={lang} basePath={basePath} translations={translations} />
      <Features lang={lang} basePath={basePath} translations={translations} />
      <AppStore lang={lang} basePath={basePath} translations={translations} />
      <QuickStart lang={lang} basePath={basePath} translations={translations} />
    </main>
    <Footer lang={lang} basePath={basePath} translations={translations} />
  </Fragment>
</Layout>

<style>
  main {
    position: relative;
    z-index: 1;
  }
</style>
