---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import Statistics from "../../components/Statistics.astro";
import { Icon } from "astro-icon/components";
import {
  SITE_URL,
  createBreadcrumbSchema,
  toAbsoluteUrl,
} from "../../lib/seo";
import "../../styles/global.css";

const siteUrl = Astro.site?.toString() ?? SITE_URL;
const pageUrl = toAbsoluteUrl("/ai-portal.html", siteUrl);
const trialUrl = "mailto:sales@lxware.hk?subject=1Panel Enterprise Trial";
const repositoryUrl = "https://github.com/1Panel-dev/AI-Portal";

const portalKeywords = [
  "Self-Service API Key",
  "View Usage",
  "Install Skills",
  "Model Hub",
  "MCP Marketplace",
  "Admin Console",
];

const capabilityCards = [
  {
    icon: "carbon:api-key",
    title: "Self-Service API Key",
    advantage:
      "Provides internal users with self-service API Key application, viewing, reset, and deletion, along with usage tracking.",
  },
  {
    icon: "carbon:machine-learning-model",
    title: "Model Hub",
    advantage:
      "Displays available models from 1Panel AI Gateway in one place, helping users quickly discover model resources and access endpoints.",
  },
  {
    icon: "carbon:store",
    title: "Skills Marketplace",
    advantage:
      "Showcases published 1Panel Skills, supporting browsing by category, search, and installation.",
  },
  {
    icon: "carbon:network-4",
    title: "MCP Marketplace",
    advantage:
      "Displays and manages available MCP services for 1Panel MCP scenarios.",
  },
  {
    icon: "carbon:review",
    title: "Skill Submission & Review",
    advantage:
      "Supports user skill package uploads, with admin review, publishing, and maintenance of listed content.",
  },
  {
    icon: "carbon:settings-services",
    title: "Admin Console",
    advantage:
      "Provides skill management, user management, OAuth login configuration, and integration with enterprise communication tools like WeCom, DingTalk, and Lark, as well as 1Panel Gateway.",
  },
];

const operationSteps = [
  {
    icon: "carbon:user-access",
    title: "User Self-Service",
    description:
      "Provides a self-service portal for internal users to apply for API Keys, view usage, install Skills, and more.",
    points: ["Self-Service API Key", "View Usage", "Install Skills"],
  },
  {
    icon: "carbon:headset",
    title: "Marketplace Distribution",
    description:
      "Model Hub, Skills Marketplace, and MCP Marketplace display available capabilities in one place, letting users find resources by category, search, or detail pages.",
    points: ["Browse Model Resources", "Install Skills", "MCP Service Discovery"],
  },
  {
    icon: "carbon:gateway",
    title: "Admin Operations",
    description:
      "Administrators maintain skills, users, OAuth login, enterprise communication tool integrations, and 1Panel Gateway configuration to ensure long-term stable portal operation.",
    points: ["Skill Review & Publish", "Users & Login", "Communication Tool Integration"],
  },
];

const pageTitle = "1Panel AI Portal - Enterprise Self-Service AI Capability Hub";
const pageDescription =
  "1Panel AI Portal provides a self-service hub for internal enterprise users to apply for API Keys, view usage, install Skills, and integrates with WeCom, DingTalk, and Lark for unified login and user management.";
const aiPortalSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "@id": `${pageUrl}#product`,
  name: "1Panel AI Portal",
  alternateName: "1Panel AI Portal",
  applicationCategory: "DeveloperApplication",
  applicationSubCategory: "AI portal",
  operatingSystem: "Linux",
  description: pageDescription,
  url: pageUrl,
  downloadUrl: repositoryUrl,
  sameAs: [repositoryUrl],
  audience: {
    "@type": "BusinessAudience",
    audienceType: "1Panel Enterprise users, internal enterprise AI teams, administrators",
  },
  featureList: [
    "Self-Service API Key",
    "View Usage",
    "Model Hub",
    "Skills Marketplace",
    "Install Skills",
    "MCP Marketplace",
    "Skill Submission & Review",
    "Admin Console",
    "OAuth Login Configuration",
    "WeCom, DingTalk, Lark Integration",
    "Employee Unified Login",
    "Organizational Collaboration",
    "1Panel Gateway Configuration",
  ],
  publisher: {
    "@type": "Organization",
    name: "FIT2CLOUD Hangzhou",
  },
};

import { NON_DEFAULT_LOCALES } from '../../i18n/config';
import { getTranslations, t, getBasePath } from '../../i18n/utils';

export function getStaticPaths() {
  return NON_DEFAULT_LOCALES.map((lang) => ({ params: { lang }, props: { lang } }));
}

const { lang } = Astro.params;
const translations = getTranslations(lang ?? 'en');
const enFallback = getTranslations('en');
const basePath = getBasePath(lang);
function tt(p) {
  const val = t(translations, p);
  return val !== p ? val : t(enFallback, p);
}
---

<Layout
  title={pageTitle}
  socialTitle="1Panel AI Portal"
  schemaName="1Panel AI Portal"
  description={pageDescription}
  canonical="/ai-portal.html"
  image="/images/enterprise-ai-portal.png"
  imageWidth={2440}
  imageHeight={1930}
  imageAlt="1Panel AI Portal Model Hub Interface"
  keywords={[
    "1Panel AI Portal",
    "AI Portal",
    "API Key Management",
    "Self-Service API Key",
    "View Usage",
    "Model Hub",
    "Skills Marketplace",
    "Install Skills",
    "MCP Marketplace",
    "Skill Submission & Review",
    "WeCom",
    "DingTalk",
    "Lark",
    "Enterprise Communication",
    "Employee Unified Login",
    "1Panel Enterprise",
  ]}
  structuredData={[
    createBreadcrumbSchema([
      { name: "1Panel", url: toAbsoluteUrl("/", siteUrl) },
      { name: "1Panel AI Portal", url: pageUrl },
    ]),
    aiPortalSchema,
  ]}
>
  <Statistics slot="head" />
  <Fragment slot="main">
    <Header lang={lang} basePath={basePath} translations={translations} />
    <main class="relative z-10 bg-white text-gray-800">
      <section class="relative overflow-hidden bg-gradient-to-b from-blue-50/80 via-white to-white pt-20 pb-16 lg:pt-28 lg:pb-24">
        <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-blue-200 to-transparent"></div>
        <div class="container-custom">
          <div class="mx-auto max-w-4xl text-center">
            <a href="/enterprise.html" class="fade-in-up mb-6 inline-flex items-center justify-center rounded-full border border-blue-100 bg-white px-4 py-2 text-sm font-semibold text-1panel shadow-sm transition-all duration-300 hover:border-blue-200 hover:bg-blue-50" style="animation-delay: 0.05s;">
              <Icon name="carbon:arrow-left" class="mr-2 h-4 w-4" />
              Back to Enterprise
            </a>
            <h1 class="fade-in-up text-4xl font-bold leading-tight tracking-normal text-gray-950 sm:text-5xl lg:text-6xl" style="animation-delay: 0.1s;">
              1Panel AI Portal
            </h1>
            <p class="fade-in-up mt-6 text-lg leading-relaxed text-gray-600 sm:text-xl" style="animation-delay: 0.2s;">
              A self-service hub for internal enterprise users to apply for API Keys, view usage, install Skills, and access the Model Hub and MCP Marketplace in one place.
            </p>
            <div class="fade-in-up mt-8 flex flex-wrap justify-center gap-3" style="animation-delay: 0.3s;">
              {portalKeywords.map((keyword) => (
                <span class="rounded-md border border-blue-100 bg-white px-4 py-2 text-sm font-semibold text-1panel shadow-sm">
                  {keyword}
                </span>
              ))}
            </div>
            <div class="fade-in-up mt-7 flex flex-col items-center justify-center gap-3 sm:flex-row" style="animation-delay: 0.32s;">
              <a href={trialUrl} class="btn-primary inline-flex items-center justify-center px-9 py-4 text-base">
                Request a Trial
                <Icon name="carbon:arrow-right" class="ml-2 h-5 w-5" />
              </a>
            </div>
          </div>

          <div class="fade-in-up mx-auto mt-8 max-w-5xl" style="animation-delay: 0.35s;">
            <div class="relative overflow-hidden rounded-lg shadow-2xl shadow-blue-100/70">
              <div class="relative overflow-hidden rounded-lg bg-gray-50">
                <img
                  src="/images/enterprise-ai-portal.png"
                  alt="1Panel AI Portal Model Hub Interface"
                  class="h-auto w-full object-cover"
                  loading="eager"
                />
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="py-16 lg:py-24">
        <div class="container-custom">
          <div class="mx-auto mb-12 max-w-3xl text-center">
            <h2 class="text-3xl font-bold leading-tight text-gray-900 lg:text-5xl">
              Self-Service Hub, Unified Operations
            </h2>
            <p class="mt-5 text-lg leading-relaxed text-gray-600">
              Centered on API Keys, usage, models, Skills, MCP services, and enterprise communication tool integrations, making it easier for internal users to access AI capabilities while admins manage users, login, and review processes.
            </p>
          </div>

          <div class="grid grid-cols-1 gap-5 md:grid-cols-2 lg:grid-cols-3">
            {capabilityCards.map((capability, index) => (
              <article
                class="fade-in-up rounded-lg border border-gray-100 bg-white p-6 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:border-blue-100 hover:shadow-xl"
                style={`animation-delay: ${index * 0.05}s;`}
              >
                <span class="mb-5 inline-flex h-12 w-12 items-center justify-center rounded-lg bg-blue-50 text-1panel">
                  <Icon name={capability.icon} class="h-6 w-6" />
                </span>
                <h3 class="text-xl font-bold text-gray-900">{capability.title}</h3>
                <p class="mt-3 text-sm leading-relaxed text-gray-600">
                  {capability.advantage}
                </p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="bg-gray-50 py-16 lg:py-24">
        <div class="container-custom">
          <div class="mx-auto mb-12 max-w-3xl text-center">
            <h2 class="text-3xl font-bold leading-tight text-gray-900 lg:text-5xl">
              Connecting Users, Marketplace & Admin
            </h2>
            <p class="mt-5 text-lg leading-relaxed text-gray-600">
              The AI Portal brings self-service workflows, employee unified login, and admin operations capabilities together under the same enterprise governance framework.
            </p>
          </div>

          <div class="grid grid-cols-1 gap-5 lg:grid-cols-3">
            {operationSteps.map((step, index) => (
              <article
                class="fade-in-up flex h-full flex-col rounded-lg border border-gray-100 bg-white p-6 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:border-blue-100 hover:shadow-xl"
                style={`animation-delay: ${index * 0.08}s;`}
              >
                <div class="mb-5 flex items-center justify-between gap-4">
                  <span class="inline-flex h-12 w-12 items-center justify-center rounded-lg bg-blue-50 text-1panel">
                    <Icon name={step.icon} class="h-6 w-6" />
                  </span>
                  <span class="rounded-full bg-gray-50 px-3 py-1 text-xs font-semibold text-gray-500">
                    0{index + 1}
                  </span>
                </div>
                <h3 class="text-xl font-bold text-gray-900">{step.title}</h3>
                <p class="mt-3 flex-1 text-sm leading-relaxed text-gray-600">
                  {step.description}
                </p>
                <div class="mt-5 flex flex-wrap gap-2">
                  {step.points.map((point) => (
                    <span class="rounded-md bg-blue-50 px-3 py-1 text-xs font-semibold text-1panel">{point}</span>
                  ))}
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="bg-white py-16 lg:py-24">
        <div class="container-custom">
          <div class="overflow-hidden rounded-lg border border-blue-100 bg-gradient-to-r from-blue-50 to-white p-6 shadow-sm sm:p-8 lg:p-10">
            <div class="grid grid-cols-1 items-center gap-8 lg:grid-cols-[1fr_auto]">
              <div>
                <h2 class="text-2xl font-bold text-gray-900 lg:text-3xl">
                  AI Self-Service Portal for 1Panel Enterprise
                </h2>
                <p class="mt-4 max-w-3xl text-base leading-relaxed text-gray-600">
                  1Panel AI Portal consolidates self-service API Key requests, usage dashboards, the Model Hub, Skills Marketplace, MCP Marketplace, skill submission & review, and admin configuration into a single entry point. It also integrates with enterprise communication tools such as WeCom, DingTalk, and Feishu, supporting enterprise user management, unified employee login, and organizational collaboration — helping enterprises keep AI capabilities open, operable, and manageable.
                </p>
              </div>
              <a href="/enterprise.html" class="btn-primary inline-flex items-center justify-center px-8 py-4 text-base">
                Learn About Enterprise
                <Icon name="carbon:arrow-right" class="ml-2 h-5 w-5" />
              </a>
            </div>
          </div>
        </div>
      </section>
    </main>
    <Footer lang={lang} basePath={basePath} translations={translations} />
  </Fragment>
</Layout>
