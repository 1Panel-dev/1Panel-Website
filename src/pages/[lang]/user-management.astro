---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Statistics from '../../components/Statistics.astro';
import { Icon } from 'astro-icon/components';
import {
  SITE_URL,
  createBreadcrumbSchema,
  toAbsoluteUrl,
} from "../../lib/seo";
import '../../styles/global.css';

import { NON_DEFAULT_LOCALES } from '../../i18n/config';
import { getTranslations, t, getBasePath } from '../../i18n/utils';

const { lang } = Astro.params;
const translations = getTranslations(lang ?? 'en');
const enFallback = getTranslations('en');
const basePath = getBasePath(lang);
function tt(p) {
  const val = t(translations, p);
  return val !== p ? val : t(enFallback, p);
}

const siteUrl = Astro.site?.toString() ?? SITE_URL;
const pageUrl = toAbsoluteUrl("/user-management.html", siteUrl);
const trialUrl = "mailto:sales@lxware.hk?subject=1Panel Enterprise Trial";

const userManagementKeywords = [
  "User Management",
  "Permission Assignment",
  "Multi-Role Collaboration",
  "Enterprise Access Control",
  "Collaborative Use",
];

const capabilityCards = [
  {
    icon: "carbon:user-multiple",
    title: "Unified User Management",
    advantage: "Centrally manage internal enterprise user accounts within 1Panel.",
    benefit: "Simplifies enterprise member information maintenance, improving user management efficiency.",
  },
  {
    icon: "carbon:user-role",
    title: "Permission Assignment",
    advantage: "Assign appropriate permissions based on different users, departments, or roles.",
    benefit:
      "Helps organizations control the operational scope of different members, reducing risks of misoperation and privilege escalation.",
  },
  {
    icon: "carbon:application",
    title: "Multi-Role Collaboration",
    advantage:
      "Supports cross-department and internal multi-role usage scenarios, enabling different members to collaborate on 1Panel.",
    benefit:
      "Meets enterprise team collaboration needs, allowing different roles to participate in system management as needed.",
  },
  {
    icon: "carbon:settings",
    title: "Role Permission Management",
    advantage: "Unified configuration and maintenance of permission rules by role.",
    benefit:
      "Reduces repetitive configuration costs, improving consistency and maintainability of permission management.",
  },
  {
    icon: "carbon:security",
    title: "Enterprise Access Control",
    advantage: "Granular management of user access and feature operations.",
    benefit:
      "Enhances the security, standardization, and controllability of 1Panel in enterprise scenarios.",
  },
  {
    icon: "carbon:network-4",
    title: "Collaborative Use",
    advantage: "Multiple users can jointly use and manage 1Panel based on their respective permissions.",
    benefit:
      "Improves team collaboration efficiency, avoiding the management pressure of a single-administrator model.",
  },
];

const pageTitle = tt('userManagement.pageTitle');
const pageDescription = tt('userManagement.pageDescription');
const userManagementSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "@id": `${pageUrl}#product`,
  name: "1Panel User Management",
  applicationCategory: "DeveloperApplication",
  applicationSubCategory: "User and permission management",
  operatingSystem: "Linux",
  description: pageDescription,
  url: pageUrl,
  featureList: [
    "Unified User Management",
    "Permission Assignment",
    "Multi-Role Collaboration",
    "Role Permission Management",
    "Enterprise Access Control",
    "Collaborative Use",
  ],
  publisher: {
    "@type": "Organization",
    name: "FIT2CLOUD Hangzhou",
  },
};

export function getStaticPaths() {
  return NON_DEFAULT_LOCALES.map((lang) => ({ params: { lang }, props: { lang } }));
}
---

<Layout
  title={pageTitle}
  socialTitle="1Panel User Management"
  schemaName="1Panel User Management"
  description={pageDescription}
  canonical="/user-management.html"
  image="/images/enterprise-user-management.png"
  imageWidth={3432}
  imageHeight={2172}
  imageAlt="1Panel User Management"
  keywords={[
    "1Panel User Management",
    "User Management",
    "Permission Assignment",
    "Multi-Role Collaboration",
    "Role Permission Management",
    "Enterprise Access Control",
    "Collaborative Use",
    "Multi-User Management",
  ]}
  structuredData={[
    createBreadcrumbSchema([
      { name: "1Panel", url: toAbsoluteUrl("/", siteUrl) },
      { name: "1Panel User Management", url: pageUrl },
    ]),
    userManagementSchema,
  ]}
>
  <Statistics slot="head" />
  <Fragment slot="main">
    <Header lang={lang} basePath={basePath} translations={translations} />
    <main class="relative z-10 bg-white text-gray-800">
      <section class="relative overflow-hidden bg-gradient-to-b from-blue-50/80 via-white to-white pt-20 pb-16 lg:pt-28 lg:pb-24">
        <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-blue-200 to-transparent"></div>
        <div class="container-custom">
          <div class="mx-auto max-w-4xl text-center">
            <a href="/enterprise-edition.html" class="fade-in-up mb-6 inline-flex items-center justify-center rounded-full border border-blue-100 bg-white px-4 py-2 text-sm font-semibold text-1panel shadow-sm transition-all duration-300 hover:border-blue-200 hover:bg-blue-50" style="animation-delay: 0.05s;">
              <Icon name="carbon:arrow-left" class="mr-2 h-4 w-4" />
              Back to Enterprise
            </a>
            <h1 class="fade-in-up text-4xl font-bold leading-tight tracking-normal text-gray-950 sm:text-5xl lg:text-6xl" style="animation-delay: 0.1s;">
              User Management
            </h1>
            <p class="fade-in-up mt-6 text-lg leading-relaxed text-gray-600 sm:text-xl" style="animation-delay: 0.2s;">
              Supports cross-department and internal multi-role usage scenarios with user and permission management.
            </p>
            <div class="fade-in-up mt-8 flex flex-wrap justify-center gap-3" style="animation-delay: 0.3s;">
              {userManagementKeywords.map((keyword) => (
                <span class="rounded-md border border-blue-100 bg-white px-4 py-2 text-sm font-semibold text-1panel shadow-sm">
                  {keyword}
                </span>
              ))}
            </div>
            <a href={trialUrl} class="btn-primary fade-in-up mt-7 inline-flex items-center justify-center px-9 py-4 text-base" style="animation-delay: 0.32s;">
              Request a Trial
              <Icon name="carbon:arrow-right" class="ml-2 h-5 w-5" />
            </a>
          </div>

          <div class="fade-in-up mt-8" style="animation-delay: 0.35s;">
            <div class="relative overflow-hidden rounded-lg shadow-2xl shadow-blue-100/70">
              <div class="relative overflow-hidden rounded-lg bg-gray-50">
                <img
                  src="/images/enterprise-user-management.png"
                  alt="1Panel User Management Features"
                  class="h-auto w-full object-cover"
                  loading="eager"
                />
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="py-16 lg:py-24">
        <div class="container-custom">
          <div class="mx-auto mb-12 max-w-3xl text-center">
            <h2 class="text-3xl font-bold leading-tight text-gray-900 lg:text-5xl">
              User Management, Permission Assignment
            </h2>
            <p class="mt-5 text-lg leading-relaxed text-gray-600">
              Centered on user accounts, role permissions, and access control, supporting internal multi-role collaboration with 1Panel.
            </p>
          </div>

          <div class="grid grid-cols-1 gap-5 md:grid-cols-2 lg:grid-cols-3">
            {capabilityCards.map((capability, index) => (
              <article
                class="fade-in-up rounded-lg border border-gray-100 bg-white p-6 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:border-blue-100 hover:shadow-xl"
                style={`animation-delay: ${index * 0.05}s;`}
              >
                <span class="mb-5 inline-flex h-12 w-12 items-center justify-center rounded-lg bg-blue-50 text-1panel">
                  <Icon name={capability.icon} class="h-6 w-6" />
                </span>
                <h3 class="text-xl font-bold text-gray-900">{capability.title}</h3>
                <p class="mt-3 text-sm leading-relaxed text-gray-600">
                  <span class="font-semibold text-gray-800">Function: </span>{capability.advantage}
                </p>
                <p class="mt-3 text-sm leading-relaxed text-gray-600">
                  <span class="font-semibold text-gray-800">Value: </span>{capability.benefit}
                </p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="bg-white py-16 lg:py-24">
        <div class="container-custom">
          <div class="overflow-hidden rounded-lg border border-blue-100 bg-gradient-to-r from-blue-50 to-white p-6 shadow-sm sm:p-8 lg:p-10">
            <div class="grid grid-cols-1 items-center gap-8 lg:grid-cols-[1fr_auto]">
              <div>
                <h2 class="text-2xl font-bold text-gray-900 lg:text-3xl">
                  Multi-User & Permission Management for Enterprise Teams
                </h2>
                <p class="mt-4 max-w-3xl text-base leading-relaxed text-gray-600">
                  User Management supports cross-department and internal multi-role usage scenarios, providing user management, permission assignment, and collaborative use capabilities. By centrally managing user accounts, configuring role permissions, and controlling the operational scope of different members, it helps enterprises enhance the security, standardization, and management efficiency of 1Panel in team collaboration scenarios.
                </p>
              </div>
              <a href="/enterprise-edition.html" class="btn-primary inline-flex items-center justify-center px-8 py-4 text-base">
                Learn About Enterprise
                <Icon name="carbon:arrow-right" class="ml-2 h-5 w-5" />
              </a>
            </div>
          </div>
        </div>
      </section>
    </main>
    <Footer lang={lang} basePath={basePath} translations={translations} />
  </Fragment>
</Layout>
