---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Statistics from '../components/Statistics.astro';
import { Icon } from 'astro-icon/components'
import {
  SITE_URL,
  createBreadcrumbSchema,
  toAbsoluteUrl,
} from "../lib/seo";
import '../styles/global.css';

const siteUrl = Astro.site?.toString() ?? SITE_URL;
const openClawPageUrl = toAbsoluteUrl("/openclaw.html", siteUrl);
const aiCodingPageUrl = toAbsoluteUrl("/aicoding.html", siteUrl);
const pageTitle = "1Panel AI Assistant Appliance (GB10 Edition) - Team-Level Local AI Assistant Deployment";
const pageDescription =
  "The 1Panel AI Assistant Appliance is designed for team-level local AI assistant deployment, combining 1Panel Enterprise, local model capabilities, and FusionXpark GB10 hardware to keep data in-domain while delivering both privacy and performance.";
const pageKeywords = [
  "1Panel AI Assistant Appliance",
  "1Panel AI Assistant Appliance (GB10)",
  "OpenClaw Appliance",
  "GB10 Appliance",
  "AI Assistant Appliance",
  "AI Appliance",
  "Local AI Assistant",
  "Local AI Deployment",
  "On-Premises AI Deployment",
  "Private AI Deployment",
  "Team-Level AI Deployment",
  "Data-In-Domain AI",
  "FusionXpark",
  "OpenClaw",
  "Hermes",
  "QwenPaw",
  "1Panel AI",
];
const openClawProductSchema = {
  "@context": "https://schema.org",
  "@type": "Product",
  "@id": `${openClawPageUrl}#product`,
  name: "1Panel AI Assistant Appliance (GB10 Edition)",
  alternateName: ["1Panel AI Assistant Appliance", "OpenClaw Appliance", "GB10 Appliance"],
  description: pageDescription,
  model: "GB10",
  sku: "1panel-ai-assistant-appliance-gb10",
  category: "AI appliance",
  image: toAbsoluteUrl("/images/fusionxpark.png", siteUrl),
  brand: {
    "@type": "Brand",
    name: "FIT2CLOUD",
  },
  manufacturer: {
    "@type": "Organization",
    name: "FIT2CLOUD Hangzhou",
  },
  audience: {
    "@type": "BusinessAudience",
    audienceType: "Team-level local AI assistant deployment, departmental private AI application rollout",
  },
  url: openClawPageUrl,
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": `${openClawPageUrl}#webpage`,
  },
  additionalProperty: [
    {
      "@type": "PropertyValue",
      name: "Hardware Base",
      value: "FusionXpark GB10, 128 GB unified memory, 2 TB storage, 1 PFLOPS compute",
    },
    {
      "@type": "PropertyValue",
      name: "Software Capabilities",
      value: "1Panel Enterprise, local model management, AI Gateway, OpenClaw, Hermes, QwenPaw",
    },
    {
      "@type": "PropertyValue",
      name: "Deployment Model",
      value: "On-premises deployment, data stays in-domain, ideal for team-level AI assistant scenarios",
    },
  ],
  isRelatedTo: [
    {
      "@type": "Product",
      name: "1Panel AI Coding Appliance",
      url: aiCodingPageUrl,
    },
  ],
  offers: {
    "@type": "Offer",
    price: "59000",
    priceCurrency: "CNY",
    availability: "https://schema.org/InStock",
    url: `${openClawPageUrl}#pricing`,
    seller: {
      "@type": "Organization",
      name: "FIT2CLOUD Hangzhou",
    },
  },
};
---

<Layout
  title={pageTitle}
  socialTitle={pageTitle}
  schemaName="1Panel AI Assistant Appliance (GB10 Edition)"
  description={pageDescription}
  canonical="/openclaw.html"
  image="/images/fusionxpark.png"
  imageAlt="1Panel AI Assistant Appliance Product Image"
  keywords={pageKeywords}
  structuredData={[
    createBreadcrumbSchema([
      { name: "1Panel", url: toAbsoluteUrl("/", siteUrl) },
      { name: "1Panel AI Assistant Appliance (GB10)", url: openClawPageUrl },
    ]),
    openClawProductSchema,
  ]}
>
  <Statistics slot="head" />
  <Fragment slot="main">
    <Header />
    <main class="relative z-10">
    <!-- Hero: left-right layout matching homepage; right side shows FusionXpark image -->
    <section id="heroSection" class="relative min-h-[80vh] flex items-center overflow-hidden bg-gray-50">
      <div class="relative z-10 container-custom pt-28 pb-20 lg:pt-32 lg:pb-24">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center">
          <!-- Left: copy -->
          <div class="text-center lg:text-left">
            <div class="fade-in-up inline-flex items-center px-4 py-2 mb-6 bg-blue-100 text-blue-800 rounded-full text-sm font-medium">
              Give everyone a claw 🦞, give the claw a home 🏡
            </div>
            <h1 class="fade-in-up text-4xl md:text-5xl lg:text-6xl font-bold leading-tight mb-8" style="animation-delay: 0.2s;">
              <span class="block text-gray-800 mb-4">AI Assistant Appliance</span>
              <span class="block text-1panel-gradient mb-2 leading-light">Built for Team Deployment</span>
            </h1>
            <p class="fade-in-up text-xl sm:text-2xl text-gray-500 mb-10 leading-relaxed" style="animation-delay: 0.4s;">
              Effortlessly supports 10–20 AI assistants (OpenClaw, Hermes, and QwenPaw) working in parallel — say goodbye to token anxiety.
            </p>
            <div class="fade-in-up flex flex-col sm:flex-row gap-4 justify-center lg:justify-start" style="animation-delay: 0.5s;">
              <a href="mailto:sales@lxware.hk?subject=1Panel AI Assistant Appliance Demo" class="btn-primary text-lg px-8 py-4 inline-flex items-center justify-center">
                Book a Demo
              </a>
              <a href="https://www.bilibili.com/video/BV1scwxzvEsv/" target="_blank" class="btn-secondary text-lg px-8 py-4 inline-flex items-center justify-center">
                Watch Video
              </a>
            </div>
          </div>
          <!-- Right: FusionXpark product image -->
          <div class="fade-in-up flex justify-center lg:justify-end" style="animation-delay: 0.3s;">
            <div class="w-full max-w-md lg:max-w-lg">
              <img
                src="/images/fusionxpark.png"
                alt="FusionXpark Product Image"
                class="mx-auto max-h-[460px] w-auto max-w-full object-contain"
                loading="eager"
              />
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- One-Stop, Deeply Optimized: Manage·Model·Smart + Hardware Base -->
    <section class="section-padding bg-gradient-to-b from-gray-50 to-white">
      <div class="container-custom">
        <div class="soft-hard-section rounded-3xl bg-white border border-gray-100 shadow-sm shadow-gray-200/60 overflow-hidden">
          <!-- Title area -->
          <div class="px-6 sm:px-10 pt-10 pb-8 text-center border-b border-gray-100">
            <h2 class="section-title text-4xl lg:text-5xl font-bold text-gray-800 mb-6">One-Stop, <span class="text-1panel-gradient">Deeply Optimized</span></h2>
            <p class="section-subtitle text-xl text-gray-600 max-w-2xl mx-auto leading-relaxed">Cost-controlled, data stays in-domain, privacy and performance in one — the ultimate safe for AI assistant deployment</p>
          </div>

          <!-- Top row: three cards -->
          <div class="p-6 sm:p-8">
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-5">
              <div class="soft-hard-card rounded-xl bg-gray-50/80 border border-gray-100 p-5 transition-all duration-200 hover:border-indigo-100 hover:shadow-md">
                <div class="w-11 h-11 rounded-lg bg-indigo-50 flex items-center justify-center text-indigo-600 font-bold text-base mb-3">Mgmt</div>
                <h3 class="text-base font-bold text-gray-900 mb-1.5">1Panel Enterprise</h3>
                <p class="text-sm text-gray-600 leading-relaxed">1Panel provides an intuitive Web management interface, making it easy to deploy and manage AI agents and models.</p>
              </div>
              <div class="soft-hard-card rounded-xl bg-gray-50/80 border border-gray-100 p-5 transition-all duration-200 hover:border-indigo-100 hover:shadow-md">
                <div class="w-11 h-11 rounded-lg bg-indigo-50 flex items-center justify-center text-indigo-600 font-bold text-base mb-3">Model</div>
                <h3 class="text-base font-bold text-gray-900 mb-1.5">Local AI Models</h3>
                <p class="text-sm text-gray-600 leading-relaxed">Runs Qwen3.6-35B-A3B-FP8 multimodal model on vLLM — high intelligence density with efficient concurrency.</p>
              </div>
              <div class="soft-hard-card rounded-xl bg-gray-50/80 border border-gray-100 p-5 transition-all duration-200 hover:border-indigo-100 hover:shadow-md">
                <div class="w-11 h-11 rounded-lg bg-indigo-50 flex items-center justify-center text-indigo-600 font-bold text-base mb-3">Smart</div>
                <h3 class="text-base font-bold text-gray-900 mb-1.5">AI Assistants That Deliver</h3>
                <p class="text-sm text-gray-600 leading-relaxed">Supports running multiple OpenClaw, Hermes, and QwenPaw instances simultaneously, integrates with mainstream Chinese messaging apps, and comes with built-in Skills.</p>
              </div>
            </div>

            <!-- Base: Hardware -->
            <div class="mt-6 rounded-xl bg-gradient-to-r from-gray-50 to-indigo-50/40 border border-gray-100 border-t-2 border-t-indigo-200 p-5 flex flex-col sm:flex-row sm:items-center gap-4">
              <div class="w-12 h-12 rounded-lg bg-indigo-100 flex items-center justify-center text-indigo-600 font-bold text-lg shrink-0">HW</div>
              <div class="min-w-0">
                <h3 class="text-base font-bold text-gray-900 mb-1">FusionXpark Hardware</h3>
                <p class="text-sm text-gray-600">Palm-sized AI supercomputer: 128 GB unified memory, NVIDIA Blackwell GB10, 1 PFLOPS compute, 2 TB storage, 1.2 kg — a desktop workstation you can place on your desk.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Why choose me? -->
    <section class="section-padding bg-white border-t border-gray-100">
      <div class="container-custom">
        <div class="text-center mb-12">
          <h2 class="section-title text-4xl lg:text-5xl font-bold text-gray-800 mb-6">Why Choose Me?</h2>
          <p class="section-subtitle text-xl text-gray-600 max-w-3xl mx-auto leading-relaxed">Beyond just "usable" — purpose-built for teams, a truly <span class="text-1panel-gradient font-bold ">"delightful"</span> AI assistant appliance</p>
        </div>
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 lg:gap-8">
          <!-- Powerful Performance -->
          <div class="rounded-2xl bg-gray-100/80 border border-gray-100 p-6 lg:p-8 transition-all duration-200 hover:border-indigo-100 hover:shadow-md flex flex-col">
            <div class="flex items-center gap-3 mb-4">
              <span class="flex-shrink-0 w-8 h-8 rounded-full bg-green-100 flex items-center justify-center text-green-600 font-bold text-sm">✓</span>
              <h3 class="text-lg font-bold text-gray-900">Powerful Performance, High Concurrency</h3>
            </div>
            <p class="text-gray-600 leading-relaxed flex-1">Benchmarked: GB10 at FP4 delivers concurrent inference performance ≈ 3× L20 / RTX 5880, effortlessly handling large model workloads — say goodbye to token anxiety.</p>
          </div>
          <!-- Easy to Use -->
          <div class="rounded-2xl bg-gray-100/80 border border-gray-100 p-6 lg:p-8 transition-all duration-200 hover:border-indigo-100 hover:shadow-md flex flex-col">
            <div class="flex items-center gap-3 mb-4">
              <span class="flex-shrink-0 w-8 h-8 rounded-full bg-green-100 flex items-center justify-center text-green-600 font-bold text-sm">✓</span>
              <h3 class="text-lg font-bold text-gray-900">Simple & Intuitive, Zero Barrier</h3>
            </div>
            <p class="text-gray-600 leading-relaxed flex-1">Graphical interface, three-step lightning deployment, seamlessly covering the full Day 0 → Day 1 → Day 2 lifecycle. No command line needed — even non-technical members can operate efficiently, freeing your team to focus.</p>
          </div>
          <!-- Secure & Reliable -->
          <div class="rounded-2xl bg-gray-100/80 border border-gray-100 p-6 lg:p-8 transition-all duration-200 hover:border-indigo-100 hover:shadow-md flex flex-col">
            <div class="flex items-center gap-3 mb-4">
              <span class="flex-shrink-0 w-8 h-8 rounded-full bg-green-100 flex items-center justify-center text-green-600 font-bold text-sm">✓</span>
              <h3 class="text-lg font-bold text-gray-900">Secure & Reliable, Data Private & Controlled</h3>
            </div>
            <div class="text-gray-600 leading-relaxed flex-1 space-y-1">
              <p>Isolated sandbox environment with physical separation from office PCs to prevent risk propagation. All data stored locally on the appliance, keeping information in-domain and protecting privacy. Built-in AI Gateway, firewall, and SSL encryption with dual password + token authentication for full system security.</p>
            </div>
          </div>
          <!-- Ongoing Support -->
          <div class="rounded-2xl bg-gray-100/80 border border-gray-100 p-6 lg:p-8 transition-all duration-200 hover:border-indigo-100 hover:shadow-md flex flex-col">
            <div class="flex items-center gap-3 mb-4">
              <span class="flex-shrink-0 w-8 h-8 rounded-full bg-green-100 flex items-center justify-center text-green-600 font-bold text-sm">✓</span>
              <h3 class="text-lg font-bold text-gray-900">Ongoing Support, Continuous Empowerment</h3>
            </div>
            <p class="text-gray-600 leading-relaxed flex-1">Deeply integrated into the 1Panel open-source ecosystem, with continuous sharing of curated industry case studies, practical tuning guides, and ready-to-use templates — plus a dedicated weekday 5×8 online community group, accompanying your AI application journey every step of the way as a reliable and supportive partner.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Limited-time offer horizontal layout (Hardware, Software, Services) -->
    <section class="section-padding bg-white" id="pricing">
      <div class="container-custom">
        <div class="text-center mb-16">
          <h2 class="section-title text-4xl lg:text-5xl font-bold text-gray-800 mb-6"><span class="text-1panel-gradient">Appliance Pricing</span></h2>
          <p class="section-subtitle text-xl text-gray-600 max-w-2xl mx-auto leading-relaxed">
            <span class="font-semibold text-gray-800">FIT2CLOUD</span> partners with <span class="font-semibold text-gray-800">FusionXpark</span> to bring you an exclusive limited-time offer
          </p>
        </div>

        <!-- Horizontal three-column: Hardware, Software, Services -->
        <div class="flex flex-col md:flex-row md:justify-between gap-6 mb-12">
          <!-- Hardware -->
          <div class="flex-1 flex flex-col items-center text-center rounded-2xl border-2 border-indigo-100 bg-white p-6 shadow hover:border-indigo-200 transition min-w-[220px]">
            <div class="w-14 h-14 mb-4 rounded-xl bg-indigo-50 flex items-center justify-center text-indigo-600 font-bold text-xl">Hardware</div>
            <h3 class="text-lg font-bold text-gray-900 mb-2">FusionXpark™ GB 10</h3>
            <p class="text-sm text-gray-500 mb-1">Palm-sized AI supercomputer, only 1.2 kg</p>
            <p class="text-sm text-gray-500">128 GB unified memory, 2 TB storage</p>
            <p class="text-sm text-gray-500">NVIDIA Grace Blackwell GB10, 1 PFLOPS compute</p>
            <p class="text-xs text-gray-400 mt-2">* Includes 1-year hardware warranty</p>
          </div>
          <!-- Software -->
          <div class="flex-1 flex flex-col items-center text-center rounded-2xl border-2 border-indigo-100 bg-white p-6 shadow hover:border-indigo-200 transition min-w-[220px]">
            <div class="w-14 h-14 mb-4 rounded-xl bg-indigo-50 flex items-center justify-center text-indigo-600 font-bold text-xl">Software</div>
            <p class="text-lg font-bold text-gray-900 mb-2">Software Suite</p>
            <p class="text-sm text-gray-500 mb-1"><a href="https://1panel.cn/enterprise.html" target="_blank" class="inline-flex items-center hover:underline"><span>1Panel Enterprise</span><Icon name="tabler:external-link" class="ml-1" /></a></p>
            <p class="text-xs text-gray-400 mt-2">* Includes 1-year software maintenance</p>
          </div>
          <!-- Services -->
          <div class="flex-1 flex flex-col items-center text-center rounded-2xl border-2 border-purple-100 bg-white p-6 shadow hover:border-purple-200 transition min-w-[220px]">
            <div class="w-14 h-14 mb-4 rounded-xl bg-purple-50 flex items-center justify-center text-purple-600 font-bold text-xl">
              Services
            </div>
            <h3 class="text-lg font-bold text-gray-900 mb-2">Dedicated Community Group</h3>
            <p class="text-sm text-gray-500 mb-1">Scenario discussions</p>
            <p class="text-sm text-gray-500 mb-1">Best practice sharing</p>
            <p class="text-sm text-gray-500 mb-1">Industry case sharing</p>
            <p class="text-xs text-gray-400 mt-2">* 5×8 online support</p>
          </div>
        </div>
        <!-- Price block -->
        <div class="rounded-2xl border border-gray-100 bg-indigo-50/40 p-8 shadow-lg flex flex-col md:flex-row gap-6 md:gap-0 md:items-center md:justify-center">

          <!-- Left: original & limited-time price -->
          <div class="flex flex-col items-center md:items-end md:pr-12 flex-1 md:max-w-[320px]">
            <div class="mb-3 w-full flex justify-start md:justify-end">
              <span class="inline-block bg-indigo-100 text-indigo-700 text-xs font-semibold px-2 py-0.5 rounded">Limited-Time Offer</span>
            </div>
            <div class="text-xl sm:text-2xl font-bold text-indigo-600 mb-3 w-full text-left md:text-right">¥59K/unit</div>
          </div>

          <!-- Vertical divider, desktop only -->
          <div class="hidden md:block h-36 w-px bg-gray-200 mx-12"></div>

          <!-- Right: QR code & text -->
          <div class="flex flex-col items-center flex-1 md:max-w-[320px]">
            <img
              src="/images/wecom-qrcode.png"
              alt="WeChat QR Code Inquiry"
              class="w-32 h-32 rounded-lg border border-gray-200 shadow-sm bg-white p-2 mb-2"
            />
            <div class="text-base font-semibold text-gray-800 mb-1 text-center">
              Inquire via WeChat
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Local AI Model Performance (benchmarked on same hardware) -->
    <section class="section-padding bg-gradient-to-b from-white to-gray-50 border-t border-gray-100">
      <div class="container-custom">
        <div class="text-center mb-16">
          <h2 class="section-title text-4xl lg:text-5xl font-bold text-gray-800 mb-6">
            <span class="text-1panel-gradient">Local AI Model</span>
            Performance
          </h2>
          <p class="section-subtitle text-xl text-gray-600 max-w-2xl mx-auto leading-relaxed">Benchmarked Qwen3.6-35B-A3B on identical hardware — open source and reproducible, comprehensively surpassing GPT-OSS-120B</p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-8">
          <!-- Inference Speed -->
          <div class="rounded-2xl bg-white border border-gray-100 shadow-sm overflow-hidden">
            <div class="px-6 py-4 border-b border-gray-100 bg-indigo-50/50">
              <h3 class="text-lg font-bold text-gray-900">Inference Speed (vLLM, BF16)</h3>
            </div>
            <div class="overflow-x-auto">
              <table class="w-full text-sm">
                <thead class="bg-gray-50">
                  <tr>
                    <th class="px-4 py-3 text-left font-semibold text-gray-700">Scenario</th>
                    <th class="px-4 py-3 text-left font-semibold text-gray-700">Output Length</th>
                    <th class="px-4 py-3 text-right font-semibold text-gray-700">Speed</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-gray-100">
                  <tr><td class="px-4 py-3 text-gray-700">Short reply</td><td class="px-4 py-3 text-gray-600">128 tokens</td><td class="px-4 py-3 text-right font-semibold text-indigo-600">~31 TPS</td></tr>
                  <tr><td class="px-4 py-3 text-gray-700">Medium reply</td><td class="px-4 py-3 text-gray-600">1,024 tokens</td><td class="px-4 py-3 text-right font-semibold text-indigo-600">~32 TPS</td></tr>
                  <tr><td class="px-4 py-3 text-gray-700">Long reply</td><td class="px-4 py-3 text-gray-600">3,831 tokens</td><td class="px-4 py-3 text-right font-semibold text-indigo-600">~32 TPS</td></tr>
                </tbody>
              </table>
            </div>
            <p class="px-6 py-3 text-xs text-gray-500 border-t border-gray-100">First token latency ~0.1s, speed stable across output lengths</p>
          </div>

          <!-- Multi-User Concurrency -->
          <div class="rounded-2xl bg-white border border-gray-100 shadow-sm overflow-hidden">
            <div class="px-6 py-4 border-b border-gray-100 bg-indigo-50/50">
              <h3 class="text-lg font-bold text-gray-900">Multi-User Concurrency (RAG scenario)</h3>
            </div>
            <div class="overflow-x-auto">
              <table class="w-full text-sm">
                <thead class="bg-gray-50">
                  <tr>
                    <th class="px-4 py-3 text-left font-semibold text-gray-700">Concurrent Users</th>
                    <th class="px-4 py-3 text-left font-semibold text-gray-700">Use Case</th>
                    <th class="px-4 py-3 text-right font-semibold text-gray-700">Total Throughput</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-gray-100">
                  <tr><td class="px-4 py-3 text-gray-700">5–10</td><td class="px-4 py-3 text-gray-600">Small team assistant</td><td class="px-4 py-3 text-right font-semibold text-indigo-600">65–82 TPS</td></tr>
                  <tr><td class="px-4 py-3 text-gray-700">20–50</td><td class="px-4 py-3 text-gray-600">Departmental deployment</td><td class="px-4 py-3 text-right font-semibold text-indigo-600">186–308 TPS</td></tr>
                  <tr><td class="px-4 py-3 text-gray-700">100</td><td class="px-4 py-3 text-gray-600">Enterprise peak</td><td class="px-4 py-3 text-right font-semibold text-indigo-600">~424 TPS</td></tr>
                </tbody>
              </table>
            </div>
            <p class="px-6 py-3 text-xs text-gray-500 border-t border-gray-100">200 token replies, thinking mode off, zero errors</p>
          </div>
        </div>

        <div class="rounded-2xl bg-white border border-gray-100 shadow-sm overflow-hidden mb-8">
          <div class="px-6 py-4 border-b border-gray-100 bg-indigo-50/50">
            <h3 class="text-lg font-bold text-gray-900">Capabilities & Benchmarks</h3>
          </div>
          <div class="px-6 py-5">
            <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3 text-sm text-gray-700">
              <li class="flex items-start gap-2"><span class="text-indigo-500 font-bold">·</span> 35B total params, 3B active (MoE), low inference cost</li>
              <li class="flex items-start gap-2"><span class="text-indigo-500 font-bold">·</span> Native 262K context, expandable to 1M+</li>
              <li class="flex items-start gap-2"><span class="text-indigo-500 font-bold">·</span> Multimodal: text, image, video input</li>
              <li class="flex items-start gap-2"><span class="text-indigo-500 font-bold">·</span> Thinking mode, tool calling / MCP</li>
              <li class="flex items-start gap-2"><span class="text-indigo-500 font-bold">·</span> MMLU-Pro 85.3, GPQA Diamond 84.2</li>
              <li class="flex items-start gap-2"><span class="text-indigo-500 font-bold">·</span> All classic reasoning passed, Apache 2.0 open source</li>
            </ul>
          </div>
        </div>

        <p class="text-center text-sm text-gray-500 mt-8">
          Source: <a href="https://github.com/adadrag/qwen3.5-dgx-spark" target="_blank" rel="noopener noreferrer" class="text-1panel hover:underline font-medium">Qwen3.6-35B-A3B on NVIDIA DGX Spark</a>, <a href="https://blog.csdn.net/u010026928/article/details/158582591" target="_blank" rel="noopener noreferrer" class="text-1panel hover:underline font-medium">[Benchmark] NVIDIA DGX Spark Local Deployment of Qwen3.6-35B-A3B-FP8 Full Tutorial</a></p>
        <p class="text-center text-sm text-gray-500 mt-8">
