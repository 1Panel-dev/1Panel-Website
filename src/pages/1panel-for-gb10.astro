---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Statistics from "../components/Statistics.astro";
import { Icon } from "astro-icon/components";
import {
  SITE_URL,
  createBreadcrumbSchema,
  toAbsoluteUrl,
} from "../lib/seo";
import "../styles/global.css";

const siteUrl = Astro.site?.toString() ?? SITE_URL;
const pageUrl = toAbsoluteUrl("/1panel-for-gb10.html", siteUrl);
const trialUrl = "https://jsj.top/f/umuYtv";

const heroKeywords = [
  "DGX Spark",
  "FusionXpark",
  "Dell Pro Max",
  "ThinkStation PGX",
  "ASUS ASCENT GX10",
];

// 产品图均取自各厂商官方产品资料，统一处理为 680×420 白底
const devices = [
  {
    name: "NVIDIA DGX Spark",
    note: "NVIDIA",
    image: "/images/gb10/devices/nvidia-dgx-spark.webp",
    alt: "NVIDIA DGX Spark 桌面 AI 超级计算机",
  },
  {
    name: "超聚变 FusionXpark",
    note: "xFusion",
    image: "/images/gb10/devices/xfusion-fusionxpark.webp",
    alt: "超聚变 FusionXpark GB10 桌面 AI 超级计算机",
  },
  {
    name: "Dell Pro Max",
    note: "Dell",
    image: "/images/gb10/devices/dell-pro-max.webp",
    alt: "Dell Pro Max with GB10 迷你工作站",
  },
  {
    name: "ASUS ASCENT GX10",
    note: "ASUS",
    image: "/images/gb10/devices/asus-ascent-gx10.webp",
    alt: "ASUS Ascent GX10 超小型 AI 超级计算机",
  },
  {
    name: "联想 ThinkStation PGX",
    note: "Lenovo",
    image: "/images/gb10/devices/lenovo-thinkstation-pgx.webp",
    alt: "联想 ThinkStation PGX 便携式 AI 工作站",
  },
];

const valueCards = [
  {
    icon: "carbon:activity",
    step: "01",
    title: "高效管理设备",
    description: "可视化方式管理设备，快速查看 GPU 实时状态和监控数据。",
  },
  {
    icon: "carbon:machine-learning-model",
    step: "02",
    title: "快速部署模型",
    description:
      "内置多款精选开源模型，从模型下载、模型运行、到运行监控，全面掌控。",
  },
  {
    icon: "carbon:gateway",
    step: "03",
    title: "快速提供服务",
    description: "可以通过 1Panel AI 网关将模型服务开放给其他人使用。",
  },
  {
    icon: "carbon:bot",
    step: "04",
    title: "快速部署智能体",
    description: "DeepSeek Harness、Octop、OpenClaw 等一键部署。",
  },
];

// 双 GB10 互联方案的实测数据，取自《双 GB10 算力节点部署 DeepSeek-V4-Flash 实测》
// 采用 WorkBuddy 办公场景（两周真实生产环境验证）的口径，与 4 GB10 集群面板结构一致
const dualGb10Stats = [
  { value: "2", unit: "路并发", label: "办公场景并发数" },
  { value: "60+", unit: "tok/s", label: "整机输出吞吐 TPS" },
  { value: "<80", unit: "W", label: "整机功耗" },
  { value: "<70", unit: "°C", label: "GPU 温度" },
];

// 4 GB10 集群方案的实测数据，取自《4 x GB10 集群部署 DeepSeek V4.1-Flash》
const clusterGb10Stats = [
  { value: "6", unit: "路并发", label: "真实业务并发数" },
  { value: "88K", unit: "输入 Tokens", label: "单请求上下文长度" },
  { value: "2.3", unit: "s", label: "首字延时 TTFT" },
  { value: "150", unit: "tok/s", label: "输出吞吐 TPS" },
];

const clusterGb10Specs = [
  { label: "算力节点", value: "4 × FusionXpark GB10（2TB 版），合计 512GB 共享显存" },
  { label: "高速组网", value: "1 × 400G 交换机 + 4 根 QSFP56 200G 线缆，星型 RDMA" },
  { label: "模型", value: "DeepSeek V4.1 Flash，官方 FP8 + FP4 混合精度，权重约 511GB" },
  { label: "管理平台", value: "1Panel 企业版（含 AI 网关）：模型部署、运行监控与 Token 服务发布" },
];

const pageTitle = "1Panel for GB10 解决方案 - GB10 桌面超算的最佳管家";
const pageDescription =
  "1Panel for GB10 解决方案：NVIDIA GB10 桌面超算的最佳管家，适用于 NVIDIA DGX Spark、超聚变 FusionXpark、Dell Pro Max、ASUS ASCENT GX10、联想 ThinkStation PGX，提供 GPU 实时状态与监控、智能体一键部署、模型一键部署和内置 AI 网关能力。";
const gb10Schema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "@id": `${pageUrl}#product`,
  name: "1Panel for GB10 解决方案",
  applicationCategory: "DeveloperApplication",
  applicationSubCategory: "AI server management panel for GB10 desktop supercomputers",
  operatingSystem: "Linux",
  description: pageDescription,
  url: pageUrl,
  featureList: [
    "可视化管理",
    "快速部署智能体",
    "快速部署模型",
    "内置 AI 网关",
  ],
  publisher: {
    "@type": "Organization",
    name: "杭州飞致云信息科技有限公司",
  },
};
---

<Layout
  title={pageTitle}
  socialTitle="1Panel for GB10 解决方案"
  schemaName="1Panel for GB10 解决方案"
  description={pageDescription}
  canonical="/1panel-for-gb10.html"
  image="/images/gb10/1p-gb10-01-gpu-status.webp"
  imageWidth={2000}
  imageHeight={1024}
  imageAlt="1Panel for GB10 解决方案 - GPU 实时状态"
  keywords={[
    "1Panel for GB10",
    "GB10 解决方案",
    "DGX Spark",
    "NVIDIA GB10",
    "GB10 桌面超算",
    "FusionXpark",
    "Dell Pro Max",
    "ASUS ASCENT GX10",
    "ThinkStation PGX",
    "GPU 监控",
    "智能体部署",
    "模型部署",
    "1Panel AI 网关",
    "GB10 集群",
    "DeepSeek V4.1 Flash",
  ]}
  structuredData={[
    createBreadcrumbSchema([
      { name: "1Panel 官网", url: toAbsoluteUrl("/", siteUrl) },
      { name: "1Panel for GB10 解决方案", url: pageUrl },
    ]),
    gb10Schema,
  ]}
>
  <Statistics slot="head" />
  <Fragment slot="main">
    <Header />
    <main class="relative z-10 bg-white text-gray-800">
      <!-- Hero -->
      <section class="relative overflow-hidden bg-gradient-to-b from-blue-50/80 via-white to-white pt-20 pb-16 lg:pt-28 lg:pb-24">
        <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-blue-200 to-transparent"></div>
        <div class="container-custom">
          <div class="mx-auto max-w-4xl text-center">
            <a
              href="/enterprise.html"
              class="fade-in-up mb-6 inline-flex items-center justify-center rounded-full border border-blue-100 bg-white px-4 py-2 text-sm font-semibold text-1panel shadow-sm transition-all duration-300 hover:border-blue-200 hover:bg-blue-50"
              style="animation-delay: 0.05s;"
            >
              <Icon name="carbon:arrow-left" class="mr-2 h-4 w-4" />
              返回企业版
            </a>
            <h1 class="fade-in-up text-4xl font-bold leading-tight tracking-normal text-gray-950 sm:text-5xl lg:text-6xl" style="animation-delay: 0.1s;">
              1Panel for GB10 <span class="whitespace-nowrap">解决方案</span>
            </h1>
            <p class="fade-in-up mx-auto mt-6 max-w-3xl text-lg leading-relaxed text-gray-600 sm:text-xl" style="animation-delay: 0.2s;">
              NVIDIA GB10 桌面超算的最佳管家，无论是管理单台设备，还是管理 4 台组成的集群，1Panel 都可以<span class="whitespace-nowrap">轻松管理</span>。
            </p>
            <div class="fade-in-up mt-8 flex flex-wrap justify-center gap-3" style="animation-delay: 0.3s;">
              {heroKeywords.map((keyword) => (
                <span class="rounded-md border border-blue-100 bg-white px-4 py-2 text-sm font-semibold text-1panel shadow-sm">
                  {keyword}
                </span>
              ))}
            </div>
            <div class="fade-in-up mt-7 flex flex-col items-center justify-center gap-4 sm:flex-row" style="animation-delay: 0.32s;">
              <a
                href={trialUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="btn-primary inline-flex w-full items-center justify-center px-9 py-4 text-base sm:w-auto"
              >
                申请企业版试用
                <Icon name="carbon:arrow-right" class="ml-2 h-5 w-5" />
              </a>
            </div>
          </div>
        </div>
      </section>

      <!-- 核心价值 -->
      <section class="py-16 lg:py-24">
        <div class="container-custom">
          <div class="mx-auto mb-12 max-w-3xl text-center">
            <h2 class="text-3xl font-bold leading-tight text-gray-900 [text-wrap:balance] lg:text-4xl">
              看状态、跑模型、发接口、装智能体
              <span class="mt-1 block text-1panel">一个 1Panel 全部搞定</span>
            </h2>
            <p class="mt-5 text-lg leading-relaxed text-gray-600">
              GB10 桌面超算装好之后最常做的四件事，1Panel 都提供了可视化入口，不必在命令行、Docker 与推理框架之间来回切换。
            </p>
          </div>

          <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4">
            {valueCards.map((feature, index) => (
              <article
                class="fade-in-up relative overflow-hidden rounded-xl border border-gray-100 bg-white p-6 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:border-blue-100 hover:shadow-xl"
                style={`animation-delay: ${index * 0.05}s;`}
              >
                <div class="mb-5 flex items-start justify-between">
                  <span class="inline-flex h-12 w-12 items-center justify-center rounded-lg bg-blue-50 text-1panel">
                    <Icon name={feature.icon} class="h-6 w-6" />
                  </span>
                  <span class="mt-1 text-sm font-bold leading-none tracking-widest text-blue-300">{feature.step}</span>
                </div>
                <h3 class="text-xl font-bold leading-snug text-gray-900">{feature.title}</h3>
                <p class="mt-3 text-sm leading-relaxed text-gray-600">
                  {feature.description}
                </p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <!-- 适配设备 -->
      <section class="border-t border-blue-100 bg-gradient-to-b from-blue-50/60 to-white py-16 lg:py-24">
        <div class="container-custom">
          <div class="mx-auto mb-12 max-w-3xl text-center">
            <h2 class="text-3xl font-bold leading-tight text-gray-900 lg:text-4xl">
              已适配的 GB10 设备
            </h2>
            <p class="mt-4 text-base leading-relaxed text-gray-600">
              同一套 1Panel 界面，适配不同厂商的 GB10 主机形态。
            </p>
          </div>

          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-5">
            {devices.map((device, index) => (
              <div
                class="fade-in-up flex flex-col rounded-xl border border-gray-200 bg-white p-4 shadow-sm transition-all duration-300 hover:border-blue-200 hover:shadow-md"
                style={`animation-delay: ${index * 0.05}s;`}
              >
                <div class="overflow-hidden rounded-lg bg-white">
                  <img
                    src={device.image}
                    alt={device.alt}
                    width="680"
                    height="420"
                    class="h-auto w-full object-contain"
                    loading="lazy"
                    decoding="async"
                  />
                </div>
                <p class="mt-4 text-sm font-bold leading-snug text-gray-900">{device.name}</p>
                <p class="mt-1 text-xs font-medium uppercase tracking-wide text-gray-400">{device.note}</p>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- 4 GB10 集群方案 -->
      <section id="cluster-gb10" class="border-t border-blue-100 bg-gradient-to-b from-blue-50/50 to-white py-16 lg:py-24">
        <div class="container-custom">
          <div class="mx-auto max-w-3xl text-center">
            <span class="inline-flex items-center rounded-full bg-blue-600 px-3 py-1 text-xs font-bold tracking-wide text-white shadow-sm">
              4 GB10 集群
            </span>
            <h2 class="mt-5 text-3xl font-bold leading-tight text-gray-900 [text-wrap:balance] lg:text-4xl">
              4 台 GB10 组成集群，
              <span class="block text-1panel">流畅运行 DeepSeek V4.1 Flash</span>
            </h2>
            <p class="mt-5 text-lg leading-relaxed text-gray-600">
              4 个 GB10 节点通过一台 400G 交换机组成星型 RDMA 网络，合计
              <span class="whitespace-nowrap">512GB 共享显存</span>，承载权重约
              <span class="whitespace-nowrap">511GB</span> 的
              <span class="whitespace-nowrap">DeepSeek-V4.1-Flash</span>，并由 1Panel 企业版完成部署、监控与网关发布。
            </p>
          </div>

          <!-- 实测数据 -->
          <div class="mt-10 rounded-xl border border-blue-100 bg-white p-6 shadow-sm sm:p-8">
            <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-2">
              <p class="text-sm font-bold text-gray-900">真实业务负载实测</p>
              <p class="text-xs leading-relaxed text-gray-500">
                6 路并发 · 每请求输入 88K Tokens / 输出 0.25K Tokens
              </p>
            </div>
            <dl class="mt-5 grid grid-cols-2 gap-3 sm:gap-4 lg:grid-cols-4">
              {clusterGb10Stats.map((item) => (
                <div class="rounded-lg bg-blue-50/70 px-4 py-3.5">
                  <dt class="flex items-baseline gap-x-1">
                    <span class="text-2xl font-extrabold leading-none text-1panel lg:text-3xl">{item.value}</span>
                    <span class="text-xs font-semibold text-gray-500">{item.unit}</span>
                  </dt>
                  <dd class="mt-2 text-xs leading-relaxed text-gray-600">{item.label}</dd>
                </div>
              ))}
            </dl>
          </div>

          <!-- 拓扑 + 方案组成 -->
          <div class="mt-10 grid grid-cols-1 items-center gap-8 lg:mt-12 lg:grid-cols-[1.12fr_0.88fr] lg:gap-10">
            <div>
              <figure class="overflow-hidden rounded-xl border border-blue-100 bg-[#f6fafe] shadow-sm">
                <img
                  src="/images/gb10/1p-gb10-cluster-topology.webp"
                  alt="4 台 GB10 通过一台 400G 交换机组成星型 RDMA 网络"
                  width="1511"
                  height="747"
                  class="h-auto w-full"
                  loading="lazy"
                  decoding="async"
                />
              </figure>
              <p class="mt-3 text-center text-xs leading-relaxed text-gray-500">
                交换式星型组网：跨节点通信由交换机线速转发，比环形直连的延迟更均衡
              </p>
            </div>

            <div>
              <h3 class="text-xl font-bold text-gray-900">方案组成</h3>
              <dl class="mt-4 divide-y divide-blue-100 overflow-hidden rounded-xl border border-blue-100 bg-white shadow-sm">
                {clusterGb10Specs.map((spec) => (
                  <div class="px-4 py-3.5 sm:px-5">
                    <dt class="text-xs font-semibold tracking-wide text-gray-500">{spec.label}</dt>
                    <dd class="mt-1 text-sm leading-relaxed text-gray-700">{spec.value}</dd>
                  </div>
                ))}
              </dl>
            </div>
          </div>

          <!-- 部署实况：vLLM 实例创建界面 -->
          <figure class="mt-10 overflow-hidden rounded-2xl border border-slate-700/60 bg-[#1f222b] shadow-xl shadow-slate-900/10 lg:mt-12">
            <figcaption class="flex flex-wrap items-center justify-between gap-x-4 gap-y-2 border-b border-white/[0.07] px-5 py-3.5 sm:px-6">
              <span class="flex items-center gap-x-2.5">
                <span class="inline-flex items-center rounded-full bg-blue-600 px-2.5 py-[3px] text-[11px] font-bold leading-none text-white shadow-sm">部署实况</span>
                <span class="text-sm font-bold text-white">在 1Panel 中创建 vLLM 实例</span>
              </span>
              <span class="text-xs leading-none text-slate-400">1Panel 企业版 · vLLM 管理</span>
            </figcaption>
            <img
              src="/images/gb10/1p-gb10-cluster-vllm-deploy.webp"
              alt="1Panel 的 vLLM 管理界面：左侧列表显示已创建的 vLLM 实例，右侧编辑面板选择定制镜像、DeepSeek-V4.1-Flash-1017 模型并配置 8000 端口与 API Key"
              width="1920"
              height="911"
              class="block h-auto w-full"
              loading="lazy"
              decoding="async"
            />
            <p class="border-t border-white/[0.07] px-5 py-3 text-xs leading-relaxed text-slate-400 sm:px-6">
              截图取自 4 台 GB10 集群上的实际部署环境：镜像类型选「定制镜像」，即针对 4 台 GB10 优化的 vLLM 版本；模型选 DeepSeek-V4.1-Flash-1017，填好服务端口与 API Key 后即可生成配置并部署
            </p>
          </figure>
        </div>
      </section>

      <!-- 双 GB10 互联方案 -->
      <section id="dual-gb10" class="py-16 lg:py-24">
        <div class="container-custom">
          <div class="overflow-hidden rounded-lg border border-blue-100 bg-gradient-to-br from-blue-50 via-white to-white p-6 shadow-sm sm:p-8 lg:p-10">
            <div class="grid grid-cols-1 items-center gap-10 lg:grid-cols-[1.05fr_0.95fr] lg:gap-12">
              <div>
                <span class="inline-flex items-center rounded-full bg-blue-600 px-3 py-1 text-xs font-bold tracking-wide text-white shadow-sm">
                  双 GB10 互联
                </span>
                <h2 class="mt-5 text-3xl font-bold leading-tight text-gray-900 [text-wrap:balance] lg:text-4xl">
                  双 GB10 互联，
                  <span class="block text-1panel">跑得动 DeepSeek V4 Flash 模型</span>
                </h2>
                <p class="mt-5 text-base leading-relaxed text-gray-600">
                  两个 GB10 算力节点通过 200Gbps ConnectX 高速互联，组成 256GB 共享显存与 2 PFLOP FP4 稀疏算力，可承载<span class="whitespace-nowrap">DeepSeek-V4-Flash</span>、<span class="whitespace-nowrap">Qwen3.8-Flash-Next</span> 等<span class="whitespace-nowrap">更大尺寸的模型</span>。
                </p>

                <!-- 实测数据（WorkBuddy 办公场景，结构同 4 GB10 集群面板） -->
                <div class="mt-7 rounded-xl border border-blue-100 bg-white p-5 shadow-sm sm:p-6">
                  <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-2">
                    <p class="text-sm font-bold text-gray-900">WorkBuddy 办公场景实测</p>
                    <p class="text-xs leading-relaxed text-gray-500">
                      2 路并发 · 两周真实生产环境验证
                    </p>
                  </div>
                  <dl class="mt-5 grid grid-cols-2 gap-3">
                    {dualGb10Stats.map((item) => (
                      <div class="rounded-lg bg-blue-50/70 px-3.5 py-3.5">
                        <dt class="flex items-baseline gap-x-1">
                          <span class="text-xl font-extrabold leading-none text-1panel lg:text-2xl">{item.value}</span>
                          <span class="text-xs font-semibold text-gray-500">{item.unit}</span>
                        </dt>
                        <dd class="mt-2 text-xs leading-relaxed text-gray-600">{item.label}</dd>
                      </div>
                    ))}
                  </dl>
                </div>

                <div class="mt-8">
                  <a
                    href="/blog/dual-gb10-deepseek-v4-flash-benchmark.html"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="btn-primary inline-flex items-center justify-center px-7 py-3 text-base"
                  >
                    查看双 GB10 实测报告
                    <Icon name="carbon:arrow-right" class="ml-2 h-5 w-5" />
                  </a>
                </div>

                <p class="mt-5 text-xs leading-relaxed text-gray-500">
                  数据来自双 GB10 版接入 WorkBuddy 办公智能体的两周真实生产环境验证：负载覆盖销售运营、方案撰写、会议纪要、邮件处理等典型办公任务，长时间稳定运行、无崩溃，放在办公室即可运行，无需独立机房散热。
                </p>
              </div>

              <div class="mx-auto w-full max-w-[420px]">
                <div class="space-y-3">
                  <figure class="overflow-hidden rounded-xl border border-blue-100">
                    <img
                      src="/images/1p-gb10-dual-back.webp"
                      alt="1Panel AI 一体机（双 GB10 版）背面：上下两个 GB10 节点，各自独立的接口面板"
                      width="878"
                      height="693"
                      class="h-auto w-full mix-blend-multiply"
                      loading="lazy"
                      decoding="async"
                    />
                  </figure>
                  <figure class="overflow-hidden rounded-xl border border-blue-100 shadow-sm">
                    <img
                      src="/images/1p-gb10-dual-front.webp"
                      alt="1Panel AI 一体机（双 GB10 版）正面：1Panel 金色标识与高密度进风散热格栅"
                      width="878"
                      height="560"
                      class="h-auto w-full"
                      loading="lazy"
                      decoding="async"
                    />
                  </figure>
                </div>
                <p class="mt-3 text-center text-xs leading-relaxed text-gray-500">
                  背面：双节点接口面板 · 正面：高密度进风格栅
                </p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- CTA -->
      <section class="bg-white pb-16 lg:pb-24">
        <div class="container-custom">
