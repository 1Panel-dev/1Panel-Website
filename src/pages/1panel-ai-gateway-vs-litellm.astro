---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Statistics from "../components/Statistics.astro";
import { Icon } from "astro-icon/components";
import {
  SITE_URL,
  createBreadcrumbSchema,
  toAbsoluteUrl,
} from "../lib/seo";
import "../styles/global.css";

const siteUrl = Astro.site?.toString() ?? SITE_URL;
const pageUrl = toAbsoluteUrl(
  "/1panel-ai-gateway-vs-litellm.html",
  siteUrl
);
const trialUrl = "https://jsj.top/f/umuYtv";
const publishedDate = "2026-09-02";
const socialImage = "/images/1p-ai-gateway.png";
const organizationId = `${toAbsoluteUrl("/", siteUrl).replace(/\/$/, "")}/#organization`;

const pageTitle =
  "1Panel AI 网关 vs LiteLLM 对比分析报告 - 1Panel 官网";
const pageDescription =
  "从产品定位到 6 项核心能力深度对比 1Panel AI 网关与 LiteLLM，看清企业级 AI 治理网关与全球知名 LLM 路由网关的本质差异，帮助企业做出更合适的 AI 网关选型。";

const positioning = [
  {
    dim: "核心定位",
    ours:
      "为企业打造专属的 AI 统一接入与治理平台，提供从统一接入、智能路由到合规审计的全链路管控，强调「治理」",
    theirs:
      "面向工程团队的 OpenAI 兼容统一 SDK / Proxy 网关，强调「统一接口 + 可观测 + 自动路由」",
  },
  {
    dim: "出品方",
    ours:
      "飞致云（FIT2CLOUD）旗下 1Panel 开源团队，国内团队出品，原厂中文技术支持",
    theirs:
      "BerriAI 出品（YC W23 投资），总部 San Francisco，国际化社区主导",
  },
  {
    dim: "目标用户",
    ours: "中大型企业（CIO / CISO / IT 运维总监）",
    theirs: "工程团队、平台团队、需要 100+ 模型统一接入的开发者",
  },
  {
    dim: "典型场景",
    ours:
      "多部门 Agent 应用、AI 编程管控、全员 AI 办公、知识库 / 工作流",
    theirs:
      "多模型 API 统一代理、负载均衡 + Fallback、可观测（Langfuse/MLflow 等）、Agent + MCP 工具调用",
  },
  {
    dim: "设计理念",
    ours: "从「模型可用」到「业务好用」的跨越，聚焦企业治理闭环",
    theirs:
      "面向工程的统一接口与可观测，开发者只换 base_url 即可接入 100+ 提供商",
  },
  {
    dim: "开源属性",
    ours:
      "1Panel 开源团队出品，10 人及以内可以免费使用；企业版不限制使用，同时提供原厂技术支持",
    theirs:
      "MIT 开源核心（GitHub 18k+ Stars，240M+ Docker pulls）；企业级 SSO / SAML / RBAC / SLA 需商业授权",
  },
];

const capabilities: {
  id: string;
  title: string;
  rows: { dim: string; ours: string; theirs: string; oursWin?: boolean }[];
  summary?: string;
}[] = [
  {
    id: "smart-routing",
    title: "智能路由",
    rows: [
      {
        dim: "路由机制",
        ours:
          "语义感知智能路由：基于 Embedding 向量化 + 语义相似度计算，自动判断请求复杂度，分流至轻量 / 高性能模型",
        theirs:
          "Auto Router V2：基于规则打分 + 语义关键词匹配 + 自适应 Thompson 采样，将请求路由到最便宜的「够格」模型",
        oursWin: true,
      },
      {
        dim: "路由精度",
        ours:
          "双引擎（样本匹配 + 规则判断），支持阈值动态调整",
        theirs: "按规则打分 + 自适应采样，依赖预定义规则与历史样本",
        oursWin: true,
      },
      {
        dim: "成本效果",
        ours:
          "官方宣称 Token 成本降低 40%-70%（简单请求占比 60%-80% 自动走低成本模型）",
        theirs:
          "Auto Router V2 自动选 cheapest capable 模型，可显著降低 token 成本",
        oursWin: true,
      },
      {
        dim: "业务侵入性",
        ours:
          "零侵入，仅需设置 model=auto",
        theirs:
          "需在 config.yaml 中预置路由规则与 deploy，部署形态重，自动化但不透明",
        oursWin: true,
      },
    ],
  },
  {
    id: "compliance",
    title: "内容合规与安全治理",
    rows: [
      {
        dim: "安全层级",
        ours:
          "三层安全审计体系：① 动态敏感词归一化拦截（谐音 / 拆字 / 拼音识别）② 向量语义级审核（对抗性攻击识别）③ 全量调用内容审计",
        theirs:
          "内置 Guardrails（PII masking、prompt injection 检测、模型评分），依赖 Presidio / Bedrock / Pangea 等集成",
        oursWin: true,
      },
      {
        dim: "合规能力",
        ours:
          "支持推送至 ES，满足等保合规与企业内部审计要求",
        theirs:
          "无等保合规级推送能力；审计主要通过 Langfuse / OpenTelemetry / SIEM 等集成实现",
        oursWin: true,
      },
      {
        dim: "违规处置",
        ours:
          "支持违规调用实时阻断与全流程审计追溯",
        theirs:
          "Guardrails 命中可阻断 / 改写 / 告警，但需自建审计追溯流程",
        oursWin: true,
      },
      {
        dim: "敏感数据保护",
        ours: "审计闭环内嵌",
        theirs: "PII masking 通过 Presidio 集成实现，零散依赖外部组件",
        oursWin: true,
      },
    ],
    summary:
      "1Panel AI 网关具备内嵌合规闭环；LiteLLM 借助可观测与 Guardrails 集成覆盖，但需要团队自建等保合规链路。",
  },
  {
    id: "permission",
    title: "权限与席位管理",
    rows: [
      {
        dim: "管控体系",
        ours:
          "三级继承管控（用户组 → 用户 → API Key），按组织架构配置",
        theirs:
          "Team → User → Virtual Key 三级模型，支持团队共享 budget 与模型白名单",
      },
      {
        dim: "管控粒度",
        ours:
          "并发限额、Token 配额、模型白名单、状态总开关、API Key 全生命周期管理（创建 / 冻结 / 重置 / 过期）",
        theirs:
          "Virtual Key 绑定 max_budget / budget_duration / models / 过期时间 / RPM/TPM 限速",
      },
      {
        dim: "组织适配",
        ours:
          "面向企业组织架构设计（部门 / 项目维度），支持独立资源池",
        theirs:
          "Team / Org 维度，SSO、OIDC、JWT 已成熟；企业级 RBAC 走商业授权",
        oursWin: true,
      },
      {
        dim: "身份认证",
        ours: "内置 LDAP / SSO 集成",
        theirs: "JWT / OIDC / SSO（Okta / Azure AD），企业 SSO / SAML 需商用",
      },
    ],
  },
  {
    id: "load-control",
    title: "负载与并发控制",
    rows: [
      {
        dim: "并发控制",
        ours:
          "四级并发控制（网关 → 用户组 → API Key → 模型账号）+ 容量感知调度 + 优先级与会话亲和",
        theirs:
          "RPM / TPM 按 key / user / team 限速 + Fallback + Cooldown（冷却期）",
        oursWin: true,
      },
      {
        dim: "会话亲和",
        ours:
          "按 API Key 与客户端 IP 识别会话，多轮对话尽量转发同一模型账号，提高 vLLM Prefix Cache 命中率",
        theirs:
          "无显式 session affinity 能力，需通过自定义 callback / Router 自实现",
        oursWin: true,
      },
      {
        dim: "过载保护",
        ours:
          "保留容量有限的短暂等待队列，满载时可短暂等待",
        theirs:
          "Fallback + 重试 + Cooldown 队列，多 deployment 自动切换",
      },
    ],
    summary:
      "1Panel AI 网关在「面向本地推理引擎的会话亲和」上具备明显优势；LiteLLM 在多上游 Failover 的工程能力上更成熟。",
  },
  {
    id: "model-coverage",
    title: "模型支持范围",
    rows: [
      {
        dim: "提供商覆盖",
        ours:
          "OpenAI / Anthropic 格式，Chat Completions ↔ Responses 互转",
        theirs:
          "100+ 提供商，1,800+ 模型：OpenAI / Anthropic / Bedrock / Vertex AI / Hugging Face / vLLM / Ollama / NVIDIA NIM / Mistral 等",
      },
      {
        dim: "协议支持",
        ours: "OpenAI / Anthropic 格式，Chat Completions ↔ Responses 互转",
        theirs:
          "OpenAI 统一接口 + 大多数供应商原生 SDK（Anthropic / Gemini / Bedrock 等格式自动适配）",
      },
      {
        dim: "本地模型",
        ours:
          "深度集成 vLLM、llama.cpp 等本地推理引擎，支持会话亲和",
        theirs:
          "原生支持 vLLM、Ollama、Hugging Face、NVIDIA NIM 等本地推理后端",
      },
      {
        dim: "Agent / MCP",
        ours: "支持 MCP 工具调用，模型 Agent 链路",
        theirs:
          "Agent Gateway + MCP server 原生集成（A2A 协议），MCP 生态最完整",
      },
    ],
    summary:
      "LiteLLM 在提供商广度、Agent / MCP 生态、本地推理后端覆盖上领先；1Panel AI 网关聚焦「深度企业治理」而非「多 provider 聚合」。",
  },
  {
    id: "cost-control",
    title: "用量统计与成本管控",
    rows: [
      {
        dim: "统计维度",
        ours:
          "全链路统计（请求量 / Token 消耗 / 缓存利用率），按用户、模型、部门多维度拆解",
        theirs:
          "spend_logs 表记录每次调用（user / key / model / tokens / cost），MySQL / PG 后端",
        oursWin: true,
      },
      {
        dim: "可视化",
        ours:
          "概览仪表盘 + 多维度分布 + 用量排行榜 + 全链路调用日志穿透分析",
        theirs:
          "自带 Admin Dashboard，支持 spend / key / team / model 维度查询",
      },
      {
        dim: "成本分摊",
        ours:
          "支持按部门 / 项目精准分摊，实现 AI 预算可预测、可管控",
        theirs:
          "Team budget + 软/硬预算告警 + Webhook，可对接计费系统",
        oursWin: true,
      },
      {
        dim: "可观测集成",
        ours:
          "已集成日志与看板",
        theirs:
          "深度集成 Langfuse / MLflow / Helicone / OpenTelemetry / Arize Phoenix / Prometheus",
      },
    ],
  },
];

const summary = [
  {
    ours:
      "是面向企业的「AI 治理基础设施」，核心差异在于语义级智能路由、三层内容合规审计、四级并发控制 + 会话亲和、企业级组织架构管控，适合有安全合规和精细化治理需求的中大型企业。",
    theirs:
      "是面向工程团队的「全球领先 AI 路由网关」，核心优势在于 100+ 提供商广度、Auto Router V2 自动降本、可观测生态完善、Agent + MCP 原生集成，适合需要快速接入多模型、对国际生态依赖度高的工程团队与平台部门。",
  },
];

const aiGatewaySchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "@id": `${pageUrl}#article`,
  headline: "1Panel AI 网关 vs LiteLLM 对比分析报告",
  description: pageDescription,
  url: pageUrl,
  image: toAbsoluteUrl(socialImage, siteUrl),
  datePublished: publishedDate,
  dateModified: publishedDate,
  inLanguage: "zh-CN",
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": `${pageUrl}#webpage`,
  },
  author: {
    "@type": "Organization",
    "@id": organizationId,
    name: "杭州飞致云信息科技有限公司",
  },
  publisher: {
    "@id": organizationId,
  },
  about: [
    { "@type": "SoftwareApplication", name: "1Panel AI 网关" },
    { "@type": "SoftwareApplication", name: "LiteLLM" },
  ],
};
---

<Layout
  title={pageTitle}
  socialTitle="1Panel AI 网关 vs LiteLLM 对比分析报告"
  schemaName="1Panel AI 网关 vs LiteLLM 对比分析报告"
  description={pageDescription}
  canonical="/1panel-ai-gateway-vs-litellm.html"
  image={socialImage}
  imageWidth={2559}
  imageHeight={1252}
  imageAlt="1Panel AI 网关 vs LiteLLM 对比分析报告"
  ogType="article"
  publishedTime={publishedDate}
  modifiedTime={publishedDate}
  section="产品对比"
  keywords={[
    "1Panel AI 网关",
    "LiteLLM",
    "AI 网关对比",
    "LLM 网关",
    "AI 模型网关",
    "AI 网关选型",
    "Auto Router",
    "企业 AI 治理",
    "语义级智能路由",
    "内容合规审计",
    "1Panel",
  ]}
  structuredData={[
    createBreadcrumbSchema([
      { name: "1Panel 官网", url: toAbsoluteUrl("/", siteUrl) },
      { name: "1Panel AI 网关", url: toAbsoluteUrl("/ai-gateway.html", siteUrl) },
      {
        name: "vs LiteLLM",
        url: pageUrl,
      },
    ]),
    aiGatewaySchema,
  ]}
>
  <Statistics slot="head" />
  <Fragment slot="main">
    <Header />
    <main class="bg-white text-gray-800">
      <!-- Hero -->
      <section class="relative overflow-hidden bg-gradient-to-b from-blue-50 via-white to-white pt-20 pb-12 lg:pt-28 lg:pb-16">
        <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-blue-200 to-transparent"></div>
        <div class="container-custom">
          <nav class="mb-6 text-sm text-gray-500" aria-label="breadcrumb">
            <ol class="flex flex-wrap items-center justify-center gap-1.5">
              <li><a href="/" class="hover:text-1panel">1Panel 官网</a></li>
              <li><span class="px-1">/</span></li>
              <li><a href="/ai-gateway.html" class="hover:text-1panel">1Panel AI 网关</a></li>
              <li><span class="px-1">/</span></li>
              <li class="text-gray-700">vs LiteLLM</li>
            </ol>
          </nav>
          <div class="mx-auto max-w-4xl text-center">
            <h1 class="text-4xl font-bold leading-tight tracking-normal text-gray-950 sm:text-5xl lg:text-6xl">
              <span class="block">1Panel AI 网关</span>
              <span class="mt-2 block">
                <span class="text-gray-500">vs</span>
                <span class="ml-3 text-1panel">LiteLLM</span>
              </span>
            </h1>
            <p class="mx-auto mt-4 max-w-3xl text-lg leading-relaxed text-gray-600 sm:text-xl">
              企业级 AI 治理网关与全球领先 LLM 路由网关的能力差异对比
            </p>
            <div class="mt-7 flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-sm text-gray-500">
              <span>对比产品：<strong class="text-gray-800">1Panel AI 网关 / LiteLLM</strong></span>
              <span class="hidden sm:inline">·</span>
              <span>对比维度：<strong class="text-gray-800">产品定位 + 6 项核心能力</strong></span>
            </div>
            <a href={trialUrl} target="_blank" rel="noopener noreferrer" class="btn-primary mt-8 inline-flex items-center justify-center px-9 py-4 text-base">
              申请试用 1Panel AI 网关
              <Icon name="carbon:arrow-right" class="ml-2 h-5 w-5" />
            </a>
          </div>
        </div>
      </section>

      <!-- 一、产品定位差异 -->
      <section id="positioning" class="scroll-mt-20 py-16 lg:py-24">
        <div class="container-custom">
          <div class="mx-auto mb-12 max-w-3xl text-center">
            <h2 class="text-3xl font-bold leading-tight text-gray-900 lg:text-4xl">产品定位差异</h2>
            <p class="mt-4 text-base leading-relaxed text-gray-600">
              LiteLLM 是国际化工程团队的事实标准；1Panel AI 网关是中国企业级 AI 治理的事实标准。
            </p>
          </div>
          <div class="overflow-x-auto rounded-xl border border-gray-200 bg-white shadow-sm">
            <table class="min-w-[760px] w-full text-left text-sm">
              <caption class="sr-only">1Panel AI 网关与 LiteLLM 产品定位对比</caption>
              <thead class="bg-gray-50 text-xs uppercase tracking-wider text-gray-500">
                <tr>
                  <th scope="col" class="w-[18%] px-6 py-4 font-semibold">维度</th>
                  <th scope="col" class="w-[41%] px-6 py-4 font-semibold text-1panel">1Panel AI 网关</th>
                  <th scope="col" class="w-[41%] px-6 py-4 font-semibold text-gray-600">LiteLLM</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-gray-100">
                {positioning.map((row) => (
                  <tr class="align-top">
                    <th scope="row" class="px-6 py-5 text-left font-semibold text-gray-900">{row.dim}</th>
                    <td class="px-6 py-5 leading-relaxed text-gray-800 bg-blue-50/50">{row.ours}</td>
                    <td class="px-6 py-5 leading-relaxed text-gray-600">{row.theirs}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </section>

      <!-- 二、核心能力差异 -->
      <section id="capabilities" class="scroll-mt-20 bg-gradient-to-b from-gray-50/60 to-white py-16 lg:py-24">
        <div class="container-custom">
          <div class="mx-auto mb-12 max-w-3xl text-center">
            <h2 class="text-3xl font-bold leading-tight text-gray-900 lg:text-4xl">核心能力差异</h2>
            <p class="mt-4 text-base leading-relaxed text-gray-600">
              以下从 6 个维度逐项对比 1Panel AI 网关与 LiteLLM 的能力差异。
            </p>
          </div>

          <div class="space-y-12">
            {capabilities.map((cap, idx) => (
              <article id={cap.id} class="scroll-mt-24">
                <div class="mb-5 flex items-center gap-3">
                  <span class="inline-flex h-9 min-w-9 items-center justify-center rounded-md bg-blue-100 px-3 text-sm font-bold text-1panel">2.{idx + 1}</span>
                  <h3 class="text-xl font-bold text-gray-900 lg:text-2xl">{cap.title}</h3>
                </div>
                <div class="overflow-x-auto rounded-xl border border-gray-200 bg-white shadow-sm">
                  <table class="min-w-[760px] w-full text-left text-sm">
                    <caption class="sr-only">1Panel AI 网关与 LiteLLM 的{cap.title}对比</caption>
                    <thead class="bg-gray-50 text-xs uppercase tracking-wider text-gray-500">
                      <tr>
                        <th scope="col" class="w-[18%] px-6 py-4 font-semibold">维度</th>
                        <th scope="col" class="w-[41%] px-6 py-4 font-semibold text-1panel">1Panel AI 网关</th>
                        <th scope="col" class="w-[41%] px-6 py-4 font-semibold text-gray-600">LiteLLM</th>
                      </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100">
                      {cap.rows.map((row) => (
                        <tr class="align-top">
                          <th scope="row" class="px-6 py-5 text-left font-semibold text-gray-900">{row.dim}</th>
                          <td class={`px-6 py-5 leading-relaxed ${row.oursWin ? "bg-blue-50/50 text-gray-800 font-medium" : "text-gray-800"}`}>
                            {row.ours}
                          </td>
                          <td class="px-6 py-5 leading-relaxed text-gray-600">{row.theirs}</td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
                {cap.summary && (
                  <p class="mt-4 rounded-lg border-l-4 border-1panel bg-blue-50/70 px-5 py-3 text-sm leading-relaxed text-gray-800">
                    <strong class="text-1panel">总结：</strong>{cap.summary}
                  </p>
                )}
              </article>
            ))}
          </div>
        </div>
      </section>

      <!-- 三、一句话总结 -->
      <section id="summary" class="scroll-mt-20 py-16 lg:py-24">
        <div class="container-custom">
          <div class="mx-auto mb-12 max-w-3xl text-center">
            <h2 class="text-3xl font-bold leading-tight text-gray-900 lg:text-4xl">一句话总结</h2>
          </div>
          <div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
            <div class="rounded-xl border border-blue-200 bg-blue-50/60 p-7 shadow-sm">
              <span class="mb-3 inline-flex items-center rounded-full bg-blue-600 px-3 py-1 text-xs font-bold uppercase tracking-wider text-white">1Panel AI 网关</span>
              <p class="mt-2 text-base leading-relaxed text-gray-800">{summary[0].ours}</p>
            </div>
