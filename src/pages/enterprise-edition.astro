---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { Icon } from 'astro-icon/components';
import '../styles/global.css';

const siteUrl = (import.meta.env.SITE ?? 'https://1panel.pro').replace(/\/$/, '');
const canonicalUrl = new URL('/enterprise-edition', siteUrl).href;

const layerTabs = [
  {
    id: 'application-layer',
    name: 'Application Layer',
    subtitle: 'Full Lifecycle AI Application Management',
    icon: 'carbon:application',
    color: 'blue',
    description:
      'Rapidly deploy and manage AI coding tools, AI assistants, and agent development platforms via the 1Panel App Store.',
    items: ['OpenCode', 'OpenClaw', 'Hermes', 'MaxKB', 'n8n', '...'],
    groups: ['AI Coding', 'AI Assistant', 'Agent Platform'],
  },
  {
    id: 'governance-layer',
    name: 'Governance Layer',
    subtitle: 'Enterprise AI Governance',
    icon: 'carbon:security',
    color: 'indigo',
    description:
      'The platform unifies AI Gateway, permissions, usage, auditing, and security operations — covering self-service API Key workflows, skill browsing, and MCP marketplace access.',
    items: ['AI Gateway', 'Skills Hub', 'MCP Marketplace'],
    groups: ['Unified Governance', 'Security Audit'],
  },
  {
    id: 'model-layer',
    name: 'Model Layer',
    subtitle: 'Compute & Model Support',
    icon: 'carbon:machine-learning-model',
    color: 'cyan',
    description:
      'Unified local model management supporting mainstream open-source LLMs like DeepSeek and Qwen, compatible with NVIDIA and Intel compute environments.',
    items: ['Qwen', 'DeepSeek', '...', 'NVIDIA', 'Intel'],
    groups: [],
  },
  {
    id: 'infrastructure-layer',
    name: 'Infrastructure Layer',
    subtitle: 'VM & Infrastructure Management',
    icon: 'carbon:virtual-machine',
    color: 'blue',
    description:
      'Centralized management of VMs, images, templates, networks, and storage pools — covering resource overview, lifecycle operations, console access, monitoring, and snapshots.',
    items: ['Virtual Machines', 'Images & Templates', 'Networking', 'Storage Pools'],
    groups: [],
  },
];

const enterpriseOnlyCapabilities = [
  {
    icon: 'carbon:gateway',
    title: 'AI Gateway',
    href: '/ai-gateway',
    tag: 'Unified Entry',
    description:
      'Unified access for internal AI applications and model calls, centralizing model access, usage statistics, and call chain management.',
    points: ['Model Proxy', 'Intelligent Routing', 'Usage Statistics'],
  },
  {
    icon: 'carbon:headset',
    title: 'Skills Hub',
    href: '/skills-hub',
    tag: 'Continuous Growth',
    description:
      'Publish, discover, and manage reusable Skills within your organization — auditable and governable.',
    points: ['Unified Management', 'Version Control', 'Security Audit'],
  },
  {
    icon: 'carbon:user-multiple',
    title: 'User Management',
    href: '/user-management',
    tag: 'Team Collaboration',
    description:
      'Multi-role user and permission management for departments and enterprises, enabling orderly AI adoption across teams.',
    points: ['User Management', 'Permission Assignment', 'Multi-role Collaboration'],
  },
  {
    icon: 'carbon:report',
    title: 'Security Ops Report',
    href: '/security-ops-report',
    tag: 'Continuous Visibility',
    description:
      'Consolidate system, model, agent, website, security, and operations status into reports — helping admins identify areas needing attention.',
    points: ['Risk Overview', 'Security Inspection', 'Report Consolidation'],
  },
];

const layerClassMap: Record<string, { badge: string; border: string; icon: string; accent: string }> = {
  blue: {
    badge: 'bg-blue-50 text-1panel',
    border: 'border-blue-100',
    icon: 'bg-blue-50 text-1panel',
    accent: 'from-blue-50 to-white',
  },
  indigo: {
    badge: 'bg-indigo-50 text-indigo-600',
    border: 'border-indigo-100',
    icon: 'bg-indigo-50 text-indigo-600',
    accent: 'from-indigo-50 to-white',
  },
  cyan: {
    badge: 'bg-cyan-50 text-cyan-700',
    border: 'border-cyan-100',
    icon: 'bg-cyan-50 text-cyan-700',
    accent: 'from-cyan-50 to-white',
  },
};

const pageTitle = '1Panel Enterprise — Lightweight AI Management Platform';
const pageDescription =
  '1Panel Enterprise is a unified Metal-to-Agent management platform — from hardware and VMs to AI agents. Covers enterprise AI governance and infrastructure management.';
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonicalUrl={canonicalUrl}
  keywords={[
    '1Panel Enterprise',
    '1Panel AI Gateway',
    'Skills Hub',
    'API Key management',
    'Skill marketplace',
    'MCP marketplace',
    'lightweight AI management platform',
    'private AI deployment',
    'AI application deployment',
    'multi-user management',
    'VM management',
    'KVM Web management',
    'security ops report',
    'air-gapped deployment',
  ].join(',')}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'SoftwareApplication',
      '@id': `${canonicalUrl}#product`,
      name: '1Panel Enterprise',
      alternateName: '1Panel Enterprise Edition',
      applicationCategory: 'DeveloperApplication',
      operatingSystem: 'Linux',
      description: pageDescription,
      url: canonicalUrl,
      featureList: [
        'AI Gateway', 'Skills Hub', 'MCP Marketplace',
        'Multi-user Management', 'KVM Web VM Management', 'Security Ops Report',
        'Multi-node Management', 'Air-gapped Deployment', 'AI App One-Click Deploy',
        'Local Model Management',
      ],
    })} />
  </Fragment>
  <Fragment slot="main">
    <Header />
    <main class="relative z-10 bg-white text-gray-800">
      <!-- Hero -->
      <section class="relative overflow-hidden bg-gradient-to-b from-blue-50/80 via-white to-white pt-20 pb-12 lg:pt-28 lg:pb-16">
        <div class="container-custom">
          <div class="fade-in-up mx-auto mb-10 max-w-4xl text-center lg:mb-12" style="animation-delay: 0.1s;">
            <h1 class="text-4xl font-bold leading-tight tracking-normal text-gray-950 sm:text-5xl lg:text-6xl">
              1Panel Enterprise
            </h1>
            <p class="mx-auto mt-4 max-w-3xl px-2 text-base leading-relaxed text-gray-600 sm:text-lg">
              1Panel Enterprise is a lightweight AI management platform that helps organizations build a dedicated AI environment, balancing rapid AI deployment with enterprise-grade security governance.
            </p>
            <a href="mailto:sales@lxware.hk?subject=1Panel Enterprise Inquiry" target="_blank" rel="noopener noreferrer" class="btn-primary mt-7 inline-flex items-center justify-center px-9 py-4 text-base">
              Contact Sales
              <Icon name="carbon:arrow-right" class="ml-2 h-5 w-5" />
            </a>
          </div>

          <!-- Architecture Overview -->
          <div id="architecture" class="fade-in-up mt-10 overflow-hidden rounded-lg border border-blue-100 bg-white/90 p-4 shadow-lg shadow-blue-100/50 sm:p-5 lg:mt-12 lg:p-6" style="animation-delay: 0.18s;">
            <h2 class="mb-5 flex items-center gap-2 text-lg font-bold text-gray-950">
              <span class="h-5 w-1 rounded-full bg-1panel"></span>
              Enterprise Architecture
            </h2>
            <div class="grid grid-cols-1 items-center gap-6 lg:grid-cols-[minmax(0,1fr)_52px_260px]">
              <div class="space-y-3">
                <!-- Application Layer -->
                <a href="#application-layer" class="group grid grid-cols-1 overflow-hidden rounded-lg border border-gray-100 bg-white shadow-sm transition-all duration-300 hover:-translate-y-1 hover:border-blue-200 hover:shadow-lg sm:grid-cols-[148px_minmax(0,1fr)]">
                  <div class="flex items-center justify-center gap-2 whitespace-nowrap bg-blue-50/70 px-4 py-4 text-lg font-bold text-[#07365e] sm:justify-start">
                    <Icon name="carbon:application" class="h-5 w-5 text-1panel" />
                    Application
                  </div>
                  <div class="p-4">
                    <div class="flex flex-wrap items-center justify-center gap-3 xl:flex-nowrap">
                      {['OpenCode', 'OpenClaw', 'Hermes', 'MaxKB', 'n8n'].map((item) => (
                        <span class="min-w-[96px] rounded-md border border-gray-200 bg-white px-3 py-1.5 text-center text-sm font-semibold text-gray-950 shadow-sm">
                          {item}
                        </span>
                      ))}
                      <span class="min-w-[52px] rounded-md border border-gray-200 bg-white px-3 py-1.5 text-center text-sm font-semibold text-gray-950 shadow-sm">...</span>
                    </div>
                    <div class="mt-3 grid grid-cols-1 gap-2 text-center text-sm font-semibold text-1panel sm:grid-cols-3">
                      <span>AI Coding</span>
                      <span>AI Assistant</span>
                      <span>Agent Platform</span>
                    </div>
                  </div>
                </a>

                <!-- Governance Layer -->
                <a href="#governance-layer" class="group grid grid-cols-1 overflow-hidden rounded-lg border border-gray-100 bg-white shadow-sm transition-all duration-300 hover:-translate-y-1 hover:border-blue-200 hover:shadow-lg sm:grid-cols-[148px_minmax(0,1fr)]">
                  <div class="flex items-center justify-center gap-2 whitespace-nowrap bg-blue-50/70 px-4 py-4 text-lg font-bold text-[#07365e] sm:justify-start">
                    <Icon name="carbon:security" class="h-5 w-5 text-1panel" />
                    Governance
                  </div>
                  <div class="p-4">
                    <div class="grid grid-cols-1 gap-2 sm:grid-cols-3">
                      {['AI Gateway', 'Skills Hub', 'MCP Marketplace'].map((item) => (
                        <span class="rounded-md border border-gray-200 bg-white px-4 py-2 text-center text-sm font-semibold text-gray-950 shadow-sm">
                          {item}
                        </span>
                      ))}
                    </div>
                  </div>
                </a>

                <!-- Model Layer -->
                <a href="#model-layer" class="group grid grid-cols-1 overflow-hidden rounded-lg border border-gray-100 bg-white shadow-sm transition-all duration-300 hover:-translate-y-1 hover:border-blue-200 hover:shadow-lg sm:grid-cols-[148px_minmax(0,1fr)]">
                  <div class="flex items-center justify-center gap-2 whitespace-nowrap bg-blue-50/70 px-4 py-4 text-lg font-bold text-[#07365e] sm:justify-start">
                    <Icon name="carbon:machine-learning-model" class="h-5 w-5 text-1panel" />
                    Model
                  </div>
                  <div class="p-4">
                    <div class="flex flex-wrap items-center justify-center gap-x-4 gap-y-3 rounded-md bg-white sm:gap-x-8">
                      <span class="inline-flex items-center gap-2 text-2xl font-bold text-[#5268f2]">
                        <img src="/images/enterprise-qwen.svg" alt="Qwen" class="h-9 w-9 object-contain" loading="eager" />
                        Qwen
                      </span>
                      <img src="/images/enterprise-deepseek.png" alt="DeepSeek" class="h-9 w-auto max-w-[140px] object-contain sm:max-w-[180px]" loading="eager" />
                      <span class="text-xl font-bold text-gray-950">...</span>
                    </div>
                    <div class="mt-4 grid grid-cols-1 gap-3 rounded-md bg-blue-100/70 p-3 sm:grid-cols-2">
                      {['NVIDIA', 'Intel'].map((item) => (
                        <span class="rounded-md border border-white/80 bg-white px-4 py-1.5 text-center text-sm font-semibold text-gray-950 shadow-sm">
                          {item}
                        </span>
                      ))}
                    </div>
                  </div>
                </a>

                <!-- Infrastructure Layer -->
                <a href="#infrastructure-layer" class="group grid grid-cols-1 overflow-hidden rounded-lg border border-gray-100 bg-white shadow-sm transition-all duration-300 hover:-translate-y-1 hover:border-blue-200 hover:shadow-lg sm:grid-cols-[148px_minmax(0,1fr)]">
                  <div class="flex items-center justify-center gap-2 whitespace-nowrap bg-blue-50/70 px-4 py-4 text-lg font-bold text-[#07365e] sm:justify-start">
                    <Icon name="carbon:virtual-machine" class="h-5 w-5 text-1panel" />
                    Infrastructure
                  </div>
                  <div class="grid grid-cols-1 gap-2 p-4">
                    <span class="rounded-md border border-blue-100 bg-blue-50/80 px-4 py-2 text-center shadow-sm">
                      <span class="block text-base font-bold text-gray-950">VM Management</span>
                    </span>
                    <div class="grid grid-cols-2 gap-2 sm:grid-cols-4">
                      {['VMs', 'Images & Templates', 'Networking', 'Storage Pools'].map((item) => (
                        <span class="rounded-md border border-gray-200 bg-white px-3 py-2 text-center text-sm font-semibold text-gray-950 shadow-sm">
                          {item}
                        </span>
                      ))}
                    </div>
                  </div>
                </a>
              </div>

              <div class="hidden justify-center lg:flex">
                <div class="flex h-[360px] w-10 items-center justify-center font-serif text-[230px] font-thin leading-none text-blue-300" style="transform: scaleX(0.45);" aria-hidden="true">
                  {'}'}
                </div>
              </div>

              <div class="rounded-lg bg-white/70 p-4 text-center lg:text-left">
                <h2 class="text-2xl font-bold text-gray-950 lg:text-3xl">1Panel Enterprise</h2>
                <p class="mt-5 text-base font-semibold leading-relaxed text-gray-600">
                  A unified Metal-to-Agent management platform
                </p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Enterprise Capabilities -->
      <section class="py-16 lg:py-24">
        <div class="container-custom">
          <div class="mx-auto mb-12 max-w-3xl text-center">
            <h2 class="text-3xl font-bold text-gray-900 lg:text-5xl">Adopt AI. Govern AI.</h2>
          </div>
          <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
            {enterpriseOnlyCapabilities.map((capability) => {
              const cardClass = 'flex h-full flex-col rounded-lg border border-gray-100 bg-white p-6 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:border-blue-100 hover:shadow-xl';
              const content = (
                <>
                  <div class="mb-5 flex items-start justify-between gap-4">
                    <span class="inline-flex h-12 w-12 items-center justify-center rounded-lg bg-blue-50 text-1panel">
                      <Icon name={capability.icon} class="h-6 w-6" />
                    </span>
                    <span class="rounded-full bg-gray-50 px-3 py-1 text-xs font-semibold text-gray-500">{capability.tag}</span>
                  </div>
                  <h3 class="text-xl font-bold text-gray-900">{capability.title}</h3>
                  <p class="mt-3 text-sm leading-relaxed text-gray-600">{capability.description}</p>
                  <div class="mt-auto flex flex-wrap gap-2 pt-5">
                    {capability.points.map((point) => (
                      <span class="rounded-md bg-blue-50 px-3 py-1 text-xs font-semibold text-1panel">{point}</span>
                    ))}
                  </div>
                </>
              );

              return capability.href ? (
                <a href={capability.href} class={cardClass}>
                  {content}
                </a>
              ) : (
                <article class={cardClass}>
                  {content}
                </article>
              );
            })}
          </div>
        </div>
      </section>

      <!-- Four-Layer Architecture -->
      <section class="bg-gray-50 py-16 lg:py-24">
        <div class="container-custom">
          <div class="mx-auto mb-12 max-w-3xl text-center">
            <h2 class="text-3xl font-bold text-gray-900 lg:text-5xl">Four-Layer Architecture for Enterprise AI</h2>
          </div>
          <div class="space-y-8">
            {layerTabs.map((layer) => {
              const colors = layerClassMap[layer.color];
              return (
                <article id={layer.id} class="scroll-mt-28 rounded-lg border border-gray-100 bg-white p-6 shadow-sm lg:p-8">
                  <div class="grid grid-cols-1 gap-8 lg:grid-cols-[0.8fr_1.2fr] lg:items-center">
                    <div>
                      <div class={`inline-flex items-center gap-2 rounded-full px-4 py-2 text-sm font-semibold ${colors.badge}`}>
                        <Icon name={layer.icon} class="h-4 w-4" />
                        {layer.name}
                      </div>
                      <h3 class="mt-5 text-2xl font-bold text-gray-900 lg:text-3xl">{layer.subtitle}</h3>
                      <p class="mt-4 text-base leading-relaxed text-gray-600">{layer.description}</p>
                    </div>
                    <div class={`rounded-lg border ${colors.border} bg-gradient-to-br ${colors.accent} p-5`}>
                      {layer.id === 'model-layer' ? (
                        <>
                          <div class="flex flex-wrap items-center justify-center gap-x-4 gap-y-4 rounded-md bg-white/80 p-4 shadow-sm sm:gap-x-8">
                            <span class="inline-flex items-center gap-2 text-2xl font-bold text-[#5268f2]">
                              <img src="/images/enterprise-qwen.svg" alt="Qwen" class="h-9 w-9 object-contain" loading="lazy" />
                              Qwen
                            </span>
                            <img src="/images/enterprise-deepseek.png" alt="DeepSeek" class="h-9 w-auto max-w-[140px] object-contain sm:max-w-[180px]" loading="lazy" />
                            <span class="text-2xl font-bold text-gray-950">...</span>
                          </div>
                          <div class="mt-5 grid grid-cols-1 gap-3 rounded-md bg-blue-100 p-4 sm:grid-cols-2">
                            {['NVIDIA', 'Intel'].map((item) => (
                              <div class="rounded-md border border-white/80 bg-white p-4 text-center text-sm font-semibold text-gray-800 shadow-sm">
                                {item}
                              </div>
                            ))}
                          </div>
                        </>
                      ) : layer.id === 'governance-layer' ? (
                        <>
                          <div class="mx-auto w-full max-w-2xl">
                            <div class="grid grid-cols-1 gap-3 sm:grid-cols-3">
                              {['AI Gateway', 'Skills Hub', 'MCP Marketplace'].map((item) => (
                                <div class="rounded-md border border-white/80 bg-white p-4 text-center text-sm font-semibold text-gray-800 shadow-sm">
                                  {item}
                                </div>
                              ))}
                            </div>
                          </div>
                          <div class="mt-5 flex flex-wrap gap-2">
                            {layer.groups.map((group) => (
                              <span class="rounded-full bg-white/80 px-3 py-1 text-xs font-semibold text-gray-500">{group}</span>
                            ))}
                          </div>
                        </>
                      ) : layer.id === 'infrastructure-layer' ? (
                        <>
                          <div class="rounded-md border border-blue-100 bg-blue-50/80 p-4 text-center shadow-sm">
                            <div class="inline-flex items-center gap-2 text-lg font-bold text-gray-800">
                              <Icon name="carbon:virtual-machine" class="h-5 w-5 text-1panel" />
                              VM Management
                            </div>
                          </div>
                          <div class="mt-3 grid grid-cols-2 gap-3 sm:grid-cols-4">
                            {layer.items.map((item) => (
                              <div class="rounded-md border border-white/80 bg-white p-4 text-center text-sm font-semibold text-gray-800 shadow-sm">
                                {item}
                              </div>
                            ))}
                          </div>
                        </>
                      ) : (
                        <>
                          <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
                            {layer.items.map((item) => (
                              <div class="rounded-md border border-white/80 bg-white p-4 text-center text-sm font-semibold text-gray-800 shadow-sm">
                                {item}
                              </div>
                            ))}
                          </div>
                          {layer.groups.length > 0 && (
                            <div class="mt-5 flex flex-wrap gap-2">
                              {layer.groups.map((group) => (
                                <span class="rounded-full bg-white/80 px-3 py-1 text-xs font-semibold text-gray-500">{group}</span>
                              ))}
                            </div>
                          )}
                        </>
                      )}
                    </div>
                  </div>
                </article>
              );
            })}
          </div>
        </div>
      </section>

      <!-- Pricing -->
      <section id="price" class="py-16 lg:py-24">
        <div class="container-custom">
          <div class="grid grid-cols-1 items-center gap-8 rounded-lg border border-blue-100 bg-blue-50/50 p-6 shadow-sm lg:grid-cols-[0.9fr_1.1fr] lg:p-10">
            <div class="lg:pr-6">
              <h2 class="text-3xl font-bold leading-tight text-gray-900 lg:text-4xl">1Panel Enterprise Pricing</h2>
              <p class="mt-5 text-base leading-relaxed text-gray-600">
                One platform for unified Metal-to-Agent management — from hardware infrastructure to AI agents.
              </p>
            </div>
            <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
              <div class="rounded-lg bg-white p-5 shadow-sm">
                <div class="text-3xl font-bold text-1panel">Custom</div>
                <p class="mt-2 text-sm text-gray-500">Enterprise licensing tailored to your team size and needs.</p>
              </div>
              <div class="rounded-lg bg-white p-5 shadow-sm">
                <div class="text-3xl font-bold text-1panel">5×8</div>
                <p class="mt-2 text-sm text-gray-500">Enterprise-grade online support for deployment and daily operations.</p>
              </div>
              <div class="rounded-lg bg-white p-5 shadow-sm">
                <div class="text-3xl font-bold text-1panel">Flexible</div>
                <p class="mt-2 text-sm text-gray-500">Node count determined per license — scales with your infrastructure.</p>
              </div>
              <div class="rounded-lg bg-white p-5 shadow-sm">
                <div class="text-3xl font-bold text-1panel">Offline</div>
                <p class="mt-2 text-sm text-gray-500">Air-gapped deployment support for environments with strict network boundaries.</p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Contact -->
      <section id="contact" class="bg-white pb-16 lg:pb-24">
        <div class="container-custom">
          <div class="rounded-lg border border-blue-100 bg-gradient-to-r from-blue-50 to-white p-6 shadow-sm sm:p-8 lg:p-10">
            <div>
              <h2 class="text-2xl font-bold text-gray-900 lg:text-3xl">
                See if 1Panel Enterprise fits your AI deployment needs
              </h2>
              <p class="mt-4 max-w-2xl text-base leading-relaxed text-gray-600">
                Contact us for a personalized demo, pricing details, and product materials.
              </p>
            </div>
            <div class="mt-6 flex flex-wrap gap-3">
              <a
                href="mailto:sales@lxware.hk?subject=1Panel Enterprise Inquiry"
                class="btn-primary inline-flex items-center justify-center px-6 py-3 text-base"
              >
                Contact Sales
                <Icon name="carbon:arrow-right" class="ml-2 h-5 w-5" />
              </a>
            </div>
          </div>
        </div>
      </section>
    </main>
    <Footer />
  </Fragment>
</Layout>
