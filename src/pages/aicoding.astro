---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Statistics from "../components/Statistics.astro";
import AICodingAppliancePage from "../components/AICodingAppliancePage.astro";
import {
  SITE_URL,
  createBreadcrumbSchema,
  toAbsoluteUrl,
} from "../lib/seo";
import "../styles/global.css";

const siteUrl = Astro.site?.toString() ?? SITE_URL;
const pageUrl = toAbsoluteUrl("/aicoding.html", siteUrl);
const assistantAppliancePageUrl = toAbsoluteUrl("/openclaw.html", siteUrl);
const pageTitle = "1Panel AI Coding Appliance - Air-Gapped AI Coding Appliance";
const pageDescription =
  "1Panel AI Coding Appliance crafted by FIT2CLOUD for 10-20 person engineering teams, enabling AI coding in fully air-gapped environments.";
const pageKeywords = [
  "1Panel AI Coding Appliance",
  "AI Coding Appliance",
  "B70 Appliance",
  "Intel Arc Pro B70",
  "Air-Gapped AI Coding",
  "Private AI Coding",
  "Enterprise Code Security",
  "Local AI Deployment",
  "AI Appliance",
  "1Panel Enterprise",
  "vLLM Inference Engine",
];
const productSchema = {
  "@context": "https://schema.org",
  "@type": "Product",
  "@id": `${pageUrl}#product`,
  name: "1Panel AI Coding Appliance",
  alternateName: ["AI Coding Appliance", "1Panel AI Coding Appliance", "1Panel AI Coding Appliance (B70 Edition)"],
  description: pageDescription,
  model: "B70",
  sku: "1panel-ai-coding-appliance-b70",
  category: "AI coding appliance",
  image: toAbsoluteUrl("/images/aicoding-b70.png", siteUrl),
  brand: {
    "@type": "Brand",
    name: "FIT2CLOUD",
  },
  manufacturer: {
    "@type": "Organization",
    name: "FIT2CLOUD Hangzhou",
  },
  audience: {
    "@type": "BusinessAudience",
    audienceType: "Government, finance, energy, manufacturing engineering teams requiring fully air-gapped environments",
  },
  url: pageUrl,
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": `${pageUrl}#webpage`,
  },
  additionalProperty: [
    {
      "@type": "PropertyValue",
      name: "Hardware Base",
      value: "4 x Intel Arc Pro B70, 128 GB VRAM, 1,468 TOPS peak AI compute (Int8)",
    },
    {
      "@type": "PropertyValue",
      name: "Software Capabilities",
      value: "1Panel Enterprise, vLLM Inference Engine, AI Gateway, Skills Hub, DevOps Toolchain",
    },
    {
      "@type": "PropertyValue",
      name: "Typical Scenarios",
      value: "AI coding, code generation, development collaboration, and core business code protection in fully air-gapped environments",
    },
  ],
  isRelatedTo: [
    {
      "@type": "Product",
      name: "1Panel AI Assistant Appliance (GB10 Edition)",
      url: assistantAppliancePageUrl,
    },
  ],
  offers: {
    "@type": "Offer",
    price: "119000",
    priceCurrency: "CNY",
    availability: "https://schema.org/InStock",
    url: `${pageUrl}#contact`,
    seller: {
      "@type": "Organization",
      name: "FIT2CLOUD Hangzhou",
    },
  },
};
---

<Layout
  title={pageTitle}
  socialTitle={pageTitle}
  schemaName="1Panel AI Coding Appliance"
  description={pageDescription}
  canonical="/aicoding.html"
  image="/images/aicoding-b70.png"
  imageAlt="1Panel AI Coding Appliance Product Image"
  keywords={pageKeywords}
  structuredData={[
    createBreadcrumbSchema([
      { name: "1Panel", url: toAbsoluteUrl("/", siteUrl) },
      { name: "1Panel AI Coding Appliance", url: pageUrl },
    ]),
    productSchema,
  ]}
>
  <Statistics slot="head" />
  <Fragment slot="main">
    <Header />
    <AICodingAppliancePage
      partner="Intel"
      hardware="4 x Intel Arc Pro B70"
      hardwareDetail="128 GB VRAM, 1,468 TOPS peak AI compute (Int8)"
    />
    <Footer />
  </Fragment>
</Layout>
