---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Statistics from "../components/Statistics.astro";
import AIGeneralAppliancePage from "../components/AIGeneralAppliancePage.astro";
import {
  SITE_URL,
  createBreadcrumbSchema,
  toAbsoluteUrl,
} from "../lib/seo";
import "../styles/global.css";

const siteUrl = Astro.site?.toString() ?? SITE_URL;
const pageUrl = toAbsoluteUrl("/deepseek-appliance.html", siteUrl);
const pageTitle = "1Panel AI 通用一体机：DeepSeek 私有化部署首选";
const pageDescription =
  "「1Panel AI 通用一体机」以“超融合”理念整合底层算力、模型服务和 AI 应用，为企业提供开箱即用的 AI 基础设施，让 AI 高效转化为企业生产力。";
const pageKeywords = [
  "AI一体机",
  "1Panel AI一体机",
  "AI时代的超融合",
  "AI私有化部署",
  "DeepSeek一体机",
];
---

<Layout
  title={pageTitle}
  socialTitle={pageTitle}
  schemaName={pageTitle}
  description={pageDescription}
  canonical="/deepseek-appliance.html"
  keywords={pageKeywords}
  structuredData={[
    createBreadcrumbSchema([
      { name: "1Panel 官网", url: toAbsoluteUrl("/", siteUrl) },
      { name: pageTitle, url: pageUrl },
    ]),
  ]}
>
  <Statistics slot="head" />
  <Fragment slot="main">
    <Header />
    <AIGeneralAppliancePage />
    <Footer />
  </Fragment>
</Layout>
