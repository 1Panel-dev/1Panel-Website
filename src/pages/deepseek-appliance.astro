---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Statistics from "../components/Statistics.astro";
import AIGeneralAppliancePage from "../components/AIGeneralAppliancePage.astro";
import {
  SITE_URL,
  createBreadcrumbSchema,
  toAbsoluteUrl,
} from "../lib/seo";
import "../styles/global.css";

const siteUrl = Astro.site?.toString() ?? SITE_URL;
const pageUrl = toAbsoluteUrl("/deepseek-appliance.html", siteUrl);
const pageTitle = "1Panel AI 通用一体机";
const pageDescription =
  "以“超融合”理念整合底层算力、模型服务和 AI 应用，为企业提供开箱即用的 AI 基础设施，让 AI 高效转化为企业生产力。";
const pageKeywords = [
  "1Panel AI 通用一体机",
  "AI 时代的超融合新范式",
  "从算力底座到 AI 应用落地",
  "纯内网运行",
  "数据不出域",
  "DeepSeek V4 Flash",
  "低代码智能体开发",
  "内网 AI 编程",
  "AI 办公",
];
---

<Layout
  title={pageTitle}
  socialTitle={pageTitle}
  schemaName={pageTitle}
  description={pageDescription}
  canonical="/deepseek-appliance.html"
  keywords={pageKeywords}
  structuredData={[
    createBreadcrumbSchema([
      { name: "1Panel 官网", url: toAbsoluteUrl("/", siteUrl) },
      { name: pageTitle, url: pageUrl },
    ]),
  ]}
>
  <Statistics slot="head" />
  <Fragment slot="main">
    <Header />
    <AIGeneralAppliancePage />
    <Footer />
  </Fragment>
</Layout>
