---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Statistics from "../components/Statistics.astro";
import { Icon } from "astro-icon/components";
import {
  SITE_URL,
  createBreadcrumbSchema,
  toAbsoluteUrl,
} from "../lib/seo";
import "../styles/global.css";

const siteUrl = Astro.site?.toString() ?? SITE_URL;
const pageUrl = toAbsoluteUrl("/ai-portal.html", siteUrl);
const trialUrl = "https://jsj.top/f/umuYtv";
const repositoryUrl = "https://github.com/1Panel-dev/AI-Portal";

const portalKeywords = [
  "自助申请API Key",
  "查看用量",
  "安装 Skills",
  "模型广场",
  "MCP 市场",
  "管理后台",
];

const capabilityCards = [
  {
    icon: "carbon:api-key",
    title: "自助申请API Key",
    advantage:
      "面向企业内部用户提供 API Key 自助申请、查看、重置和删除能力，并支持查看用量。",
  },
  {
    icon: "carbon:machine-learning-model",
    title: "模型广场",
    advantage:
      "集中展示 1Panel AI 网关中的可用模型，帮助用户快速了解模型资源和调用入口。",
  },
  {
    icon: "carbon:store",
    title: "技能市场",
    advantage:
      "展示 1Panel 已上架的 Skills，支持按分类浏览、搜索和安装。",
  },
  {
    icon: "carbon:network-4",
    title: "MCP 市场",
    advantage:
      "面向 1Panel MCP 场景，展示和管理可用的 MCP 服务。",
  },
  {
    icon: "carbon:review",
    title: "技能提交与审核",
    advantage:
      "支持用户上传技能包，管理员审核、发布和维护上架内容。",
  },
  {
    icon: "carbon:settings-services",
    title: "管理后台",
    advantage:
      "提供技能管理、用户管理、OAuth 登录配置，并支持对接企业微信、钉钉、飞书等企业通讯工具和 1Panel 网关。",
  },
];

const operationSteps = [
  {
    icon: "carbon:user-access",
    title: "用户自助",
    description:
      "面向企业内部用户提供自助入口，让团队成员自助申请API Key、查看用量、安装 Skills 等。",
    points: ["自助申请API Key", "查看用量", "安装 Skills"],
  },
  {
    icon: "carbon:headset",
    title: "市场分发",
    description:
      "模型广场、技能市场和 MCP 市场统一展示可用能力，用户可以按分类、搜索或详情页快速找到需要的资源。",
    points: ["查看模型资源", "安装 Skills", "MCP 服务发现"],
  },
  {
    icon: "carbon:gateway",
    title: "后台运营",
    description:
      "管理员通过后台维护技能、用户、OAuth 登录、企业通讯工具对接与 1Panel 网关配置，保障门户长期稳定运营。",
    points: ["技能审核发布", "用户与登录", "通讯工具对接"],
  },
];

const pageTitle = "1Panel AI 门户 - 企业版自助式 AI 能力入口";
const pageDescription =
  "1Panel AI 门户面向企业内部用户提供自助入口，让团队成员自助申请API Key、查看用量、安装 Skills，并支持对接企业微信、钉钉、飞书等通讯工具，衔接用户管理和统一登录。";
const aiPortalSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "@id": `${pageUrl}#product`,
  name: "1Panel AI 门户",
  alternateName: "1Panel AI Portal",
  applicationCategory: "DeveloperApplication",
  applicationSubCategory: "AI portal",
  operatingSystem: "Linux",
  description: pageDescription,
  url: pageUrl,
  downloadUrl: repositoryUrl,
  sameAs: [repositoryUrl],
  audience: {
    "@type": "BusinessAudience",
    audienceType: "1Panel 企业版用户、企业内部 AI 使用团队、管理员",
  },
  featureList: [
    "自助申请API Key",
    "查看用量",
    "模型广场",
    "技能市场",
    "安装 Skills",
    "MCP 市场",
    "技能提交与审核",
    "管理后台",
    "OAuth 登录配置",
    "企业微信、钉钉、飞书对接",
    "员工统一登录",
    "组织协同",
    "1Panel 网关配置",
  ],
  publisher: {
    "@type": "Organization",
    name: "杭州飞致云信息科技有限公司",
  },
};
---

<Layout
  title={pageTitle}
  socialTitle="1Panel AI 门户"
  schemaName="1Panel AI 门户"
  description={pageDescription}
  canonical="/ai-portal.html"
  image="/images/enterprise-ai-portal.png"
  imageWidth={2440}
  imageHeight={1930}
  imageAlt="1Panel AI 门户模型广场界面"
  keywords={[
    "1Panel AI 门户",
    "AI 门户",
    "AI Portal",
    "API Key 管理",
    "自助申请API Key",
    "查看用量",
    "模型广场",
    "技能市场",
    "安装 Skills",
    "MCP 市场",
    "技能提交审核",
    "企业微信",
    "钉钉",
    "飞书",
    "企业通讯工具",
    "员工统一登录",
    "1Panel 企业版",
  ]}
  structuredData={[
    createBreadcrumbSchema([
      { name: "1Panel 官网", url: toAbsoluteUrl("/", siteUrl) },
      { name: "1Panel AI 门户", url: pageUrl },
    ]),
    aiPortalSchema,
  ]}
>
  <Statistics slot="head" />
  <Fragment slot="main">
    <Header />
    <main class="relative z-10 bg-white text-gray-800">
      <section class="relative overflow-hidden bg-gradient-to-b from-blue-50/80 via-white to-white pt-20 pb-16 lg:pt-28 lg:pb-24">
        <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-blue-200 to-transparent"></div>
        <div class="container-custom">
          <div class="mx-auto max-w-4xl text-center">
            <a href="/enterprise.html" class="fade-in-up mb-6 inline-flex items-center justify-center rounded-full border border-blue-100 bg-white px-4 py-2 text-sm font-semibold text-1panel shadow-sm transition-all duration-300 hover:border-blue-200 hover:bg-blue-50" style="animation-delay: 0.05s;">
              <Icon name="carbon:arrow-left" class="mr-2 h-4 w-4" />
              返回企业版
            </a>
            <h1 class="fade-in-up text-4xl font-bold leading-tight tracking-normal text-gray-950 sm:text-5xl lg:text-6xl" style="animation-delay: 0.1s;">
              1Panel AI 门户
            </h1>
            <p class="fade-in-up mt-6 text-lg leading-relaxed text-gray-600 sm:text-xl" style="animation-delay: 0.2s;">
              面向企业内部用户提供自助入口，让团队成员自助申请API Key、查看用量、安装 Skills，并统一访问模型广场和 MCP 市场。
            </p>
            <div class="fade-in-up mt-8 flex flex-wrap justify-center gap-3" style="animation-delay: 0.3s;">
              {portalKeywords.map((keyword) => (
                <span class="rounded-md border border-blue-100 bg-white px-4 py-2 text-sm font-semibold text-1panel shadow-sm">
                  {keyword}
                </span>
              ))}
            </div>
            <div class="fade-in-up mt-7 flex flex-col items-center justify-center gap-3 sm:flex-row" style="animation-delay: 0.32s;">
              <a href={trialUrl} target="_blank" rel="noopener noreferrer" class="btn-primary inline-flex items-center justify-center px-9 py-4 text-base">
                申请试用
                <Icon name="carbon:arrow-right" class="ml-2 h-5 w-5" />
              </a>
            </div>
          </div>

          <div class="fade-in-up mx-auto mt-8 max-w-5xl" style="animation-delay: 0.35s;">
            <div class="relative overflow-hidden rounded-lg shadow-2xl shadow-blue-100/70">
              <div class="relative overflow-hidden rounded-lg bg-gray-50">
                <img
                  src="/images/enterprise-ai-portal.png"
                  alt="1Panel AI 门户模型广场界面"
                  class="h-auto w-full object-cover"
                  loading="eager"
                />
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="py-16 lg:py-24">
        <div class="container-custom">
          <div class="mx-auto mb-12 max-w-3xl text-center">
            <h2 class="text-3xl font-bold leading-tight text-gray-900 lg:text-5xl">
              自助入口，统一运营
            </h2>
            <p class="mt-5 text-lg leading-relaxed text-gray-600">
              围绕 API Key、用量、模型、Skills、MCP 服务和企业通讯工具对接，让企业内部用户更方便地获取 AI 能力，管理员也能统一运营用户、登录和审核流程。
            </p>
          </div>

          <div class="grid grid-cols-1 gap-5 md:grid-cols-2 lg:grid-cols-3">
            {capabilityCards.map((capability, index) => (
              <article
                class="fade-in-up rounded-lg border border-gray-100 bg-white p-6 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:border-blue-100 hover:shadow-xl"
                style={`animation-delay: ${index * 0.05}s;`}
              >
                <span class="mb-5 inline-flex h-12 w-12 items-center justify-center rounded-lg bg-blue-50 text-1panel">
                  <Icon name={capability.icon} class="h-6 w-6" />
                </span>
                <h3 class="text-xl font-bold text-gray-900">{capability.title}</h3>
                <p class="mt-3 text-sm leading-relaxed text-gray-600">
                  {capability.advantage}
                </p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="bg-gray-50 py-16 lg:py-24">
        <div class="container-custom">
          <div class="mx-auto mb-12 max-w-3xl text-center">
            <h2 class="text-3xl font-bold leading-tight text-gray-900 lg:text-5xl">
              连接用户、市场和后台
            </h2>
            <p class="mt-5 text-lg leading-relaxed text-gray-600">
              AI 门户将普通用户的自助使用路径、员工统一登录和管理员的后台运营能力放在同一套企业版治理体系中。
            </p>
          </div>

          <div class="grid grid-cols-1 gap-5 lg:grid-cols-3">
            {operationSteps.map((step, index) => (
              <article
                class="fade-in-up flex h-full flex-col rounded-lg border border-gray-100 bg-white p-6 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:border-blue-100 hover:shadow-xl"
                style={`animation-delay: ${index * 0.08}s;`}
              >
                <div class="mb-5 flex items-center justify-between gap-4">
                  <span class="inline-flex h-12 w-12 items-center justify-center rounded-lg bg-blue-50 text-1panel">
                    <Icon name={step.icon} class="h-6 w-6" />
                  </span>
                  <span class="rounded-full bg-gray-50 px-3 py-1 text-xs font-semibold text-gray-500">
                    0{index + 1}
                  </span>
                </div>
                <h3 class="text-xl font-bold text-gray-900">{step.title}</h3>
                <p class="mt-3 flex-1 text-sm leading-relaxed text-gray-600">
                  {step.description}
                </p>
                <div class="mt-5 flex flex-wrap gap-2">
                  {step.points.map((point) => (
                    <span class="rounded-md bg-blue-50 px-3 py-1 text-xs font-semibold text-1panel">{point}</span>
                  ))}
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="bg-white py-16 lg:py-24">
        <div class="container-custom">
          <div class="overflow-hidden rounded-lg border border-blue-100 bg-gradient-to-r from-blue-50 to-white p-6 shadow-sm sm:p-8 lg:p-10">
            <div class="grid grid-cols-1 items-center gap-8 lg:grid-cols-[1fr_auto]">
              <div>
                <h2 class="text-2xl font-bold text-gray-900 lg:text-3xl">
                  面向 1Panel 企业版的 AI 自助服务入口
                </h2>
                <p class="mt-4 max-w-3xl text-base leading-relaxed text-gray-600">
                  1Panel AI 门户将 API Key 自助申请、用量查看、模型广场、技能市场、MCP 市场、技能提交审核和后台配置集中到统一入口，并支持对接企业微信、钉钉、飞书等企业通讯工具，支撑企业用户管理、员工统一登录和组织协同，帮助企业在开放 AI 能力的同时保持可运营、可管理。
                </p>
              </div>
              <a href="/enterprise.html" class="btn-primary inline-flex items-center justify-center px-8 py-4 text-base">
                了解企业版
                <Icon name="carbon:arrow-right" class="ml-2 h-5 w-5" />
              </a>
            </div>
          </div>
        </div>
      </section>
    </main>
    <Footer />
  </Fragment>
</Layout>
