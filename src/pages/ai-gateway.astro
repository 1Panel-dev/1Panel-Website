---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Statistics from "../components/Statistics.astro";
import { Icon } from "astro-icon/components";
import {
  SITE_URL,
  createBreadcrumbSchema,
  toAbsoluteUrl,
} from "../lib/seo";
import "../styles/global.css";

const siteUrl = Astro.site?.toString() ?? SITE_URL;
const pageUrl = toAbsoluteUrl("/ai-gateway.html", siteUrl);
const trialUrl = "https://jsj.top/f/umuYtv";

const gatewayKeywords = [
  "统一接入",
  "模型代理",
  "席位管理",
  "用量统计",
  "智能路由",
  "内容合规",
];

const capabilityCards = [
  {
    icon: "carbon:gateway",
    title: "统一接入",
    advantage:
      "为内部 AI 应用和模型调用提供统一接入入口，集中承接不同业务系统的 AI 请求。",
    benefit:
      "降低 AI 应用接入复杂度，避免各业务系统重复对接模型服务。",
  },
  {
    icon: "carbon:network-4",
    title: "模型代理",
    advantage:
      "通过 AI 网关统一代理模型访问，支持内部应用按需调用不同模型能力。",
    benefit:
      "减少业务侧重复对接，便于企业统一管理模型资源和访问链路。",
  },
  {
    icon: "carbon:flow",
    title: "智能路由",
    advantage:
      "根据模型、应用和调用场景统一处理 AI 请求转发、路由和调用链路。",
    benefit:
      "提升 AI 调用链路的可管理性，便于问题排查和服务治理。",
  },
  {
    icon: "carbon:user-role",
    title: "席位管理",
    advantage:
      "支持对用户、团队或应用的 AI 使用席位和权限进行集中管理。",
    benefit:
      "帮助企业控制 AI 使用范围，减少越权调用和资源滥用风险。",
  },
  {
    icon: "carbon:chart-line-data",
    title: "用量统计",
    advantage:
      "对 AI 调用次数、使用情况和资源消耗进行统一统计和查看。",
    benefit:
      "帮助企业清晰了解 AI 使用情况，为成本分析和资源规划提供依据。",
  },
  {
    icon: "carbon:content-delivery-network",
    title: "内容合规",
    advantage:
      "对 AI 调用内容进行统一治理和合规检查。",
    benefit:
      "降低敏感内容、违规内容和不合规使用带来的风险，提升企业 AI 使用安全性。",
  },
];

const pageTitle = "1Panel AI 网关 - 打造企业专属的 AI 统一接入与治理平台";
const pageDescription =
  "1Panel AI 网关为内部 AI 应用和模型调用提供统一接入入口，支持模型代理、席位管理、用量统计、智能路由和内容合规。现已向社区开放，10 人及以下团队可免费使用，支持 1Panel 应用商店一键安装与 Docker 部署。";
const aiGatewaySchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "@id": `${pageUrl}#product`,
  name: "1Panel AI 网关",
  applicationCategory: "DeveloperApplication",
  applicationSubCategory: "AI gateway",
  operatingSystem: "Linux",
  description: pageDescription,
  url: pageUrl,
  featureList: [
    "统一接入",
    "模型代理",
    "席位管理",
    "用量统计",
    "智能路由",
    "内容合规",
  ],
  publisher: {
    "@type": "Organization",
    name: "杭州飞致云信息科技有限公司",
  },
};
---

<Layout
  title={pageTitle}
  socialTitle="1Panel AI 网关"
  schemaName="1Panel AI 网关"
  description={pageDescription}
  canonical="/ai-gateway.html"
  image="/images/enterprise-ai-gateway.png"
  imageWidth={3432}
  imageHeight={2172}
  imageAlt="1Panel AI 网关"
  keywords={[
    "1Panel AI 网关",
    "AI 网关",
    "AI 网关免费使用",
    "AI 网关 Docker 部署",
    "统一接入",
    "模型代理",
    "席位管理",
    "用量统计",
    "智能路由",
    "内容合规",
  ]}
  structuredData={[
    createBreadcrumbSchema([
      { name: "1Panel 官网", url: toAbsoluteUrl("/", siteUrl) },
      { name: "1Panel AI 网关", url: pageUrl },
    ]),
    aiGatewaySchema,
  ]}
>
  <Statistics slot="head" />
  <Fragment slot="main">
    <Header />
    <main class="relative z-10 bg-white text-gray-800">
      <section class="relative overflow-hidden bg-gradient-to-b from-blue-50/80 via-white to-white pt-20 pb-16 lg:pt-28 lg:pb-24">
        <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-blue-200 to-transparent"></div>
        <div class="container-custom">
          <div class="mx-auto max-w-4xl text-center">
            <a href="/enterprise.html" class="fade-in-up mb-6 inline-flex items-center justify-center rounded-full border border-blue-100 bg-white px-4 py-2 text-sm font-semibold text-1panel shadow-sm transition-all duration-300 hover:border-blue-200 hover:bg-blue-50" style="animation-delay: 0.05s;">
              <Icon name="carbon:arrow-left" class="mr-2 h-4 w-4" />
              返回企业版
            </a>
            <h1 class="fade-in-up text-4xl font-bold leading-tight tracking-normal text-gray-950 sm:text-5xl lg:text-6xl" style="animation-delay: 0.1s;">
              1Panel AI 网关
            </h1>
            <p class="fade-in-up mt-6 text-lg leading-relaxed text-gray-600 sm:text-xl" style="animation-delay: 0.2s;">
              打造企业专属的 AI 统一接入与治理平台
            </p>
            <div class="fade-in-up mt-8 flex flex-wrap justify-center gap-3" style="animation-delay: 0.3s;">
              {gatewayKeywords.map((keyword) => (
                <span class="rounded-md border border-blue-100 bg-white px-4 py-2 text-sm font-semibold text-1panel shadow-sm">
                  {keyword}
                </span>
              ))}
            </div>
            <div class="fade-in-up mt-7 flex flex-col items-center justify-center gap-4 sm:flex-row" style="animation-delay: 0.32s;">
              <a href="#free-quick-start" class="btn-primary inline-flex w-full items-center justify-center px-9 py-4 text-base sm:w-auto">
                立即免费安装
                <Icon name="carbon:arrow-right" class="ml-2 h-5 w-5" />
              </a>
              <a href={trialUrl} target="_blank" rel="noopener noreferrer" class="inline-flex w-full items-center justify-center rounded-lg border border-gray-300 bg-white px-8 py-4 text-base font-semibold text-gray-700 transition-all duration-300 hover:border-gray-400 hover:bg-gray-50 sm:w-auto">
                申请企业版试用
              </a>
            </div>
          </div>

          <div class="fade-in-up mt-8" style="animation-delay: 0.35s;">
            <div class="relative overflow-hidden rounded-lg shadow-2xl shadow-blue-100/70">
              <div class="relative overflow-hidden rounded-lg bg-gray-50">
                <img
                  src="/images/1p-ai-gateway.png"
                  alt="1Panel AI 网关产品界面"
                  width="2559"
                  height="1252"
                  class="h-auto w-full object-contain"
                  loading="eager"
                />
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- 社区开放 · 免费使用 · 快速开始 -->
      <section id="free-quick-start" class="scroll-mt-28 border-t border-gray-100 bg-gradient-to-b from-amber-50/60 via-white to-white py-16 lg:py-20">
        <div class="container-custom">
          <div class="mx-auto max-w-3xl text-center">
            <span class="inline-flex items-center gap-1.5 rounded-full bg-gradient-to-r from-orange-500 to-amber-500 px-3 py-1 text-[11px] font-extrabold leading-none tracking-wider text-white shadow-sm">
              <Icon name="carbon:gift" class="h-3.5 w-3.5" />
              社区开放 · 免费使用
            </span>
            <h2 class="mt-5 text-3xl font-bold leading-tight text-gray-900 lg:text-4xl">
              1Panel AI 网关已向社区开放
              <span class="mt-1 block text-orange-600">10 人及以下团队免费使用！</span>
            </h2>
          </div>

          <div class="mx-auto mt-12 grid max-w-5xl grid-cols-1 gap-6 lg:grid-cols-2">
            <!-- 方式一：1Panel 应用商店 -->
            <div class="flex h-full flex-col rounded-xl border border-gray-200 bg-white p-6 shadow-sm transition-all duration-300 hover:border-orange-200 hover:shadow-md lg:p-7">
              <div class="flex items-start justify-between gap-3">
                <div class="flex items-center gap-3">
                  <span class="inline-flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-lg bg-orange-50 text-orange-600">
                    <Icon name="carbon:application" class="h-5 w-5" />
                  </span>
                  <div>
                    <p class="text-xs font-semibold tracking-wider text-gray-400">安装方式一</p>
                    <h3 class="text-lg font-bold leading-snug text-gray-900">通过 1Panel 应用商店一键安装</h3>
                  </div>
                </div>
              </div>

              <p class="mt-4 text-sm leading-relaxed text-gray-600">
                通过 1Panel 应用商店，可视化方式，完成安装部署。
              </p>

              <ol class="mt-5 space-y-3">
                <li class="flex gap-3">
                  <span class="mt-0.5 inline-flex h-5 w-5 flex-shrink-0 items-center justify-center rounded-full bg-gray-100 text-xs font-semibold text-gray-600">1</span>
                  <p class="text-sm leading-relaxed text-gray-600">登录 1Panel 面板，进入 <strong class="font-semibold text-gray-800">应用商店</strong></p>
                </li>
                <li class="flex gap-3">
                  <span class="mt-0.5 inline-flex h-5 w-5 flex-shrink-0 items-center justify-center rounded-full bg-gray-100 text-xs font-semibold text-gray-600">2</span>
                  <p class="text-sm leading-relaxed text-gray-600">搜索 <strong class="font-semibold text-gray-800">1Panel AI 网关</strong>，点击 <strong class="font-semibold text-gray-800">安装</strong></p>
                </li>
                <li class="flex gap-3">
                  <span class="mt-0.5 inline-flex h-5 w-5 flex-shrink-0 items-center justify-center rounded-full bg-gray-100 text-xs font-semibold text-gray-600">3</span>
                  <p class="text-sm leading-relaxed text-gray-600">按向导完成初始化，浏览器访问 <code class="rounded bg-gray-50 px-1.5 py-0.5 font-mono text-[13px] text-gray-800">http://服务器IP:8080</code></p>
                </li>
              </ol>

              <figure class="mt-5 overflow-hidden rounded-lg ring-1 ring-gray-200/70">
                <img
                  src="/images/ai-gateway/install-appstore.png"
                  alt="1Panel 应用商店中的应用列表，「1Panel AI 网关」位于左上角"
                  width="1280"
                  height="810"
                  class="block h-auto w-full"
                  loading="lazy"
                />
                <figcaption class="flex items-center gap-1.5 border-t border-gray-100 bg-white px-3 py-2 text-xs text-gray-500">
                  <Icon name="carbon:search" class="h-3.5 w-3.5 flex-shrink-0 text-orange-500" />
                  在 1Panel 应用商店中找到「1Panel AI 网关」
                </figcaption>
              </figure>

              <div class="mt-auto border-t border-gray-100 pt-4">
                <a href="https://docs.fit2cloud.com/ai-gateway/quick_start" target="_blank" rel="noopener noreferrer" class="group inline-flex items-center gap-1.5 text-sm font-semibold text-1panel">
                  查看详情
                  <Icon name="carbon:arrow-right" class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1" />
                </a>
              </div>
            </div>

            <!-- 方式二：docker run -->
            <div class="flex h-full flex-col rounded-xl border border-gray-200 bg-white p-6 shadow-sm transition-all duration-300 hover:border-orange-200 hover:shadow-md lg:p-7">
              <div class="flex items-start justify-between gap-3">
                <div class="flex items-center gap-3">
                  <span class="inline-flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-lg bg-orange-50 text-orange-600">
                    <Icon name="carbon:terminal" class="h-5 w-5" />
                  </span>
                  <div>
                    <p class="text-xs font-semibold tracking-wider text-gray-400">安装方式二</p>
                    <h3 class="text-lg font-bold leading-snug text-gray-900">使用 docker run 直接运行</h3>
                  </div>
                </div>
              </div>

              <p class="mt-4 text-sm leading-relaxed text-gray-600">
                官方镜像为 <code class="rounded bg-gray-50 px-1.5 py-0.5 font-mono text-[13px] text-gray-800">1panel/ai-gateway</code>，未指定版本时默认拉取最新版本。
              </p>

              <div class="relative mt-5 rounded-lg bg-gray-900 px-4 py-3.5">
                <div class="mb-2 flex items-center justify-between">
                  <span class="font-mono text-[11px] uppercase tracking-wider text-gray-500">Terminal</span>
                  <button
                    type="button"
                    data-copy-target="docker-run-cmd"
                    aria-label="复制部署命令"
                    class="inline-flex items-center gap-1 rounded-md bg-white/10 px-2 py-1 text-xs font-medium text-gray-200 transition-colors duration-200 hover:bg-white/20"
                  >
                    <Icon name="carbon:copy" class="h-3.5 w-3.5" />
                    <span data-copy-label>复制</span>
                  </button>
                </div>
                <pre class="overflow-x-auto"><code id="docker-run-cmd" class="whitespace-pre font-mono text-[13px] leading-relaxed text-gray-100">docker run --pull always -d \
  --name 1panel-ai-gateway \
  --restart unless-stopped \
  -p 8080:8080 \
  -v /opt/ai-gateway:/opt/ai-gateway \
  1panel/ai-gateway</code></pre>
              </div>

              <p class="mt-4 text-sm leading-relaxed text-gray-600">
                首次启动会在容器日志中输出管理员临时密码：
              </p>
              <div class="relative mt-2 rounded-lg bg-gray-900 px-4 py-3">
                <pre class="overflow-x-auto"><code id="docker-logs-cmd" class="whitespace-pre font-mono text-[13px] leading-relaxed text-gray-100">docker logs 1panel-ai-gateway</code></pre>
                <button
                  type="button"
                  data-copy-target="docker-logs-cmd"
                  aria-label="复制查看密码命令"
                  class="absolute right-2 top-2 inline-flex items-center gap-1 rounded-md bg-white/10 px-2 py-1 text-xs font-medium text-gray-200 transition-colors duration-200 hover:bg-white/20"
                >
                  <Icon name="carbon:copy" class="h-3.5 w-3.5" />
                </button>
              </div>

              <div class="mt-auto border-t border-gray-100 pt-4">
                <a href="https://docs.fit2cloud.com/ai-gateway/quick_start" target="_blank" rel="noopener noreferrer" class="group inline-flex items-center gap-1.5 text-sm font-semibold text-1panel">
                  查看详情
                  <Icon name="carbon:arrow-right" class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1" />
                </a>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="py-16 lg:py-24">
        <div class="container-custom">
          <div class="mx-auto mb-12 max-w-3xl text-center">
            <h2 class="text-3xl font-bold leading-tight text-gray-900 lg:text-5xl">
              统一接入，智能路由，合规保障
            </h2>
            <p class="mt-5 text-lg leading-relaxed text-gray-600">
              1Panel AI 网关提供从统一接入、智能路由到合规审计的全链条管控，让企业 AI 落地更安全、更高效、更可控。
            </p>
          </div>

          <div class="grid grid-cols-1 gap-5 md:grid-cols-2 lg:grid-cols-3">
            {capabilityCards.map((capability, index) => (
              <article
                class="fade-in-up rounded-lg border border-gray-100 bg-white p-6 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:border-blue-100 hover:shadow-xl"
                style={`animation-delay: ${index * 0.05}s;`}
              >
                <span class="mb-5 inline-flex h-12 w-12 items-center justify-center rounded-lg bg-blue-50 text-1panel">
                  <Icon name={capability.icon} class="h-6 w-6" />
                </span>
                <h3 class="text-xl font-bold text-gray-900">{capability.title}</h3>
                <p class="mt-3 text-sm leading-relaxed text-gray-600">
                  <span class="font-semibold text-gray-800">作用：</span>{capability.advantage}
                </p>
                <p class="mt-3 text-sm leading-relaxed text-gray-600">
                  <span class="font-semibold text-gray-800">价值：</span>{capability.benefit}
                </p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <!-- AI 网关选型指南 -->
      <section id="gateway-selection" class="scroll-mt-28 bg-gradient-to-b from-blue-50/60 to-white py-16 lg:py-24 border-t border-blue-100">
        <div class="container-custom">
          <div class="mx-auto mb-12 max-w-3xl text-center">
            <h2 class="text-3xl font-bold leading-tight text-gray-900 lg:text-4xl">
              <span class="text-1panel">AI 网关选型指南</span>
            </h2>
            <p class="mt-4 text-base leading-relaxed text-gray-600">
              <strong class="text-gray-800">为什么 1Panel AI 网关更适合企业内部署使用？</strong><br/>
              我们整理了与两款主流 AI 网关的深度对比，帮你看清企业级 AI 治理与开源聚合网关的本质差异。
            </p>
          </div>

          <div class="grid grid-cols-1 gap-6 md:grid-cols-2 max-w-5xl mx-auto">
            <a
              href="/1panel-ai-gateway-vs-newapi.html"
              class="group flex flex-col overflow-hidden rounded-2xl border border-gray-100 bg-white shadow-sm transition-all duration-300 hover:-translate-y-1 hover:border-blue-200 hover:shadow-xl"
            >
              <div class="relative aspect-[16/9] overflow-hidden bg-gradient-to-br from-blue-600 via-blue-500 to-indigo-600">
                <div class="absolute inset-0 flex flex-col items-center justify-center px-6 text-center">
                  <div class="mb-3 flex items-center gap-3 text-white/90">
                    <span class="inline-flex h-10 w-10 items-center justify-center rounded-lg bg-white/15 text-base font-bold backdrop-blur-sm">1P</span>
                    <span class="text-3xl font-light">vs</span>
                    <span class="inline-flex h-10 items-center justify-center rounded-lg bg-white/15 px-3 text-base font-bold backdrop-blur-sm">New API</span>
                  </div>
                  <h3 class="text-xl font-bold text-white lg:text-2xl">1Panel AI 网关 vs New API</h3>
                  <p class="mt-2 text-sm text-white/80">企业级治理 vs 开源聚合分发</p>
                </div>
                <div class="absolute -right-12 -top-12 h-40 w-40 rounded-full bg-white/10"></div>
                <div class="absolute -left-8 -bottom-12 h-32 w-32 rounded-full bg-white/10"></div>
              </div>
              <div class="flex flex-1 flex-col p-6">
                <div class="flex flex-wrap gap-1.5 mb-4">
                  <span class="rounded-full bg-blue-50 px-2.5 py-0.5 text-[11px] font-medium text-1panel">语义级智能路由</span>
                  <span class="rounded-full bg-blue-50 px-2.5 py-0.5 text-[11px] font-medium text-1panel">三层内容合规</span>
                  <span class="rounded-full bg-blue-50 px-2.5 py-0.5 text-[11px] font-medium text-1panel">四级并发控制</span>
                </div>
                <p class="flex-1 text-sm leading-relaxed text-gray-600">
                  企业级 <strong>AI 治理基础设施</strong>，核心差异在语义级智能路由、谐音/拆字/拼音的内容合规审计、四级并发控制 + 会话亲和、组织级权限管控。
                </p>
                <div class="mt-5 flex items-center justify-between border-t border-gray-100 pt-4">
                  <span class="text-xs text-gray-500">7 维度深度对比</span>
                  <span class="inline-flex items-center gap-1 text-sm font-semibold text-1panel group-hover:gap-2 transition-all">
                    阅读对比报告
                    <Icon name="carbon:arrow-right" class="h-4 w-4" />
                  </span>
                </div>
              </div>
            </a>

            <a
              href="/1panel-ai-gateway-vs-litellm.html"
              class="group flex flex-col overflow-hidden rounded-2xl border border-gray-100 bg-white shadow-sm transition-all duration-300 hover:-translate-y-1 hover:border-blue-200 hover:shadow-xl"
            >
              <div class="relative aspect-[16/9] overflow-hidden bg-gradient-to-br from-blue-600 via-blue-500 to-cyan-600">
                <div class="absolute inset-0 flex flex-col items-center justify-center px-6 text-center">
                  <div class="mb-3 flex items-center gap-3 text-white/90">
                    <span class="inline-flex h-10 w-10 items-center justify-center rounded-lg bg-white/15 text-base font-bold backdrop-blur-sm">1P</span>
                    <span class="text-3xl font-light">vs</span>
                    <span class="inline-flex h-10 items-center justify-center rounded-lg bg-white/15 px-3 text-base font-bold backdrop-blur-sm">LiteLLM</span>
                  </div>
                  <h3 class="text-xl font-bold text-white lg:text-2xl">1Panel AI 网关 vs LiteLLM</h3>
                  <p class="mt-2 text-sm text-white/80">中国本土企业治理 vs 全球工程标准</p>
                </div>
                <div class="absolute -right-12 -top-12 h-40 w-40 rounded-full bg-white/10"></div>
                <div class="absolute -left-8 -bottom-12 h-32 w-32 rounded-full bg-white/10"></div>
              </div>
              <div class="flex flex-1 flex-col p-6">
                <div class="flex flex-wrap gap-1.5 mb-4">
                  <span class="rounded-full bg-blue-50 px-2.5 py-0.5 text-[11px] font-medium text-1panel">100+ 提供商对比</span>
                  <span class="rounded-full bg-blue-50 px-2.5 py-0.5 text-[11px] font-medium text-1panel">语义级路由差异</span>
                  <span class="rounded-full bg-blue-50 px-2.5 py-0.5 text-[11px] font-medium text-1panel">Agent / MCP</span>
                </div>
                <p class="flex-1 text-sm leading-relaxed text-gray-600">
