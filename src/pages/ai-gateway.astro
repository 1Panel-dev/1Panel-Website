---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Statistics from "../components/Statistics.astro";
import { Icon } from "astro-icon/components";
import {
  SITE_URL,
  createBreadcrumbSchema,
  toAbsoluteUrl,
} from "../lib/seo";
import "../styles/global.css";

const siteUrl = Astro.site?.toString() ?? SITE_URL;
const pageUrl = toAbsoluteUrl("/ai-gateway.html", siteUrl);
const trialUrl = "https://jsj.top/f/umuYtv";

const gatewayKeywords = [
  "统一接入",
  "模型代理",
  "席位管理",
  "用量统计",
  "智能路由",
  "内容合规",
];

const capabilityCards = [
  {
    icon: "carbon:gateway",
    title: "统一接入",
    advantage:
      "为内部 AI 应用和模型调用提供统一接入入口，集中承接不同业务系统的 AI 请求。",
    benefit:
      "降低 AI 应用接入复杂度，避免各业务系统重复对接模型服务。",
  },
  {
    icon: "carbon:network-4",
    title: "模型代理",
    advantage:
      "通过 AI 网关统一代理模型访问，支持内部应用按需调用不同模型能力。",
    benefit:
      "减少业务侧重复对接，便于企业统一管理模型资源和访问链路。",
  },
  {
    icon: "carbon:flow",
    title: "智能路由",
    advantage:
      "根据模型、应用和调用场景统一处理 AI 请求转发、路由和调用链路。",
    benefit:
      "提升 AI 调用链路的可管理性，便于问题排查和服务治理。",
  },
  {
    icon: "carbon:user-role",
    title: "席位管理",
    advantage:
      "支持对用户、团队或应用的 AI 使用席位和权限进行集中管理。",
    benefit:
      "帮助企业控制 AI 使用范围，减少越权调用和资源滥用风险。",
  },
  {
    icon: "carbon:chart-line-data",
    title: "用量统计",
    advantage:
      "对 AI 调用次数、使用情况和资源消耗进行统一统计和查看。",
    benefit:
      "帮助企业清晰了解 AI 使用情况，为成本分析和资源规划提供依据。",
  },
  {
    icon: "carbon:content-delivery-network",
    title: "内容合规",
    advantage:
      "对 AI 调用内容进行统一治理和合规检查。",
    benefit:
      "降低敏感内容、违规内容和不合规使用带来的风险，提升企业 AI 使用安全性。",
  },
];

const pageTitle = "1Panel AI 网关 - 打造企业专属的 AI 统一接入与治理平台";
const pageDescription =
  "1Panel AI 网关为内部 AI 应用和模型调用提供统一接入入口，支持模型代理、席位管理、用量统计、智能路由和内容合规。";
const aiGatewaySchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "@id": `${pageUrl}#product`,
  name: "1Panel AI 网关",
  applicationCategory: "DeveloperApplication",
  applicationSubCategory: "AI gateway",
  operatingSystem: "Linux",
  description: pageDescription,
  url: pageUrl,
  featureList: [
    "统一接入",
    "模型代理",
    "席位管理",
    "用量统计",
    "智能路由",
    "内容合规",
  ],
  publisher: {
    "@type": "Organization",
    name: "杭州飞致云信息科技有限公司",
  },
};
---

<Layout
  title={pageTitle}
  socialTitle="1Panel AI 网关"
  schemaName="1Panel AI 网关"
  description={pageDescription}
  canonical="/ai-gateway.html"
  image="/images/enterprise-ai-gateway.png"
  imageWidth={3432}
  imageHeight={2172}
  imageAlt="1Panel AI 网关"
  keywords={[
    "1Panel AI 网关",
    "AI 网关",
    "统一接入",
    "模型代理",
    "席位管理",
    "用量统计",
    "智能路由",
    "内容合规",
  ]}
  structuredData={[
    createBreadcrumbSchema([
      { name: "1Panel 官网", url: toAbsoluteUrl("/", siteUrl) },
      { name: "1Panel AI 网关", url: pageUrl },
    ]),
    aiGatewaySchema,
  ]}
>
  <Statistics slot="head" />
  <Fragment slot="main">
    <Header />
    <main class="relative z-10 bg-white text-gray-800">
      <section class="relative overflow-hidden bg-gradient-to-b from-blue-50/80 via-white to-white pt-20 pb-16 lg:pt-28 lg:pb-24">
        <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-blue-200 to-transparent"></div>
        <div class="container-custom">
          <div class="mx-auto max-w-4xl text-center">
            <a href="/enterprise.html" class="fade-in-up mb-6 inline-flex items-center justify-center rounded-full border border-blue-100 bg-white px-4 py-2 text-sm font-semibold text-1panel shadow-sm transition-all duration-300 hover:border-blue-200 hover:bg-blue-50" style="animation-delay: 0.05s;">
              <Icon name="carbon:arrow-left" class="mr-2 h-4 w-4" />
              返回企业版
            </a>
            <h1 class="fade-in-up text-4xl font-bold leading-tight tracking-normal text-gray-950 sm:text-5xl lg:text-6xl" style="animation-delay: 0.1s;">
              1Panel AI 网关
            </h1>
            <p class="fade-in-up mt-6 text-lg leading-relaxed text-gray-600 sm:text-xl" style="animation-delay: 0.2s;">
              打造企业专属的 AI 统一接入与治理平台
            </p>
            <div class="fade-in-up mt-8 flex flex-wrap justify-center gap-3" style="animation-delay: 0.3s;">
              {gatewayKeywords.map((keyword) => (
                <span class="rounded-md border border-blue-100 bg-white px-4 py-2 text-sm font-semibold text-1panel shadow-sm">
                  {keyword}
                </span>
              ))}
            </div>
            <a href={trialUrl} target="_blank" rel="noopener noreferrer" class="btn-primary fade-in-up mt-7 inline-flex items-center justify-center px-9 py-4 text-base" style="animation-delay: 0.32s;">
              申请试用
              <Icon name="carbon:arrow-right" class="ml-2 h-5 w-5" />
            </a>
          </div>

          <div class="fade-in-up mt-8" style="animation-delay: 0.35s;">
            <div class="relative overflow-hidden rounded-lg shadow-2xl shadow-blue-100/70">
              <div class="relative overflow-hidden rounded-lg bg-gray-50">
                <img
                  src="/images/1p-ai-gateway.png"
                  alt="1Panel AI 网关产品界面"
                  width="2559"
                  height="1252"
                  class="h-auto w-full object-contain"
                  loading="eager"
                />
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="py-16 lg:py-24">
        <div class="container-custom">
          <div class="mx-auto mb-12 max-w-3xl text-center">
            <h2 class="text-3xl font-bold leading-tight text-gray-900 lg:text-5xl">
              统一接入，智能路由，合规保障
            </h2>
            <p class="mt-5 text-lg leading-relaxed text-gray-600">
              1Panel AI 网关提供从统一接入、智能路由到合规审计的全链条管控，让企业 AI 落地更安全、更高效、更可控。
            </p>
          </div>

          <div class="grid grid-cols-1 gap-5 md:grid-cols-2 lg:grid-cols-3">
            {capabilityCards.map((capability, index) => (
              <article
                class="fade-in-up rounded-lg border border-gray-100 bg-white p-6 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:border-blue-100 hover:shadow-xl"
                style={`animation-delay: ${index * 0.05}s;`}
              >
                <span class="mb-5 inline-flex h-12 w-12 items-center justify-center rounded-lg bg-blue-50 text-1panel">
                  <Icon name={capability.icon} class="h-6 w-6" />
                </span>
                <h3 class="text-xl font-bold text-gray-900">{capability.title}</h3>
                <p class="mt-3 text-sm leading-relaxed text-gray-600">
                  <span class="font-semibold text-gray-800">作用：</span>{capability.advantage}
                </p>
                <p class="mt-3 text-sm leading-relaxed text-gray-600">
                  <span class="font-semibold text-gray-800">价值：</span>{capability.benefit}
                </p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="bg-white py-16 lg:py-24">
        <div class="container-custom">
          <div class="overflow-hidden rounded-lg border border-blue-100 bg-gradient-to-r from-blue-50 to-white p-6 shadow-sm sm:p-8 lg:p-10">
            <div class="grid grid-cols-1 items-center gap-8 lg:grid-cols-[1fr_auto]">
              <div>
                <h2 class="text-2xl font-bold text-gray-900 lg:text-3xl">
                  面向内部 AI 应用和模型调用的统一入口
                </h2>
                <p class="mt-4 max-w-3xl text-base leading-relaxed text-gray-600">
                  1Panel AI 网关通过统一接入、模型代理、席位管理、用量统计、智能路由和内容合规，帮助企业集中管理模型访问、调用链路和使用成本，提升 AI 应用的治理能力与安全可控性。
                </p>
              </div>
              <a href="/enterprise.html" class="btn-primary inline-flex items-center justify-center px-8 py-4 text-base">
                了解企业版
                <Icon name="carbon:arrow-right" class="ml-2 h-5 w-5" />
              </a>
            </div>
          </div>
        </div>
      </section>

      <!-- AI 网关选型指南 -->
      <section id="gateway-selection" class="scroll-mt-28 bg-gradient-to-b from-blue-50/60 to-white py-16 lg:py-24 border-t border-blue-100">
        <div class="container-custom">
          <div class="mx-auto mb-12 max-w-3xl text-center">
            <h2 class="text-3xl font-bold leading-tight text-gray-900 lg:text-4xl">
              <span class="text-1panel">AI 网关选型指南</span>
            </h2>
            <p class="mt-4 text-base leading-relaxed text-gray-600">
              <strong class="text-gray-800">为什么 1Panel AI 网关更适合企业内部署使用？</strong><br/>
              我们整理了与两款主流 AI 网关的深度对比，帮你看清企业级 AI 治理与开源聚合网关的本质差异。
            </p>
          </div>

          <div class="grid grid-cols-1 gap-6 md:grid-cols-2 max-w-5xl mx-auto">
            <a
              href="/1panel-ai-gateway-vs-newapi.html"
              class="group flex flex-col overflow-hidden rounded-2xl border border-gray-100 bg-white shadow-sm transition-all duration-300 hover:-translate-y-1 hover:border-blue-200 hover:shadow-xl"
            >
              <div class="relative aspect-[16/9] overflow-hidden bg-gradient-to-br from-blue-600 via-blue-500 to-indigo-600">
                <div class="absolute inset-0 flex flex-col items-center justify-center px-6 text-center">
                  <div class="mb-3 flex items-center gap-3 text-white/90">
                    <span class="inline-flex h-10 w-10 items-center justify-center rounded-lg bg-white/15 text-base font-bold backdrop-blur-sm">1P</span>
                    <span class="text-3xl font-light">vs</span>
                    <span class="inline-flex h-10 items-center justify-center rounded-lg bg-white/15 px-3 text-base font-bold backdrop-blur-sm">New API</span>
                  </div>
                  <h3 class="text-xl font-bold text-white lg:text-2xl">1Panel AI 网关 vs New API</h3>
                  <p class="mt-2 text-sm text-white/80">企业级治理 vs 开源聚合分发</p>
                </div>
                <div class="absolute -right-12 -top-12 h-40 w-40 rounded-full bg-white/10"></div>
                <div class="absolute -left-8 -bottom-12 h-32 w-32 rounded-full bg-white/10"></div>
              </div>
              <div class="flex flex-1 flex-col p-6">
                <div class="flex flex-wrap gap-1.5 mb-4">
                  <span class="rounded-full bg-blue-50 px-2.5 py-0.5 text-[11px] font-medium text-1panel">语义级智能路由</span>
                  <span class="rounded-full bg-blue-50 px-2.5 py-0.5 text-[11px] font-medium text-1panel">三层内容合规</span>
                  <span class="rounded-full bg-blue-50 px-2.5 py-0.5 text-[11px] font-medium text-1panel">四级并发控制</span>
                </div>
                <p class="flex-1 text-sm leading-relaxed text-gray-600">
                  企业级 <strong>AI 治理基础设施</strong>，核心差异在语义级智能路由、谐音/拆字/拼音的内容合规审计、四级并发控制 + 会话亲和、组织级权限管控。
                </p>
                <div class="mt-5 flex items-center justify-between border-t border-gray-100 pt-4">
                  <span class="text-xs text-gray-500">7 维度深度对比</span>
                  <span class="inline-flex items-center gap-1 text-sm font-semibold text-1panel group-hover:gap-2 transition-all">
                    阅读对比报告
                    <Icon name="carbon:arrow-right" class="h-4 w-4" />
                  </span>
                </div>
              </div>
            </a>

            <a
              href="/1panel-ai-gateway-vs-litellm.html"
              class="group flex flex-col overflow-hidden rounded-2xl border border-gray-100 bg-white shadow-sm transition-all duration-300 hover:-translate-y-1 hover:border-blue-200 hover:shadow-xl"
            >
              <div class="relative aspect-[16/9] overflow-hidden bg-gradient-to-br from-blue-600 via-blue-500 to-cyan-600">
                <div class="absolute inset-0 flex flex-col items-center justify-center px-6 text-center">
                  <div class="mb-3 flex items-center gap-3 text-white/90">
                    <span class="inline-flex h-10 w-10 items-center justify-center rounded-lg bg-white/15 text-base font-bold backdrop-blur-sm">1P</span>
                    <span class="text-3xl font-light">vs</span>
                    <span class="inline-flex h-10 items-center justify-center rounded-lg bg-white/15 px-3 text-base font-bold backdrop-blur-sm">LiteLLM</span>
                  </div>
                  <h3 class="text-xl font-bold text-white lg:text-2xl">1Panel AI 网关 vs LiteLLM</h3>
                  <p class="mt-2 text-sm text-white/80">中国本土企业治理 vs 全球工程标准</p>
                </div>
                <div class="absolute -right-12 -top-12 h-40 w-40 rounded-full bg-white/10"></div>
                <div class="absolute -left-8 -bottom-12 h-32 w-32 rounded-full bg-white/10"></div>
              </div>
              <div class="flex flex-1 flex-col p-6">
                <div class="flex flex-wrap gap-1.5 mb-4">
                  <span class="rounded-full bg-blue-50 px-2.5 py-0.5 text-[11px] font-medium text-1panel">100+ 提供商对比</span>
                  <span class="rounded-full bg-blue-50 px-2.5 py-0.5 text-[11px] font-medium text-1panel">语义级路由差异</span>
                  <span class="rounded-full bg-blue-50 px-2.5 py-0.5 text-[11px] font-medium text-1panel">Agent / MCP</span>
                </div>
                <p class="flex-1 text-sm leading-relaxed text-gray-600">
                  全球领先工程网关，对比维度覆盖 100+ 提供商广度、Auto Router V2 自动降本、可观测生态、Agent + MCP 集成，看清「工程 SDK」与「企业治理」差异。
                </p>
                <div class="mt-5 flex items-center justify-between border-t border-gray-100 pt-4">
                  <span class="text-xs text-gray-500">7 维度深度对比</span>
                  <span class="inline-flex items-center gap-1 text-sm font-semibold text-1panel group-hover:gap-2 transition-all">
                    阅读对比报告
                    <Icon name="carbon:arrow-right" class="h-4 w-4" />
                  </span>
                </div>
              </div>
            </a>
          </div>

          <div class="mt-10 text-center">
            <a href={trialUrl} target="_blank" rel="noopener noreferrer" class="btn-primary inline-flex items-center justify-center px-9 py-4 text-base">
              申请试用 1Panel AI 网关
              <Icon name="carbon:arrow-right" class="ml-2 h-5 w-5" />
            </a>
          </div>
        </div>
      </section>
    </main>
    <Footer />
  </Fragment>
</Layout>
