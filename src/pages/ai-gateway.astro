---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Statistics from "../components/Statistics.astro";
import { Icon } from "astro-icon/components";
import {
  SITE_URL,
  createBreadcrumbSchema,
  toAbsoluteUrl,
} from "../lib/seo";
import "../styles/global.css";

const siteUrl = Astro.site?.toString() ?? SITE_URL;
const pageUrl = toAbsoluteUrl("/ai-gateway.html", siteUrl);
const trialUrl = "mailto:sales@lxware.hk?subject=1Panel Enterprise Trial";

const gatewayKeywords = [
  "Unified Access",
  "Model Proxy",
  "Seat Management",
  "Usage Analytics",
  "Smart Routing",
  "Content Compliance",
];

const capabilityCards = [
  {
    icon: "carbon:gateway",
    title: "Unified Access",
    advantage:
      "Provides a single access point for internal AI applications and model calls, consolidating AI requests from different business systems.",
    benefit:
      "Reduces AI application onboarding complexity, eliminating duplicate model service integrations across business systems.",
  },
  {
    icon: "carbon:network-4",
    title: "Model Proxy",
    advantage:
      "Proxies model access through the AI gateway, allowing internal applications to call different model capabilities on demand.",
    benefit:
      "Reduces redundant integration on the business side, enabling centralized management of model resources and access paths.",
  },
  {
    icon: "carbon:flow",
    title: "Smart Routing",
    advantage:
      "Unified handling of AI request forwarding, routing, and call chains based on model, application, and use-case context.",
    benefit:
      "Improves manageability of AI call chains, facilitating troubleshooting and service governance.",
  },
  {
    icon: "carbon:user-role",
    title: "Seat Management",
    advantage:
      "Centralized management of AI usage seats and permissions for users, teams, or applications.",
    benefit:
      "Helps organizations control AI usage scope, reducing risks of unauthorized access and resource abuse.",
  },
  {
    icon: "carbon:chart-line-data",
    title: "Usage Analytics",
    advantage:
      "Unified statistics and visibility into AI call volume, usage patterns, and resource consumption.",
    benefit:
      "Gives organizations clear insight into AI usage, supporting cost analysis and resource planning.",
  },
  {
    icon: "carbon:content-delivery-network",
    title: "Content Compliance",
    advantage:
      "Unified governance and compliance checks on AI-generated content.",
    benefit:
      "Reduces risks from sensitive content, policy violations, and non-compliant usage, improving enterprise AI safety.",
  },
];

const pageTitle = "1Panel AI Gateway - Unified AI Access, Model Proxy & Smart Routing";
const pageDescription =
  "1Panel AI Gateway provides a single access point for internal AI applications and model calls, supporting model proxy, seat management, usage analytics, smart routing, and content compliance.";
const aiGatewaySchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "@id": `${pageUrl}#product`,
  name: "1Panel AI Gateway",
  applicationCategory: "DeveloperApplication",
  applicationSubCategory: "AI gateway",
  operatingSystem: "Linux",
  description: pageDescription,
  url: pageUrl,
  featureList: [
    "Unified Access",
    "Model Proxy",
    "Seat Management",
    "Usage Analytics",
    "Smart Routing",
    "Content Compliance",
  ],
  publisher: {
    "@type": "Organization",
    name: "FIT2CLOUD Hangzhou",
  },
};
---

<Layout
  title={pageTitle}
  socialTitle="1Panel AI Gateway"
  schemaName="1Panel AI Gateway"
  description={pageDescription}
  canonical="/ai-gateway.html"
  image="/images/enterprise-ai-gateway.png"
  imageWidth={3432}
  imageHeight={2172}
  imageAlt="1Panel AI Gateway"
  keywords={[
    "1Panel AI Gateway",
    "AI Gateway",
    "Unified Access",
    "Model Proxy",
    "Seat Management",
    "Usage Analytics",
    "Smart Routing",
    "Content Compliance",
  ]}
  structuredData={[
    createBreadcrumbSchema([
      { name: "1Panel", url: toAbsoluteUrl("/", siteUrl) },
      { name: "1Panel AI Gateway", url: pageUrl },
    ]),
    aiGatewaySchema,
  ]}
>
  <Statistics slot="head" />
  <Fragment slot="main">
    <Header />
    <main class="relative z-10 bg-white text-gray-800">
      <section class="relative overflow-hidden bg-gradient-to-b from-blue-50/80 via-white to-white pt-20 pb-16 lg:pt-28 lg:pb-24">
        <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-blue-200 to-transparent"></div>
        <div class="container-custom">
          <div class="mx-auto max-w-4xl text-center">
            <a href="/enterprise.html" class="fade-in-up mb-6 inline-flex items-center justify-center rounded-full border border-blue-100 bg-white px-4 py-2 text-sm font-semibold text-1panel shadow-sm transition-all duration-300 hover:border-blue-200 hover:bg-blue-50" style="animation-delay: 0.05s;">
              <Icon name="carbon:arrow-left" class="mr-2 h-4 w-4" />
              Back to Enterprise
            </a>
            <h1 class="fade-in-up text-4xl font-bold leading-tight tracking-normal text-gray-950 sm:text-5xl lg:text-6xl" style="animation-delay: 0.1s;">
              1Panel AI Gateway
            </h1>
            <p class="fade-in-up mt-6 text-lg leading-relaxed text-gray-600 sm:text-xl" style="animation-delay: 0.2s;">
              A single access point for internal AI applications and model calls, supporting model proxy, seat management, usage analytics, smart routing, and content compliance.
            </p>
            <div class="fade-in-up mt-8 flex flex-wrap justify-center gap-3" style="animation-delay: 0.3s;">
              {gatewayKeywords.map((keyword) => (
                <span class="rounded-md border border-blue-100 bg-white px-4 py-2 text-sm font-semibold text-1panel shadow-sm">
                  {keyword}
                </span>
              ))}
            </div>
            <a href={trialUrl} class="btn-primary fade-in-up mt-7 inline-flex items-center justify-center px-9 py-4 text-base" style="animation-delay: 0.32s;">
              Request a Trial
              <Icon name="carbon:arrow-right" class="ml-2 h-5 w-5" />
            </a>
          </div>

          <div class="fade-in-up mt-8" style="animation-delay: 0.35s;">
            <div class="relative overflow-hidden rounded-lg shadow-2xl shadow-blue-100/70">
              <div class="relative overflow-hidden rounded-lg bg-gray-50">
                <img
                  src="/images/enterprise-ai-gateway.png"
                  alt="1Panel AI Gateway Features"
                  class="h-auto w-full object-cover"
                  loading="eager"
                />
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="py-16 lg:py-24">
        <div class="container-custom">
          <div class="mx-auto mb-12 max-w-3xl text-center">
            <h2 class="text-3xl font-bold leading-tight text-gray-900 lg:text-5xl">
              Unified Access, Smart Routing
            </h2>
            <p class="mt-5 text-lg leading-relaxed text-gray-600">
              From model proxy and seat management to usage analytics, smart routing, and content compliance, providing a clear gateway entry point for internal AI applications.
            </p>
          </div>

          <div class="grid grid-cols-1 gap-5 md:grid-cols-2 lg:grid-cols-3">
            {capabilityCards.map((capability, index) => (
              <article
                class="fade-in-up rounded-lg border border-gray-100 bg-white p-6 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:border-blue-100 hover:shadow-xl"
                style={`animation-delay: ${index * 0.05}s;`}
              >
                <span class="mb-5 inline-flex h-12 w-12 items-center justify-center rounded-lg bg-blue-50 text-1panel">
                  <Icon name={capability.icon} class="h-6 w-6" />
                </span>
                <h3 class="text-xl font-bold text-gray-900">{capability.title}</h3>
                <p class="mt-3 text-sm leading-relaxed text-gray-600">
                  <span class="font-semibold text-gray-800">Function: </span>{capability.advantage}
                </p>
                <p class="mt-3 text-sm leading-relaxed text-gray-600">
                  <span class="font-semibold text-gray-800">Value: </span>{capability.benefit}
                </p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="bg-white py-16 lg:py-24">
        <div class="container-custom">
          <div class="overflow-hidden rounded-lg border border-blue-100 bg-gradient-to-r from-blue-50 to-white p-6 shadow-sm sm:p-8 lg:p-10">
            <div class="grid grid-cols-1 items-center gap-8 lg:grid-cols-[1fr_auto]">
              <div>
                <h2 class="text-2xl font-bold text-gray-900 lg:text-3xl">
                  Unified Entry for Internal AI Applications & Model Calls
                </h2>
                <p class="mt-4 max-w-3xl text-base leading-relaxed text-gray-600">
                  1Panel AI Gateway helps enterprises centrally manage model access, call chains, and usage costs through unified access, model proxy, seat management, usage analytics, smart routing, and content compliance, improving AI application governance and security.
                </p>
              </div>
              <a href="/enterprise.html" class="btn-primary inline-flex items-center justify-center px-8 py-4 text-base">
                Learn About Enterprise
                <Icon name="carbon:arrow-right" class="ml-2 h-5 w-5" />
              </a>
            </div>
          </div>
        </div>
      </section>
    </main>
    <Footer />
  </Fragment>
</Layout>
