<script>
  document.querySelectorAll<HTMLElement>("[data-tour]").forEach((root) => {
    const slides = Array.from(root.querySelectorAll<HTMLElement>("[data-slide]"));
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-tour-tab]"));
    const caption = root.querySelector<HTMLElement>("[data-tour-caption]");
    const prev = root.querySelector<HTMLButtonElement>("[data-tour-prev]");
    const next = root.querySelector<HTMLButtonElement>("[data-tour-next]");
    if (slides.length < 2) return;

    const captions = slides.map((slide) => slide.dataset.caption ?? "");
    const activeClasses = ["border-blue-200", "bg-blue-50", "text-1panel", "shadow-sm"];
    const idleClasses = ["border-gray-200", "bg-white", "text-gray-500"];
    let index = 0;
    let timer: number | undefined;

    const render = () => {
      slides.forEach((slide, i) => {
        const active = i === index;
        slide.classList.toggle("opacity-100", active);
        slide.classList.toggle("opacity-0", !active);
        slide.classList.toggle("pointer-events-none", !active);
        slide.setAttribute("aria-hidden", active ? "false" : "true");
        const link = slide.querySelector("a");
        if (link) link.tabIndex = active ? 0 : -1;
      });
      tabs.forEach((tab, i) => {
        const active = i === index;
        activeClasses.forEach((cls) => tab.classList.toggle(cls, active));
        idleClasses.forEach((cls) => tab.classList.toggle(cls, !active));
        tab.setAttribute("aria-current", active ? "true" : "false");
      });
      if (caption) caption.textContent = captions[index] ?? "";
    };

    const go = (target: number) => {
      index = (target + slides.length) % slides.length;
      render();
    };

    const stop = () => {
      if (timer !== undefined) window.clearInterval(timer);
      timer = undefined;
    };
    const start = () => {
      stop();
      if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
      timer = window.setInterval(() => go(index + 1), 6000);
    };

    prev?.addEventListener("click", () => {
      go(index - 1);
      start();
    });
    next?.addEventListener("click", () => {
      go(index + 1);
      start();
    });
    tabs.forEach((tab, i) =>
      tab.addEventListener("click", () => {
        go(i);
        start();
      })
    );

    root.addEventListener("pointerenter", stop);
    root.addEventListener("pointerleave", start);
    root.addEventListener("focusin", stop);
    root.addEventListener("focusout", start);
    root.addEventListener("keydown", (event) => {
      if (event.key === "ArrowLeft") {
        event.preventDefault();
        go(index - 1);
      } else if (event.key === "ArrowRight") {
        event.preventDefault();
        go(index + 1);
      }
    });

    let touchX = 0;
    root.addEventListener(
      "touchstart",
      (event) => {
        touchX = event.touches[0].clientX;
      },
      { passive: true }
    );
    root.addEventListener(
      "touchend",
      (event) => {
        const dx = event.changedTouches[0].clientX - touchX;
        if (Math.abs(dx) > 40) {
          go(index + (dx < 0 ? 1 : -1));
          start();
        }
      },
      { passive: true }
    );

    render();
    start();
  });
</script>
