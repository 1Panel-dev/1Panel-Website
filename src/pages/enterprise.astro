---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Statistics from "../components/Statistics.astro";
import { Icon } from "astro-icon/components";
import { SITE_URL, createBreadcrumbSchema, toAbsoluteUrl } from "../lib/seo";
import "../styles/global.css";

const siteUrl = Astro.site?.toString() ?? SITE_URL;
const siteBase = import.meta.env.BASE_URL;
const enterprisePageUrl = toAbsoluteUrl("/enterprise.html", siteUrl, siteBase);
const trialUrl = "https://jsj.top/f/umuYtv";

const screenshots = [
  {
    src: "/images/enterprise/1p-enterprise-01-overview.webp",
    width: 1920,
    height: 1215,
    tab: "概览",
    alt: "1Panel 企业版概览：GPU 状态、系统信息与应用列表",
    caption:
      "概览：一屏汇总模型、智能体、网站、数据库与应用数量，并实时展示 GPU 状态、系统信息与应用安装入口。",
  },
  {
    src: "/images/enterprise/1p-enterprise-02-gpu-status.webp",
    width: 2000,
    height: 1266,
    tab: "GPU 实时状态",
    alt: "1Panel 企业版 GPU 管理实时状态：8 张 GPU 的使用率、显存与温度",
    caption:
      "GPU 管理 · 实时状态：8 张 GPU 的使用率、显存、温度、功耗与风扇转速逐卡可见，驱动与 CUDA 版本一目了然。",
  },
  {
    src: "/images/enterprise/1p-enterprise-03-gpu-monitor.webp",
    width: 2000,
    height: 1266,
    tab: "GPU 监控数据",
    alt: "1Panel 企业版 GPU 监控数据：使用率、显存、功耗与温度的时序曲线",
    caption:
      "GPU 管理 · 监控数据：按时间范围查看 GPU 使用率、显存、功耗与温度的时序曲线，负载变化有据可查。",
  },
  {
    src: "/images/enterprise/1p-enterprise-04-model-catalog.webp",
    width: 2000,
    height: 1266,
    tab: "精选模型",
    alt: "1Panel 企业版 vLLM 管理精选模型：模型卡片与下载入口",
    caption:
      "vLLM 管理 · 精选模型：按厂商、类别和权重提供商筛选模型，查看激活参数与权重体积后直接下载。",
  },
  {
    src: "/images/enterprise/1p-enterprise-05-model-deploy.webp",
    width: 1920,
    height: 1080,
    tab: "模型部署",
    alt: "1Panel 企业版模型部署：创建 vLLM 实例并配置 GPU、镜像与服务端口",
    caption:
      "vLLM 管理 · 模型部署：选择 GPU 类型、vLLM 版本与镜像，配置服务端口、模型权重与加速卡编排后，一键创建推理实例。",
  },
  {
    src: "/images/enterprise/1p-enterprise-06-model-service.webp",
    width: 1920,
    height: 1215,
    tab: "模型服务",
    alt: "1Panel 企业版模型服务：API 类型、验证状态与访问端点列表",
    caption:
      "vLLM 管理 · 模型服务：统一管理已部署模型的 API 类型、验证状态与访问端点，供智能体与外部工具调用。",
  },
  {
    src: "/images/enterprise/1p-enterprise-07-benchmark.webp",
    width: 1920,
    height: 1080,
    tab: "基准测试",
    alt: "1Panel 企业版基准测试：多并发场景的 TTFT、TPOT 与吞吐指标",
    caption:
      "基准测试：按并发数与输入 / 输出 Token 组合压测，查看 TTFT、TPOT、单路与总输出吞吐，并导出 JSON / CSV / HTML / ZIP 报告。",
  },
  {
    src: "/images/enterprise/1p-enterprise-08-usage.webp",
    width: 2000,
    height: 1262,
    tab: "用量统计",
    alt: "1Panel AI 网关用量统计：请求量、Token 用量与缓存命中率",
    caption:
      "AI 网关 · 用量统计：按供应商、上游账号、模型组统计请求量、输入与输出 Token、缓存命中率，用量与成本可量化。",
  },
];

const layerTabs = [
  {
    id: "application-layer",
    name: "应用层",
    subtitle: "AI 应用全生命周期管理",
    icon: "carbon:application",
    color: "blue",
    description:
      "支持通过 1Panel 应用商店快速部署和管理 AI 编程、AI 办公、AI 知识库与 AI 工作流等各种 AI 应用。",
    items: ["DeepSeek Harness", "Octop", "OpenClaw", "Hermes Agent", "MaxKB", "n8n"],
    detailHref: "/agent-management.html",
  },
  {
    id: "governance-layer",
    name: "治理层",
    subtitle: "企业级 AI 治理",
    icon: "carbon:security",
    color: "indigo",
    description:
      "提供从统一接入、智能路由到合规审计的全链条管控，让企业 AI 落地更安全、更高效、更可控。",
    items: ["AI 门户", "Skills 仓库", "MCP 市场", "AI 网关"],
    detailHref: "/ai-gateway.html",
  },
  {
    id: "model-layer",
    name: "模型层",
    subtitle: "算力与模型支持",
    icon: "carbon:machine-learning-model",
    color: "cyan",
    description:
      "提供本地模型统一管理能力，支持 DeepSeek、Qwen、GLM 等主流开源大模型，并适配 NVIDIA、Intel、华为昇腾等主流算力环境。",
    items: ["Qwen", "deepseek", "GLM", "NVIDIA", "华为昇腾", "Intel"],
    detailHref: "/model-management.html",
  },
  {
    id: "infrastructure-layer",
    name: "基础设施层",
    subtitle: "虚拟机与基础资源管理",
    icon: "carbon:virtual-machine",
    color: "blue",
    description:
      "集中管理虚拟机及其镜像、模板、网络和存储池，覆盖资源概览、生命周期操作、控制台、监控与快照等日常管理。",
    items: ["虚拟机", "镜像与模板", "网络", "存储池"],
    detailHref: "/virtual-machine.html",
  },
];

const enterpriseOnlyCapabilities = [
  {
    icon: "carbon:gateway",
    title: "AI 网关",
    href: "/ai-gateway.html",
    tag: "统一入口",
    description:
      "提供从模型代理、智能路由到合规审计的全链条管控，让企业 AI 落地更安全、更高效、更可控。",
    points: ["模型代理", "智能路由", "合规审计"],
  },
  {
    icon: "carbon:machine-learning-model",
    title: "模型管理",
    href: "/model-management.html",
    tag: "全生命周期",
    description:
      "官方精选并验证 DeepSeek、Qwen 和 GLM 模型，支持便捷下载、vLLM 可视化部署与本地推理引擎监控。",
    points: ["精选模型", "便捷下载", "快速启动", "持续监控"],
  },
  {
    icon: "carbon:bot",
    title: "智能体管理",
    href: "/agent-management.html",
    tag: "常驻托管",
    description:
      "一键创建主流 AI 助理智能体，托管常驻运行、版本无缝升级、配置备份恢复，7×24 小时稳定在线。",
    points: ["托管运行", "无缝升级", "备份恢复"],
  },
  {
    icon: "carbon:user-access",
    title: "AI 门户",
    href: "/ai-portal.html",
    tag: "自助入口",
    description:
      "面向企业内部用户提供自助入口，让团队成员自助申请API Key、查看用量、安装 Skills 等。",
    points: ["API Key 管理", "技能市场", "MCP 市场"],
  },
  {
    icon: "carbon:headset",
    title: "Skills 仓库",
    href: "/skills-hub.html",
    tag: "持续积累",
    description:
      "在组织内发布、发现和管理可复用的 Skills 技能，确保可审计、可治理。",
    points: ["统一管理", "版本管理", "安全审计"],
  },
  {
    icon: "carbon:user-multiple",
    title: "用户及认证管理",
    href: "/user-management.html",
    tag: "组织协作",
    description:
      "面向部门和企业内部多角色使用场景，支持用户、权限与认证管理，可接入 AD/LDAP、OIDC 和 SAML2。",
    points: ["用户账号", "权限分配", "认证管理"],
  },
];

const layerClassMap = {
  blue: {
    badge: "bg-blue-50 text-1panel",
    border: "border-blue-100",
    icon: "bg-blue-50 text-1panel",
    accent: "from-blue-50 to-white",
  },
  indigo: {
    badge: "bg-indigo-50 text-indigo-600",
    border: "border-indigo-100",
    icon: "bg-indigo-50 text-indigo-600",
    accent: "from-indigo-50 to-white",
  },
  cyan: {
    badge: "bg-cyan-50 text-cyan-700",
    border: "border-cyan-100",
    icon: "bg-cyan-50 text-cyan-700",
    accent: "from-cyan-50 to-white",
  },
};

const pageTitle = "1Panel 企业版 - AI 服务器管理面板";
const pageDescription =
  "1Panel 企业版是从底层硬件、虚拟机等基础资源到智能体（Metal-to-Agent）的统一管理面板，覆盖企业级 AI 治理、用户及认证管理及基础设施管理。";
const enterpriseSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "@id": `${enterprisePageUrl}#product`,
  name: "1Panel 企业版",
  alternateName: "1Panel Enterprise Edition",
  applicationCategory: "DeveloperApplication",
  applicationSubCategory: "AI server management panel",
  operatingSystem: "Linux",
  description: pageDescription,
  url: enterprisePageUrl,
  audience: {
    "@type": "BusinessAudience",
    audienceType: "企业、部门级 AI 部署团队、运维管理团队",
  },
  softwareRequirements: "Linux 服务器环境",
  featureList: [
    "1Panel AI 门户",
    "AI 网关自助管理",
    "Skills 仓库自助管理",
    "MCP 市场自助管理",
    "AI 网关",
    "Skills 仓库",
    "多用户管理",
    "认证管理",
    "AD/LDAP",
    "OIDC",
    "SAML2",
    "KVM Web 虚拟机管理",
    "安全运维报表",
    "多节点纳管",
    "纯离线环境适配",
    "AI 应用一键部署",
    "本地模型管理",
  ],
  offers: {
    "@type": "Offer",
    price: "30000",
    priceCurrency: "CNY",
    availability: "https://schema.org/InStock",
    url: enterprisePageUrl,
    seller: {
      "@type": "Organization",
      name: "杭州飞致云信息科技有限公司",
    },
  },
};
---

<Layout
  title={pageTitle}
  socialTitle="1Panel 企业版 - AI 服务器管理面板"
  schemaName="1Panel 企业版"
  description={pageDescription}
  canonical="/enterprise.html"
  image="/images/overview-full.png"
  imageAlt="1Panel 企业版介绍"
  modifiedTime="2026-08-26"
  keywords={[
    "1Panel 企业版",
    "1Panel AI 门户",
    "1Panel AI 网关",
    "Skills 仓库",
    "API Key 管理",
    "技能市场",
    "MCP 市场",
    "AI 服务器管理面板",
    "私有化 AI 部署",
    "AI 应用部署",
    "多用户管理",
    "认证管理",
    "AD/LDAP",
    "OIDC",
    "SAML2",
    "虚拟机管理",
    "KVM Web 管理",
    "KVM 虚拟机管理",
    "模型管理",
    "安全运维报表",
    "纯离线部署",
  ]}
  structuredData={[
    createBreadcrumbSchema([
      { name: "1Panel 官网", url: toAbsoluteUrl("/", siteUrl, siteBase) },
      { name: "1Panel 企业版", url: enterprisePageUrl },
    ]),
    enterpriseSchema,
  ]}
>
  <Statistics slot="head" />
  <Fragment slot="main">
    <Header />
    <main class="relative z-10 bg-white text-gray-800">
      <section class="relative overflow-hidden bg-gradient-to-b from-blue-50/80 via-white to-white pt-20 pb-12 lg:pt-28 lg:pb-16">
        <div class="container-custom">
          <div class="fade-in-up mx-auto mb-10 max-w-3xl text-center lg:mb-12" style="animation-delay: 0.1s;">
            <h1 class="text-4xl font-bold leading-tight tracking-normal text-gray-950 sm:text-5xl lg:text-6xl">
              1Panel 企业版
            </h1>
            <p class="mx-auto mt-4 max-w-2xl px-2 text-base leading-relaxed text-gray-600 sm:text-lg">
              1Panel 企业版是专门为 AI 服务器打造的管理面板，助力企业打造专属的 AI 自主环境，在 AI 快速部署与企业级安全管控之间实现平衡。
            </p>
            <a href={trialUrl} target="_blank" rel="noopener noreferrer" class="btn-primary mt-7 inline-flex items-center justify-center px-9 py-4 text-base">
              申请试用
              <Icon name="carbon:arrow-right" class="ml-2 h-5 w-5" />
            </a>
          </div>

          <div id="architecture" class="fade-in-up mt-10 overflow-hidden rounded-xl border border-blue-100/80 bg-white p-5 shadow-[0_10px_40px_-12px_rgba(37,79,160,0.18)] sm:p-6 lg:mt-12 lg:p-8" style="animation-delay: 0.18s;">
            <div class="mb-6 text-center lg:mb-7">
              <h2 class="mx-auto max-w-4xl text-base font-bold tracking-tight text-gray-950 sm:text-lg lg:text-xl">
                1Panel 企业版：从底层硬件到智能体（Metal-to-Agent）的统一管理面板
              </h2>
              <span class="mx-auto mt-3 block h-1 w-10 rounded-full bg-gradient-to-r from-blue-500 to-indigo-500" aria-hidden="true"></span>
            </div>
            <div class="space-y-3">
                <a href="#application-layer" class="group grid grid-cols-1 overflow-hidden rounded-xl border border-slate-200/80 bg-white transition-all duration-300 hover:-translate-y-0.5 hover:border-blue-200 hover:shadow-lg hover:shadow-blue-100/60 sm:grid-cols-[184px_minmax(0,1fr)]">
                  <div class="flex items-center justify-center gap-2.5 border-b border-blue-100/70 bg-gradient-to-r from-blue-50 to-blue-50/30 px-4 py-4 sm:justify-start sm:border-b-0 sm:border-r">
                    <span class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-white text-1panel shadow-sm ring-1 ring-blue-100">
                      <Icon name="carbon:application" class="h-4 w-4" />
                    </span>
                    <span class="whitespace-nowrap text-base font-bold text-[#0b3a63] sm:text-lg">应用层</span>
                  </div>
                  <div class="p-4 sm:p-5">
                    <div class="flex flex-wrap items-center justify-center gap-x-7 gap-y-2 text-xs font-semibold tracking-wide text-1panel sm:text-sm">
                      <span>AI 编程</span>
                      <span>AI 办公</span>
                      <span>AI 知识库</span>
                      <span>AI 工作流</span>
                    </div>
                    <div class="mt-4 flex flex-wrap items-center justify-center gap-2.5">
                      {["DeepSeek Harness", "Octop", "OpenClaw", "Hermes Agent", "MaxKB", "n8n"].map((item) => (
                        <span class="min-w-[100px] whitespace-nowrap rounded-lg border border-slate-200 bg-white px-3.5 py-2 text-center text-sm font-semibold text-gray-800 shadow-sm">
                          {item}
                        </span>
                      ))}
                      <span class="min-w-[52px] rounded-lg border border-slate-200 bg-white px-3.5 py-2 text-center text-sm font-semibold text-gray-800 shadow-sm">...</span>
                    </div>
                    <span class="mt-3 block rounded-lg border border-blue-100 bg-blue-50/80 px-4 py-2 text-center text-sm font-bold text-[#0b3a63] sm:text-base">应用商店</span>
                  </div>
                </a>

                <a href="#governance-layer" class="group grid grid-cols-1 overflow-hidden rounded-xl border border-slate-200/80 bg-white transition-all duration-300 hover:-translate-y-0.5 hover:border-blue-200 hover:shadow-lg hover:shadow-blue-100/60 sm:grid-cols-[184px_minmax(0,1fr)]">
                  <div class="flex items-center justify-center gap-2.5 border-b border-blue-100/70 bg-gradient-to-r from-blue-50 to-blue-50/30 px-4 py-4 sm:justify-start sm:border-b-0 sm:border-r">
                    <span class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-white text-1panel shadow-sm ring-1 ring-blue-100">
                      <Icon name="carbon:security" class="h-4 w-4" />
                    </span>
                    <span class="whitespace-nowrap text-base font-bold text-[#0b3a63] sm:text-lg">治理层</span>
                  </div>
                  <div class="space-y-2.5 p-4 sm:p-5">
                    <div class="grid grid-cols-1 gap-2.5 sm:grid-cols-3">
                      {["AI 门户", "Skills 仓库", "MCP 市场"].map((item) => (
                        <span class="rounded-lg border border-slate-200 bg-white px-4 py-2 text-center text-sm font-semibold text-gray-800 shadow-sm">
                          {item}
                        </span>
                      ))}
                    </div>
                    <span class="block rounded-lg border border-blue-100 bg-blue-50/80 px-4 py-2 text-center text-sm font-bold text-[#0b3a63] sm:text-base">AI 网关</span>
                  </div>
                </a>

                <a href="#model-layer" class="group grid grid-cols-1 overflow-hidden rounded-xl border border-slate-200/80 bg-white transition-all duration-300 hover:-translate-y-0.5 hover:border-blue-200 hover:shadow-lg hover:shadow-blue-100/60 sm:grid-cols-[184px_minmax(0,1fr)]">
                  <div class="flex items-center justify-center gap-2.5 border-b border-blue-100/70 bg-gradient-to-r from-blue-50 to-blue-50/30 px-4 py-4 sm:justify-start sm:border-b-0 sm:border-r">
                    <span class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-white text-1panel shadow-sm ring-1 ring-blue-100">
                      <Icon name="carbon:machine-learning-model" class="h-4 w-4" />
                    </span>
                    <span class="whitespace-nowrap text-base font-bold text-[#0b3a63] sm:text-lg">模型层</span>
                  </div>
                  <div class="space-y-3 p-4 sm:p-5">
                    <div class="flex flex-wrap items-center justify-center gap-x-6 gap-y-3 sm:gap-x-10">
                      <span class="inline-flex items-center gap-2 text-xl font-bold text-[#5268f2] sm:text-2xl">
                        <img src="/images/enterprise-qwen.svg" alt="Qwen" class="h-8 w-8 object-contain sm:h-9 sm:w-9" loading="eager" />
                        Qwen
                      </span>
                      <img src="/images/enterprise-deepseek.png" alt="deepseek" class="h-8 w-auto max-w-[130px] object-contain sm:h-9 sm:max-w-[170px]" loading="eager" />
                      <span class="inline-flex items-center gap-2 text-xl font-bold text-[#3859ff] sm:text-2xl">
                        <img src="/images/enterprise-zhipu.svg" alt="智谱 GLM" class="h-8 w-8 object-contain sm:h-9 sm:w-9" loading="eager" />
                        GLM
                      </span>
                    </div>
                    <span class="block rounded-lg border border-blue-100 bg-blue-50/80 px-4 py-2 text-center text-sm font-bold text-[#0b3a63] sm:text-base">模型管理</span>
                    <div class="grid grid-cols-1 gap-2.5 sm:grid-cols-3">
                      {["NVIDIA", "华为昇腾", "Intel"].map((item) => (
                        <span class="rounded-lg border border-slate-200 bg-white px-4 py-2 text-center text-sm font-semibold text-gray-800 shadow-sm">
                          {item}
                        </span>
                      ))}
                    </div>
                  </div>
                </a>

                <a href="#infrastructure-layer" class="group grid grid-cols-1 overflow-hidden rounded-xl border border-slate-200/80 bg-white transition-all duration-300 hover:-translate-y-0.5 hover:border-blue-200 hover:shadow-lg hover:shadow-blue-100/60 sm:grid-cols-[184px_minmax(0,1fr)]">
                  <div class="flex items-center justify-center gap-2.5 border-b border-blue-100/70 bg-gradient-to-r from-blue-50 to-blue-50/30 px-4 py-4 sm:justify-start sm:border-b-0 sm:border-r">
                    <span class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-white text-1panel shadow-sm ring-1 ring-blue-100">
                      <Icon name="carbon:virtual-machine" class="h-4 w-4" />
                    </span>
                    <span class="whitespace-nowrap text-base font-bold text-[#0b3a63] sm:text-lg">基础设施层</span>
                  </div>
                  <div class="space-y-2.5 p-4 sm:p-5">
                    <span class="block rounded-lg border border-blue-100 bg-blue-50/80 px-4 py-2 text-center text-sm font-bold text-[#0b3a63] sm:text-base">虚拟机管理</span>
                    <div class="grid grid-cols-2 gap-2.5 sm:grid-cols-4">
                      {["虚拟机", "镜像与模板", "网络", "存储池"].map((item) => (
                        <span class="rounded-lg border border-slate-200 bg-white px-3 py-2 text-center text-sm font-semibold text-gray-800 shadow-sm">
                          {item}
                        </span>
                      ))}
                    </div>
                  </div>
                </a>
            </div>
          </div>
        </div>
      </section>

      <!-- 界面速览 -->
      <section id="screenshots" class="border-t border-gray-100 bg-gradient-to-b from-blue-50/60 to-white py-16 lg:py-24">
        <div class="container-custom">
