---
// Language Modal section for 1Panel website
import { Icon } from 'astro-icon/components';
---
<!-- Language Detection Modal -->
<div id="language-modal" class="fixed inset-0 bg-black bg-opacity-50 z-50 hidden items-center justify-center p-4">
    <div role="dialog" aria-modal="true" aria-labelledby="language-modal-title" aria-describedby="language-modal-description" class="bg-white rounded-lg shadow-xl max-w-md w-full mx-4 transform transition-all">
      <div class="p-6">
        <div class="flex items-center mb-4">
          <div class="flex-shrink-0">
            <Icon name="carbon:earth-filled" class="w-6 h-6 text-1panel" />
          </div>
          <div class="ml-2">
            <h3 id="language-modal-title" class="text-lg font-medium text-gray-900">Language Detection</h3>
          </div>
        </div>
        <div class="mb-6">
          <p id="language-modal-description" class="text-sm text-gray-600">
            Your browser language is not Chinese. Would you like to switch to our English site for a better experience?
          </p>
        </div>
        <div class="flex justify-end space-x-3">
          <button id="stay-here" type="button" class="px-4 py-2 text-sm font-medium text-gray-700 bg-gray-100 border border-gray-300 rounded-md hover:bg-gray-200 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-500 transition-colors">
            Stay Here
          </button>
          <button id="go-english" type="button" class="px-4 py-2 text-sm font-medium text-white bg-1panel border border-transparent rounded-md hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors">
            Go to English Site
          </button>
        </div>
      </div>
    </div>
</div>
<script is:inline>
// The modal markup is already parsed. Do not wait for unrelated module downloads.
(function() {
    // 检查是否已经显示过弹框
    let hasShownModal = false;
    try {
      hasShownModal = Boolean(sessionStorage.getItem('languageModalShown'));
    } catch {
      // Language selection must still work when storage is unavailable.
    }
    if (hasShownModal) {
    return;
    }

    // 获取浏览器语言
    const browserLanguage = navigator.language;
    const isChinese = browserLanguage.startsWith('zh');

    // 如果不是中文，显示弹框
    if (!isChinese) {
    const modal = document.getElementById('language-modal');
    const stayButton = document.getElementById('stay-here');
    const goButton = document.getElementById('go-english');

    if (modal && stayButton && goButton) {
        const previousFocus = document.activeElement;
        const modalContent = modal.querySelector('.bg-white');
        let closing = false;

        // 显示弹框
        modal.classList.remove('hidden');
        modal.classList.add('flex');

        // 添加淡入动画
        const openingTimer = setTimeout(() => {
        if (modalContent) {
            modalContent.classList.add('scale-100');
            modalContent.classList.remove('scale-95');
        }
        }, 10);

        // 标记已显示
        try {
          sessionStorage.setItem('languageModalShown', 'true');
        } catch {
          // Browsers can block session storage in private or restricted contexts.
        }

        // 点击"留在这里"按钮
        stayButton.addEventListener('click', function() {
        hideModal();
        });

        // 点击"前往英文网站"按钮
        goButton.addEventListener('click', function() {
        if (!closing) window.location.href = 'https://1panel.pro';
        });

        // 点击背景关闭弹框
        modal.addEventListener('click', function(e) {
        if (e.target === modal) {
            hideModal();
        }
        });

        // 键盘操作只作用于弹框，关闭动画期间也保持焦点在两个按钮之间。
        function handleKeydown(event) {
        if (event.key === 'Escape') {
            event.preventDefault();
            event.stopPropagation();
            hideModal();
        } else if (event.key === 'Tab') {
            event.preventDefault();
            const buttons = [stayButton, goButton];
            const currentIndex = buttons.indexOf(document.activeElement);
            const nextIndex = event.shiftKey
              ? (currentIndex <= 0 ? buttons.length - 1 : currentIndex - 1)
              : (currentIndex + 1) % buttons.length;
            buttons[nextIndex].focus({ preventScroll: true });
        }
        }
        modal.addEventListener('keydown', handleKeydown);
        stayButton.focus({ preventScroll: true });

        // 隐藏弹框函数
        function hideModal() {
        if (closing) return;
        closing = true;
        // 点击遮罩可能先让焦点落到 body，动画结束前仍需留在弹框内。
        if (!modal.contains(document.activeElement)) {
            stayButton.focus({ preventScroll: true });
        }
        clearTimeout(openingTimer);
        if (modalContent) {
            modalContent.classList.add('scale-95');
            modalContent.classList.remove('scale-100');
        }
        setTimeout(() => {
            // 如果焦点已经移到页面别处，延迟回调不能再次抢走它。
            const shouldRestoreFocus = modal.contains(document.activeElement);
            modal.classList.add('hidden');
            modal.classList.remove('flex');
            modal.removeEventListener('keydown', handleKeydown);
            if (shouldRestoreFocus && previousFocus instanceof HTMLElement && previousFocus.isConnected) {
                previousFocus.focus({ preventScroll: true });
            }
        }, 200);
        }
    }
    }
})();
</script>
