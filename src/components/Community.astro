---
// Community section for 1Panel website
import { getImage } from "astro:assets";
// Original: https://www.lxware.cn/1panel-contributors/static/image/contributors.590ce064.png
import contributors from "../assets/contributors.png";

const imageWidths = [480, 960, 1440, 2272];
const imageSizes = "(min-width: 1280px) 1216px, (min-width: 1024px) calc(100vw - 64px), (min-width: 640px) calc(100vw - 48px), calc(100vw - 32px)";
const [avif, webp] = await Promise.all([
  getImage({ src: contributors, width: 2272, widths: imageWidths, format: "avif", quality: 45 }),
  getImage({ src: contributors, width: 2272, widths: imageWidths, format: "webp", quality: 85 }),
]);
---

<section id="quickstart" class="section-padding bg-gray-100">
  <div class="container-custom">
    <!-- Section Header -->
    <div class="text-center mb-8 lg:mb-16">
      <h2 class="fade-in-up text-4xl lg:text-5xl font-bold text-gray-800 mb-6">
        活跃的
        <span class="text-1panel-gradient">开源社区</span>
      </h2>
      <p class="fade-in-up text-xl text-gray-600 max-w-3xl mx-auto" style="animation-delay: 0.2s;">
        众多开发者、用户和社区成员共同构建了 1Panel 的繁荣生态。
      </p>
    </div>
    <div class="hidden lg:block shadow-lg rounded-lg overflow-hidden">
      <a href="https://www.lxware.cn/1panel-contributors#/all" target="_blank">
        <picture>
          <!-- Match the desktop-only container so mobile does not request any image format. -->
          <source media="(min-width: 1024px)" type="image/avif" srcset={avif.srcSet.attribute} sizes={imageSizes} />
          <source media="(min-width: 1024px)" type="image/webp" srcset={webp.srcSet.attribute} sizes={imageSizes} />
          <source media="(min-width: 1024px)" type="image/png" srcset={contributors.src} />
          <img
            src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7"
            alt="Contributors"
            width={contributors.width}
            height={contributors.height}
            loading="lazy"
            decoding="async"
          />
        </picture>
      </a>
    </div>
    <div class="text-center lg:mt-8">
      <a 
        href="https://www.lxware.cn/1panel-contributors#/" 
        target="_blank" 
        class="inline-flex items-center px-6 py-3 bg-white border border-gray-300 text-gray-700 rounded-lg font-medium transition-all duration-300 hover:border-gray-400 hover:bg-gray-50 shadow-sm hover:shadow-md group"
      >
        <span>获取贡献者证书</span>
        <svg class="w-4 h-4 ml-2 group-hover:translate-x-1 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
        </svg>
      </a>
      <a 
        href="https://www.lxware.cn/1panel-contributors#/all" 
        target="_blank" 
        class="inline-flex items-center px-6 py-3 bg-white border border-gray-300 text-gray-700 rounded-lg font-medium transition-all duration-300 hover:border-gray-400 hover:bg-gray-50 shadow-sm hover:shadow-md group"
      >
        <span>查看全部贡献者</span>
        <svg class="w-4 h-4 ml-2 group-hover:translate-x-1 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
        </svg>
      </a>
    </div>
  </div>
</section>
