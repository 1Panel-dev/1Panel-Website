---
// AppStore section for 1Panel website
// 获取应用商店数据并实现分类切换功能
import AppStoreCard, { type AppCardData } from './AppStoreCard.astro';

interface App {
  id: string;
  name: string;
  title?: string;
  description?: string;
  icon?: string;
  downloads?: number;
  tags?: string[];
  additionalProperties?: {
    enterprise?: boolean;
    recommend?: number;
  };
}

interface SoftwareItem {
  id: string;
  apps?: App[];
  additionalProperties?: {
    tags?: Category[];
  };
}

interface Category {
  key: string;
  name: string;
  apps: App[];
  totalApps: number;
}

let allApps: App[] = [];
let categories: Category[] = [];
let defaultCategory: Category = { key: 'all', name: '全部应用', apps: [], totalApps: 0 };
const kimiReferencePattern = /(?:kimi|moonshot)(?:[-\s]?[a-z0-9.]+)?(?:[、,，]\s*)?/gi;
const danglingModelDescriptionPattern = /^(?:支持|兼容|调用|使用|接入)\s*等(?:多种)?模型(?:[。；;])?$/;

function hasKimiReference(value?: string): boolean {
  return /kimi|moonshot/i.test(value || '');
}

function removeKimiReference(value?: string): string | undefined {
  const sanitized = value
    ?.replace(kimiReferencePattern, '')
    .replace(/、\s*、/g, '、')
    .replace(/,\s*,/g, ',')
    .trim();

  if (!sanitized || danglingModelDescriptionPattern.test(sanitized)) {
    return undefined;
  }

  return sanitized;
}

function sanitizeApp(app: App): App {
  return {
    ...app,
    description: removeKimiReference(app.description),
    title: removeKimiReference(app.title),
    tags: app.tags
      ?.filter(tag => !hasKimiReference(tag))
      .map(tag => removeKimiReference(tag))
      .filter((tag): tag is string => Boolean(tag)),
  };
}

try {
  const response = await fetch('https://apps-assets.fit2cloud.com/stable/1panel.json');
  const appStoreData: SoftwareItem = await response.json();

  if (appStoreData && appStoreData.apps) {
    allApps = appStoreData.apps
      .filter(app =>
        app.additionalProperties?.recommend !== undefined &&
        ![app.id, app.name, app.title, app.icon].some(hasKimiReference)
      )
      .map(sanitizeApp)
      .sort((a, b) => (a.additionalProperties?.recommend || 10000) - (b.additionalProperties?.recommend || 10000));
    
    // 提取所有分类
    categories = (appStoreData.additionalProperties?.tags || [])
      .filter(category => !hasKimiReference(category.name));
    
    allApps.forEach(app => {
      if (app.tags && app.tags.length > 0) {
        app.tags.forEach(tag => {
          // 在 categories 对应 tag 的对象的 totalApps 值加一
          const category = categories.find(c => c.name === tag);
          if (category) {
            category.apps = category.apps || [];
            category.totalApps = (category.totalApps || 0) + 1;
            category.apps.push(app);
          }
        });
      }
    });
    
    // 创建分类列表，每个分类最多9个应用

    // 添加"全部应用"分类
    defaultCategory.apps = allApps.slice(0, 9);
    defaultCategory.totalApps = allApps.length;
    categories.unshift(defaultCategory);
    categories.pop();
  }
} catch (error) {
  console.error('Failed to fetch app store data:', error);
}

// 获取应用图标的函数
function getAppIcon(app: App): string {
  return app.icon || './images/default-app-icon.png';
}

function getCardData(app: App): AppCardData {
  return {
    name: app.name,
    description: app.description || app.title || '',
    icon: getAppIcon(app),
    tags: app.tags?.slice(0, 2) || [],
    enterprise: Boolean(app.additionalProperties?.enterprise),
  };
}

// Keep the default cards in HTML; share each remaining application's data across categories.
const appIndexes = new Map<App, number>();
const catalogApps: AppCardData[] = [];
const catalogCategories = categories.map(category => ({
  name: category.name,
  totalApps: category.totalApps,
  apps: category.apps.map(app => {
    if (!appIndexes.has(app)) {
      appIndexes.set(app, catalogApps.length);
      catalogApps.push(getCardData(app));
    }
    return appIndexes.get(app)!;
  }),
}));
const catalogJson = JSON.stringify({ apps: catalogApps, categories: catalogCategories })
  .replace(/</g, '\\u003c');
---

<section id="appstore" class="section-padding bg-gray-100">
  <div class="container-custom">
    <!-- Section Header -->
    <div class="text-center mb-16">
      <h2 class="fade-in-up text-4xl lg:text-5xl font-bold text-gray-800 mb-6">
        丰富的
        <span class="text-1panel-gradient">应用商店</span>
      </h2>
      <p class="fade-in-up text-xl text-gray-600 max-w-3xl mx-auto mb-8" style="animation-delay: 0.2s;">
        精选优质开源应用，一键安装部署，满足各种业务需求
      </p>
      
      <!-- Category Tabs -->
      {categories.length > 1 && (
        <div class="fade-in-up flex flex-wrap justify-center gap-2 mb-8" style="animation-delay: 0.4s;">
          {categories.map((category: Category, index: number) => (
            <button 
              type="button"
              class={`category-tab px-6 py-3 rounded-xl font-medium transition-all duration-300 ${
                index === 0 ? 'active' : ''
              }`}
              data-category={category.name}
              data-category-index={index}
              aria-pressed={index === 0 ? 'true' : 'false'}
            >
              {category.name}
              <span class="ml-2 text-xs">({category.totalApps})</span>
            </button>
          ))}
        </div>
      )}
    </div>

    <!-- Apps Container -->
    <div id="apps-container">
      {categories.slice(0, 1).map((category: Category) => (
        <div 
          class="category-content active"
          data-category={category.name}
        >
          <!-- Apps Grid -->
          <div id="app-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            {category.apps.map((app: App, index: number) => (
              <AppStoreCard app={getCardData(app)} index={index} />
            ))}
          </div>
          <!-- Category Stats and View All Button -->
          <div class="text-center mt-8">
            <p id="app-category-summary" class="text-sm text-gray-600 mb-4">
              {category.name} • 共 {category.totalApps} 个应用
            </p>
            
            <!-- View All Button -->
            <a 
              href="https://apps.fit2cloud.com/1panel" 
              target="_blank" 
              class="inline-flex items-center px-6 py-3 bg-white border border-gray-300 text-gray-700 rounded-lg font-medium transition-all duration-300 hover:border-gray-400 hover:bg-gray-50 shadow-sm hover:shadow-md group"
            >
              <span>查看全部应用</span>
              <svg class="w-4 h-4 ml-2 group-hover:translate-x-1 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
              </svg>
            </a>
          </div>
        </div>
      ))}
    </div>

    {categories.length > 1 && (
      <>
        <template id="app-card-template"><AppStoreCard /></template>
        <script id="app-catalog-data" type="application/json" is:inline set:html={catalogJson} />
      </>
    )}

    <!-- No Apps Message -->
    {categories.length === 0 && (
      <div class="text-center py-16">
        <div class="w-24 h-24 bg-gray-200 rounded-full flex items-center justify-center mx-auto mb-6">
          <svg class="w-12 h-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path>
          </svg>
        </div>
        <h3 class="text-xl font-semibold text-gray-800 mb-2">暂无应用数据</h3>
        <p class="text-gray-500">应用商店数据加载中，请稍后再试</p>
      </div>
    )}
  </div>
</section>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  
  .category-tab {
    background: rgba(229, 231, 235, 0.8);
    color: #4b5563;
    border: 1px solid rgba(209, 213, 219, 0.5);
  }
  
  .category-tab:hover {
    background: rgba(0, 94, 235, 0.1);
    color: #0055d4;
    border-color: rgba(0, 94, 235, 0.3);
    transform: translateY(-2px);
  }
  
  .category-tab.active {
    background: linear-gradient(135deg, #005eeb 0%, #0066ff 100%);
    color: white;
    border-color: #005eeb;
    transform: translateY(-2px);
    box-shadow: 0 10px 25px -3px rgba(0, 94, 235, 0.3);
  }
  
  .category-content {
    transition: all 0.3s ease-in-out;
  }
  
  .category-content.hidden {
    display: none;
  }
  
  .category-content.active {
    display: block;
    animation: fadeInUp 0.5s ease-out;
  }
  
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>

<script>
  import type { AppCardData } from './AppStoreCard.astro';

  interface AppCatalog {
    apps: AppCardData[];
    categories: { name: string; totalApps: number; apps: number[] }[];
  }

  // Render a category only when selected, without fetching any data in the browser.
  document.addEventListener('DOMContentLoaded', function() {
    const section = document.getElementById('appstore');
    const data = section?.querySelector<HTMLScriptElement>('#app-catalog-data');
    const template = section?.querySelector<HTMLTemplateElement>('#app-card-template');
    const grid = section?.querySelector<HTMLElement>('#app-grid');
    const panel = section?.querySelector<HTMLElement>('.category-content');
    const summary = section?.querySelector<HTMLElement>('#app-category-summary');
    if (!section || !data || !template || !grid || !panel || !summary) return;

    const catalog: AppCatalog = JSON.parse(data.textContent || '{}');
    const tabs = section.querySelectorAll<HTMLButtonElement>('.category-tab');
    let activeCategoryIndex = 0;

    function createCard(app: AppCardData, index: number): HTMLElement {
      const card = template!.content.firstElementChild!.cloneNode(true) as HTMLElement;
      const icon = card.querySelector<HTMLImageElement>('[data-app-icon]')!;
      icon.src = app.icon;
      icon.alt = app.name;
      card.querySelector('[data-app-name]')!.textContent = app.name;
      card.querySelector('[data-app-description]')!.textContent = app.description;

      const tags = card.querySelector('[data-app-tags]')!;
      const tagTemplate = tags.firstElementChild!;
      if (app.tags.length) {
        tags.replaceChildren(...app.tags.map(tag => {
          const label = tagTemplate.cloneNode(true);
          label.textContent = tag;
          return label;
        }));
      } else {
        tags.remove();
      }
      if (!app.enterprise) card.querySelector('[data-app-enterprise]')!.remove();

      // These cards are created after Layout's initial animation observers run.
      card.classList.add('animate');
      card.style.animationDelay = `${index * 0.05}s`;
      return card;
    }

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        const categoryIndex = Number(tab.dataset.categoryIndex);
        if (categoryIndex === activeCategoryIndex) return;
        const category = catalog.categories[categoryIndex];
        if (!category) return;

        const cards = category.apps.map((appIndex, index) => createCard(catalog.apps[appIndex], index));
        grid.replaceChildren(...cards);
        panel.dataset.category = category.name;
        summary.textContent = `${category.name} • 共 ${category.totalApps} 个应用`;
        tabs.forEach(item => {
          const selected = item === tab;
          item.classList.toggle('active', selected);
          item.setAttribute('aria-pressed', String(selected));
        });
        activeCategoryIndex = categoryIndex;

        if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          panel.animate?.(
            [{ opacity: 0, transform: 'translateY(20px)' }, { opacity: 1, transform: 'translateY(0)' }],
            { duration: 500, easing: 'ease-out' },
          );
        }
      });
    });
  });
</script>
