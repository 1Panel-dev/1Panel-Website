          <li>
            <a href="https://openclaw.club/" target="_blank" rel="noopener noreferrer" class="group flex items-center text-gray-400 hover:text-white transition-colors duration-300">
              <Icon name="carbon:star" class="mr-2 h-3.5 w-3.5 flex-shrink-0" />
              <span>OpenClaw 俱乐部</span>
            </a>
          </li>
          <li>
            <a href="http://awesome.1panel.cn/" target="_blank" rel="noopener noreferrer" class="group flex items-center text-gray-400 hover:text-white transition-colors duration-300">
              <Icon name="carbon:bookmark" class="mr-2 h-3.5 w-3.5 flex-shrink-0" />
              <span>1Panel 玩机指南</span>
