---
import ContactUs from "./ContactUs.astro";
// Footer component for 1Panel website
---

<div class="site-footer-cta relative isolate overflow-hidden border-t border-blue-100/80">
  <div aria-hidden="true" class="site-footer-cta-glow pointer-events-none absolute inset-0"></div>
  <div class="relative z-10">
    <ContactUs />

    <section class="relative py-16 lg:py-20">
      <div class="container-custom">
        <div class="mx-auto max-w-2xl text-center">
          <h2 class="text-2xl font-bold tracking-normal text-gray-950 lg:text-3xl">申请成为合作伙伴</h2>
          <p class="mt-4 text-base leading-relaxed text-gray-500">1Panel 合作伙伴积极招募中，携手并进、开创未来。</p>
          <div class="mt-8">
            <a
              href="https://jsj.top/f/vKGHRP"
              target="_blank"
              class="inline-flex items-center rounded-lg bg-[#005eeb] px-8 py-3 text-base font-medium text-white shadow-lg shadow-blue-900/10 transition-all duration-300 hover:bg-[#0050cd] hover:shadow-xl hover:shadow-blue-900/15"
            >
              立即申请
            </a>
          </div>
        </div>
      </div>
    </section>
  </div>
</div>

<footer class="bg-dark-900 border-t border-gray-800 py-12">
  <div class="container-custom">
    <!-- Main Footer Content -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-8 mb-8">
      <!-- Company Info -->
      <div class="col-span-1 lg:col-span-2">
        <div class="flex items-center space-x-3 mb-4">
          <span class="text-xl font-bold text-white">FIT2CLOUD 飞致云</span>
        </div>
        <p class="text-gray-400 mb-6 max-w-md">
          我们秉持“软件用起来才有价值，才有改进的机会”的核心价值观，向中国数字化团队交付被广泛验证、可信赖的开源软件。
        </p>
      </div>

      <!-- Resources -->
      <div>
        <h4 class="text-lg font-semibold text-white mb-4">常用链接</h4>
        <ul class="space-y-3">
          <li><a href="https://apps.fit2cloud.com/1panel" target="_blank" rel="noopener noreferrer" class="text-gray-400 hover:text-white transition-colors duration-300">应用商店</a></li>
          <li><a href="https://1panel.cn/docs" target="_blank" rel="noopener noreferrer" class="text-gray-400 hover:text-white transition-colors duration-300">使用文档</a></li>
          <li><a href="/blog.html" class="text-gray-400 hover:text-white transition-colors duration-300">产品动态</a></li>
          <li><a href="https://bbs.fit2cloud.com/c/1p/" target="_blank" rel="noopener noreferrer" class="text-gray-400 hover:text-white transition-colors duration-300">社区论坛</a></li>
          <li><a href="https://edu.fit2cloud.com/" target="_blank" rel="noopener noreferrer" class="text-gray-400 hover:text-white transition-colors duration-300">培训认证</a></li>
          <li><a href="https://github.com/1Panel-dev/1Panel" target="_blank" rel="noopener noreferrer" class="text-gray-400 hover:text-white transition-colors duration-300">GitHub 仓库</a></li>
          <li><a href="https://1panel.pro" target="_blank" rel="noopener noreferrer" class="text-gray-400 hover:text-white transition-colors duration-300">English Site</a></li>
        </ul>
      </div>
      <div>
        <h4 class="text-lg font-semibold text-white mb-4">产品对比</h4>
        <ul class="space-y-3">
          <li><a href="/vsbt.html" class="text-gray-400 hover:text-white transition-colors duration-300">1Panel 对比 传统面板</a></li>
          <li><a href="/vscpanel.html" class="text-gray-400 hover:text-white transition-colors duration-300">1Panel 对比 cPanel</a></li>
          <li><a href="/vswebmin.html" class="text-gray-400 hover:text-white transition-colors duration-300">1Panel 对比 Webmin</a></li>
          <li><a href="/1panel-ai-gateway-vs-newapi.html" class="text-gray-400 hover:text-white transition-colors duration-300">1Panel AI 网关 对比 New API</a></li>
          <li><a href="/1panel-ai-gateway-vs-litellm.html" class="text-gray-400 hover:text-white transition-colors duration-300">1Panel AI 网关 对比 LiteLLM</a></li>
        </ul>
      </div>
      <!-- Quick Links -->
      <div>
        <h4 class="text-lg font-semibold text-white mb-4">友情链接</h4>
        <ul class="space-y-3">
          <li><a href="https://openclaw.club/" target="_blank" rel="noopener noreferrer" class="text-gray-400 hover:text-white transition-colors duration-300">OpenClaw 俱乐部</a></li>
          <li><a href="http://awesome.1panel.cn/" target="_blank" rel="noopener noreferrer" class="text-gray-400 hover:text-white transition-colors duration-300">1Panel 玩机指南</a></li>
          <li><a href="https://jumpserver.com/" target="_blank" rel="noopener noreferrer" class="text-gray-400 hover:text-white transition-colors duration-300">JumpServer 开源堡垒机</a></li>
          <li><a href="https://fit2cloud.com/zabbix/index.html" target="_blank" rel="noopener noreferrer" class="text-gray-400 hover:text-white transition-colors duration-300">Zabbix 信创一体机</a></li>
          <li><a href="https://www.maxkb.cn/" target="_blank" rel="noopener noreferrer" class="text-gray-400 hover:text-white transition-colors duration-300">MaxKB 开源企业级智能体平台</a></li>
          <li><a href="https://dataease.cn/" target="_blank" rel="noopener noreferrer" class="text-gray-400 hover:text-white transition-colors duration-300">DataEase 开源 BI 工具</a></li>
          <li><a href="https://kubepi.org/" target="_blank" rel="noopener noreferrer" class="text-gray-400 hover:text-white transition-colors duration-300">KubePi 官网</a></li>
          <li><a href="https://fit2cloud.com/about/index.html" target="_blank" rel="noopener noreferrer" class="text-gray-400 hover:text-white transition-colors duration-300">关于飞致云</a></li>
        </ul>
      </div>
    </div>

    <!-- Copyright -->
    <div class="border-t border-gray-800 pt-8">
      <div class="flex flex-col md:flex-row justify-between items-center">
        <div class="text-gray-400 text-sm mb-4 md:mb-0">
          © <span id="footer-year"></span> FIT2CLOUD 飞致云. 保留所有权利.
        </div>
        <script is:inline>
          document.addEventListener('DOMContentLoaded', function() {
            const yearSpan = document.getElementById('footer-year');
            if (yearSpan) {
              yearSpan.textContent = new Date().getFullYear();
            }
          });
        </script>
        <div class="flex space-x-6 text-sm">
          <a href="https://www.fit2cloud.com/legal/privacy-policy.html" target="_blank" rel="noopener noreferrer" class="text-gray-400 hover:text-white transition-colors duration-300">隐私政策</a>
          <a href="https://www.fit2cloud.com/legal/licenses.html" target="_blank" rel="noopener noreferrer" class="text-gray-400 hover:text-white transition-colors duration-300">许可协议</a>
        </div>
      </div>
      
      <!-- ICP备案号和声明 -->
      <div class="mt-6 pt-6 border-t border-gray-800">
        <div class="flex flex-col items-center text-center">
          <div class="text-gray-400 text-sm mb-2">
            <a href="https://beian.miit.gov.cn/" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors duration-300">
              浙ICP备14038283号-5
            </a>
          </div>
          <div class="text-gray-500 text-base leading-relaxed">
            违法网站请勿向我司工作人员发起任何形式的人工服务请求，严禁使用 1Panel 面板从事任何非法活动
          </div>
        </div>
      </div>
    </div>

    <!-- Back to Top Button -->
    <button id="back-to-top" class="fixed bottom-8 right-8 bg-gradient-to-r from-blue-600 to-purple-600 text-white p-3 rounded-full shadow-lg hover:shadow-xl transition-all duration-300 transform hover:scale-110 opacity-0 invisible">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18"></path>
      </svg>
    </button>
  </div>
</footer>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Back to top button functionality
    const backToTopBtn = document.getElementById('back-to-top');
    
    if (backToTopBtn) {
      // Show/hide button based on scroll position
      window.addEventListener('scroll', () => {
        if (window.pageYOffset > 300) {
          backToTopBtn.classList.remove('opacity-0', 'invisible');
          backToTopBtn.classList.add('opacity-100', 'visible');
        } else {
          backToTopBtn.classList.add('opacity-0', 'invisible');
          backToTopBtn.classList.remove('opacity-100', 'visible');
        }
      });

      // Smooth scroll to top
      backToTopBtn.addEventListener('click', () => {
        window.scrollTo({
          top: 0,
          behavior: 'smooth'
        });
      });
    }
  });
</script>

<style>
  .site-footer-cta {
    background: linear-gradient(180deg, #ffffff 0%, #f8fbff 48%, #eef5ff 100%);
  }

  .site-footer-cta-glow {
    background:
      radial-gradient(circle at 10% 28%, rgb(191 219 254 / 0.32), transparent 24rem),
      radial-gradient(circle at 88% 72%, rgb(219 234 254 / 0.64), transparent 28rem);
  }
</style>
