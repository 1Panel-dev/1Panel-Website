            </a>
          </li>
          <li>
            <a href="/vswebmin.html" class="group flex items-center text-gray-400 hover:text-white transition-colors duration-300">
              <Icon name="carbon:compare" class="mr-2 h-3.5 w-3.5 flex-shrink-0" />
