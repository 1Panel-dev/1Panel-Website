        <h4 class="text-lg font-semibold text-white mb-4">产品信息</h4>
        <ul class="space-y-3">
          <li>
            <a href="index.html" target="_blank" rel="noopener noreferrer" class="group flex items-center text-gray-400 hover:text-white transition-colors duration-300">
              <Icon name="carbon:document" class="mr-2 h-3.5 w-3.5 flex-shrink-0" />
              <span>1Panel 官网首页</span>
            </a>
          </li>
          <li>
            <a href="https://apps.fit2cloud.com/1panel" target="_blank" rel="noopener noreferrer" class="group flex items-center text-gray-400 hover:text-white transition-colors duration-300">
              <Icon name="carbon:document" class="mr-2 h-3.5 w-3.5 flex-shrink-0" />
              <span>1Panel 应用商店</span>
            </a>
          </li>           
          <li>
            <a href="https://www.lxware.cn/1panel" target="_blank" rel="noopener noreferrer" class="group flex items-center text-gray-400 hover:text-white transition-colors duration-300">
              <Icon name="carbon:document" class="mr-2 h-3.5 w-3.5 flex-shrink-0" />
              <span>1Panel 专业版</span>
            </a>
          </li>
          <li>
            <a href="enterprise.html" target="_blank" rel="noopener noreferrer" class="group flex items-center text-gray-400 hover:text-white transition-colors duration-300">
              <Icon name="carbon:document" class="mr-2 h-3.5 w-3.5 flex-shrink-0" />
              <span>1Panel 企业版</span>
            </a>
          </li>          
          <li>
            <a href="ai-gateway.html" target="_blank" rel="noopener noreferrer" class="group flex items-center text-gray-400 hover:text-white transition-colors duration-300">
              <Icon name="carbon:document" class="mr-2 h-3.5 w-3.5 flex-shrink-0" />
              <span>1Panel AI 网关</span>
              <span class="ml-1.5 inline-flex items-center rounded-full bg-gradient-to-r from-orange-500 to-amber-500 px-1.5 py-[3px] text-[9px] font-extrabold uppercase tracking-wider leading-none text-white shadow-sm">HOT</span>
