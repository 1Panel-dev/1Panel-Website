---
import { Icon } from "astro-icon/components";

export interface Props {
  partner: string;
  hardware: string;
  hardwareDetail: string;
}

const {
  partner,
  hardware,
  hardwareDetail,
} = Astro.props;

const strengths = [
  {
    title: "安全",
    description: "纯内网运行，确保数据不出域，杜绝代码外泄风险。",
    icon: "carbon:security",
    tone: "text-emerald-600",
    iconBg: "bg-emerald-50",
    border: "hover:border-emerald-100",
  },
  {
    title: "高效",
    description: "专为 10-20 人技术团队打造，以 Token 自主权驱动开发效能，释放创新潜力。",
    icon: "carbon:flash",
    tone: "text-blue-600",
    iconBg: "bg-blue-50",
    border: "hover:border-blue-100",
  },
  {
    title: "省心",
    description: "开箱即用，图形化界面，非技术成员也能高效运维。",
    icon: "carbon:user-follow",
    tone: "text-amber-600",
    iconBg: "bg-amber-50",
    border: "hover:border-amber-100",
  },
];

const securityPoints = [
  "100% 纯内网私有化部署；",
  "核心数据与代码不出域；",
  "符合企业级安全审计标准。",
];

const operationPoints = [
  "开箱即用，分钟级部署；",
  "全图形化界面，易于管理；",
  "彻底告别 Token 焦虑。",
];

const architectureTiles = [
  "AI代理",
  "模型部署",
  "开发工具",
  "资源监控",
  "席位管理",
  "模型维护",
  "DevOps工具",
  "快速建站",
  "用量统计",
  "模型性能测试",
  "环境运行时",
  "WAF和备份",
];

const architectureModules = ["AI网关", "模型管理", "开发者商店", "运维管理"];
const hardwareBadges = ["Intel Arc Pro B70", "NVIDIA RTX Pro 5000"];

const benchmarkHighlights = [
  { label: "Terminal Bench 2.1", value: "73.0" },
  { label: "SWE-bench Pro", value: "61.7" },
  { label: "DeepSWE 1.1", value: "42.2" },
  { label: "QwenSWEBench", value: "79.0" },
];

const benchmarkRows = [
  {
    metric: "Agentic terminal coding",
    subtitle: "Terminal Bench 2.1 (Terminus)",
    qwen38: "73.0",
    qwen36: "63.4",
    qwen37Plus: "64.0",
    opus: "78.2",
  },
  {
    metric: "Agentic coding",
    subtitle: "SWE-bench Pro",
    qwen38: "61.7",
    qwen36: "53.5",
    qwen37Plus: "57.6",
    opus: "53.4",
  },
  {
    metric: "Repo-level code generation",
    subtitle: "NL2Repo-Bench",
    qwen38: "42.3",
    qwen36: "36.2",
    qwen37Plus: "41.1",
    opus: "47.6",
  },
  {
    metric: "Agentic coding",
    subtitle: "DeepSWE 1.1",
    qwen38: "42.2",
    qwen36: "13.3",
    qwen37Plus: "14.2",
    opus: "--",
  },
  {
    metric: "Software engineering",
    subtitle: "QwenSWEBench",
    qwen38: "79.0",
    qwen36: "49.3",
    qwen37Plus: "59.2",
    opus: "63.8",
  },
];
---

<main class="relative z-10 bg-white text-gray-800">
  <section class="relative overflow-hidden bg-gradient-to-b from-blue-50/80 via-white to-white pt-24 pb-14 lg:pt-28 lg:pb-16">
    <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-blue-200 to-transparent"></div>
    <div class="relative z-10 container-custom">
      <div class="max-w-4xl mx-auto text-center">
        <div class="fade-in-up inline-flex items-center px-4 py-2 mb-6 rounded-full border border-blue-100 bg-white text-blue-800 shadow-sm text-sm font-semibold">
          Qwen3.8-27B 私有化部署首选
        </div>
        <h1 class="fade-in-up text-4xl md:text-5xl lg:text-6xl font-bold leading-tight tracking-normal mb-8" style="animation-delay: 0.2s;">
          <span class="block text-gray-950 mb-4">1Panel AI 编程一体机</span>
        </h1>
        <p class="fade-in-up text-xl sm:text-2xl text-gray-600 mb-10 leading-relaxed" style="animation-delay: 0.4s;">
          轻松满足 10-20 人的内网 AI 编程需求，彻底告别 Token 焦虑！
        </p>
        <div class="fade-in-up flex flex-col sm:flex-row gap-4 justify-center" style="animation-delay: 0.5s;">
          <a href="#contact" class="btn-primary text-lg px-8 py-4 inline-flex items-center justify-center">
            微信扫码咨询
            <Icon name="carbon:arrow-down" class="ml-2 h-5 w-5" />
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="section-padding bg-white border-t border-gray-100">
    <div class="container-custom">
      <div class="text-center mb-12">
        <h2 class="section-title text-4xl lg:text-5xl font-bold text-gray-800 mb-6">
          内网环境下的<span class="text-1panel-gradient">编程效率革命者</span>
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8">
        {
          strengths.map((item, index) => (
            <article class={`fade-in-up rounded-lg bg-white border border-gray-100 p-6 lg:p-8 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-xl ${item.border} flex flex-col`} style={`animation-delay: ${index * 0.05}s;`}>
              <div class="flex items-center gap-3 mb-4">
                <span aria-hidden="true" class={`flex-shrink-0 w-11 h-11 rounded-lg ${item.iconBg} ${item.tone} flex items-center justify-center`}>
                  <Icon name={item.icon} class="h-5 w-5" />
                </span>
                <h3 class="text-lg font-bold text-gray-900">{item.title}</h3>
              </div>
              <p class="text-gray-600 leading-relaxed flex-1">{item.description}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section-padding bg-gradient-to-b from-gray-50 to-white">
    <div class="container-custom">
      <div class="text-center mb-11">
        <h2 class="text-4xl lg:text-5xl font-bold text-gray-800 mb-6">
          从算力底座到<span class="text-1panel-gradient">应用开发</span>
        </h2>
        <p class="text-xl text-gray-600 max-w-2xl mx-auto leading-relaxed">
          从算力底座、模型能力到 DevOps 工具链，一站式满足内网 AI 编程需求。
        </p>
      </div>

      <div class="overflow-hidden rounded-lg border border-blue-100 bg-white shadow-2xl shadow-blue-100/50">
        <div class="grid grid-cols-1 gap-8 p-6 sm:p-8 lg:grid-cols-[280px_minmax(0,1fr)_280px] lg:gap-0 lg:p-9">

          <div class="flex flex-col lg:pr-8">
            <div class="flex items-center gap-3 mb-6">
              <div class="w-11 h-11 rounded-lg bg-blue-50 flex items-center justify-center flex-shrink-0 text-1panel">
                <Icon name="carbon:security" class="h-5 w-5" />
              </div>
              <h3 class="text-xl font-bold text-gray-900">安全合规</h3>
            </div>
            <ul class="space-y-4">
              {securityPoints.map((point) => (
                <li class="flex items-start gap-2.5">
                  <span class="mt-0.5 flex h-5 w-5 flex-shrink-0 items-center justify-center rounded-full bg-emerald-50 text-emerald-500">
                    <Icon name="carbon:checkmark" class="h-3.5 w-3.5" />
                  </span>
                  <span class="text-gray-600 leading-relaxed">{point}</span>
                </li>
              ))}
            </ul>
          </div>

          <div class="flex flex-col items-center border-y border-gray-100 py-8 lg:border-x lg:border-y-0 lg:px-8 lg:py-0">
            <div class="w-full rounded-lg border border-gray-100 bg-gray-50/80 px-4 py-5 sm:px-6">
              <div class="grid grid-cols-4 gap-1.5 sm:gap-2 w-full mb-5">
                {architectureTiles.map((tile) => (
                  <span class="min-h-10 rounded-md border border-gray-200 bg-white px-1 py-2 text-center text-[11px] font-medium leading-snug text-gray-800 shadow-sm sm:text-xs">{tile}</span>
                ))}
              </div>

              <div class="grid grid-cols-4 gap-1.5 sm:gap-2 w-full mb-5">
                {architectureModules.map((module) => (
                  <span class="rounded-md bg-blue-50 px-1 py-3 text-center text-xs font-bold leading-snug text-1panel ring-1 ring-blue-100 sm:text-sm">{module}</span>
                ))}
              </div>

              <div class="w-full rounded-md bg-white py-3 mb-3 text-center shadow-sm ring-1 ring-gray-100">
                <span class="text-base sm:text-lg font-bold text-1panel">1Panel 企业版</span>
              </div>

              <div class="w-full py-3 px-4 mb-3 bg-emerald-50/80 rounded-md border border-emerald-100 flex items-center justify-center gap-2.5">
                <div class="w-7 h-7 rounded-md bg-white flex items-center justify-center flex-shrink-0 text-emerald-600 shadow-sm">
                  <Icon name="carbon:machine-learning-model" class="h-4 w-4" />
                </div>
                <span class="text-sm font-bold text-emerald-700">Qwen3.8-27B</span>
              </div>

              <div class="w-full py-3 px-4 bg-blue-50/70 rounded-md border border-blue-100">
                <div class="flex items-center justify-center gap-2 sm:gap-3 mb-2 flex-wrap">
                  {hardwareBadges.map((badge) => (
                    <span class="rounded-md border border-blue-200 bg-white px-3 py-1.5 text-[11px] font-medium text-blue-700 shadow-sm sm:text-xs">{badge}</span>
                  ))}
                </div>
                <p class="text-sm font-bold text-center text-blue-600">高性能算力底座</p>
              </div>
            </div>
          </div>

          <div class="flex flex-col lg:pl-8">
            <div class="flex items-center gap-3 mb-6">
              <div class="w-11 h-11 rounded-lg bg-amber-50 flex items-center justify-center flex-shrink-0 text-amber-600">
                <Icon name="carbon:flash" class="h-5 w-5" />
              </div>
              <h3 class="text-xl font-bold text-gray-900">高效运维</h3>
            </div>
            <ul class="space-y-4">
              {operationPoints.map((point) => (
                <li class="flex items-start gap-2.5">
                  <span class="mt-0.5 flex h-5 w-5 flex-shrink-0 items-center justify-center rounded-full bg-emerald-50 text-emerald-500">
                    <Icon name="carbon:checkmark" class="h-3.5 w-3.5" />
                  </span>
                  <span class="text-gray-600 leading-relaxed">{point}</span>
                </li>
              ))}
            </ul>
          </div>

        </div>

        <div class="bg-1panel-gradient py-7 text-center">
          <h2 class="text-2xl sm:text-3xl font-bold text-white tracking-wide">软硬协同 · 全栈赋能</h2>
        </div>
      </div>
    </div>
  </section>

  <section id="capability" class="pt-20 pb-8 lg:pt-32 lg:pb-10 bg-white border-t border-gray-100">
    <div class="container-custom">
      <div class="text-center mb-12">
        <h2 class="section-title text-4xl lg:text-5xl font-bold text-gray-800 mb-6">AI 编程能力</h2>
        <p class="section-subtitle text-xl text-gray-600 max-w-3xl mx-auto leading-relaxed">
          Qwen3.8-27B 在多方面领先参数量更大的Qwen3.7-Plus，接近 Claude Opus 4.6 Max 的水平。
        </p>
      </div>

      <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
        {
          benchmarkHighlights.map((item, index) => (
            <article class="fade-in-up rounded-lg border border-blue-100 bg-gradient-to-b from-white to-blue-50/40 p-5 text-center shadow-sm" style={`animation-delay: ${index * 0.04}s;`}>
              <div class="text-3xl font-bold text-1panel mb-2">{item.value}</div>
              <div class="text-sm font-medium text-gray-600">{item.label}</div>
            </article>
          ))
        }
      </div>

      <div class="rounded-lg border border-gray-100 bg-white shadow-xl shadow-gray-100/80 overflow-x-auto">
        <table class="min-w-[860px] w-full border-collapse text-left">
          <thead>
            <tr class="bg-gray-50 text-sm text-gray-500">
              <th class="px-5 py-4 font-semibold">Coding</th>
              <th class="px-5 py-4 font-semibold text-center text-1panel bg-blue-50/70">Qwen3.8-27B</th>
              <th class="px-5 py-4 font-semibold text-center">Qwen3.6-27B</th>
              <th class="px-5 py-4 font-semibold text-center">Qwen3.7-Plus</th>
              <th class="px-5 py-4 font-semibold text-center">Opus4.6 Max</th>
            </tr>
          </thead>
          <tbody>
            {
              benchmarkRows.map((row) => (
                <tr class="border-t border-gray-100 text-sm text-gray-700 transition-colors duration-200 hover:bg-gray-50/70">
                  <td class="px-5 py-4">
                    <div class="font-medium text-gray-900">{row.metric}</div>
                    <div class="text-xs text-gray-500 mt-0.5">{row.subtitle}</div>
                  </td>
                  <td class="px-5 py-4 text-center font-semibold text-gray-900 bg-blue-50/30">{row.qwen38}</td>
                  <td class={`px-5 py-4 text-center ${row.qwen36 === "--" ? "text-gray-400" : ""}`}>{row.qwen36}</td>
                  <td class={`px-5 py-4 text-center ${row.qwen37Plus === "--" ? "text-gray-400" : ""}`}>{row.qwen37Plus}</td>
                  <td class={`px-5 py-4 text-center ${row.opus === "--" ? "text-gray-400" : ""}`}>{row.opus}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section id="contact" class="pt-4 pb-20 lg:pt-6 lg:pb-32 bg-gradient-to-b from-white to-blue-50/60">
    <div class="container-custom">
      <div class="overflow-hidden rounded-lg border border-blue-100 bg-white p-8 shadow-2xl shadow-blue-100/60 flex flex-col md:flex-row gap-8 md:gap-0 md:items-center md:justify-center">
        <div class="flex flex-col items-center md:items-end md:pr-12 flex-1 md:max-w-[420px]">
          <div class="mb-5 flex items-center gap-3">
            <div class="flex h-11 w-11 items-center justify-center rounded-lg bg-blue-50 text-1panel">
              <Icon name="carbon:purchase" class="h-6 w-6" />
            </div>
            <h2 class="text-3xl lg:text-4xl font-bold text-gray-900">限时特惠价格</h2>
          </div>
          <div class="flex flex-wrap items-end justify-center md:justify-end gap-3 mb-5">
            <span class="text-5xl font-bold text-gray-900">￥17.9万</span>
            <span class="pb-2 text-lg text-gray-500">含一年软硬件维保</span>
          </div>
          <p class="text-lg text-gray-600 leading-relaxed text-center md:text-right">
            通过微信扫码咨询，获取 AI Coding 一体机的详细性能参数与采购信息。
          </p>
        </div>

        <div class="hidden md:block h-36 w-px bg-gray-200 mx-12"></div>

        <div class="flex flex-col items-center flex-1 md:max-w-[320px]">
          <img
            src="/images/wecom-qrcode.png"
            alt="微信扫码咨询"
            class="w-36 h-36 rounded-lg border border-blue-100 shadow-sm bg-white p-2 mb-3"
            loading="lazy"
          />
          <p class="text-base font-semibold text-gray-800 text-center">微信扫码获取官方评测数据</p>
        </div>
      </div>
    </div>
  </section>
</main>
