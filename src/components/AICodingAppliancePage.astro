---
import { Icon } from "astro-icon/components";

export interface Props {
  partner: string;
  hardware: string;
  hardwareDetail: string;
}

const {
  partner,
  hardware,
  hardwareDetail,
} = Astro.props;

const strengths = [
  {
    title: "安全",
    description: "纯内网运行，确保数据不出域，杜绝代码外泄风险。",
    icon: "carbon:security",
  },
  {
    title: "高效",
    description: "专为 10-20 人技术团队打造，以 Token 自主权驱动开发效能，释放创新潜力。",
    icon: "carbon:flash",
  },
  {
    title: "省心",
    description: "开箱即用，图形化界面，非技术成员也能高效运维。",
    icon: "carbon:user-follow",
  },
];


const benchmarkHighlights = [
  { label: "SWE-bench Verified", value: "77.2" },
  { label: "SWE-bench Pro", value: "53.5" },
  { label: "Terminal-Bench 2.0", value: "59.3" },
  { label: "LiveCodeBench v6", value: "83.9" },
];

const benchmarkRows = [
  {
    metric: "SWE-bench Verified",
    qwen35: "76.2",
    claude: "80.9",
    qwen36: "77.2",
  },
  {
    metric: "SWE-bench Pro",
    qwen35: "50.9",
    claude: "57.1",
    qwen36: "53.5",
  },
  {
    metric: "SWE-bench Multilingual",
    qwen35: "69.3",
    claude: "77.5",
    qwen36: "71.3",
  },
  {
    metric: "Terminal-Bench 2.0",
    qwen35: "52.5",
    claude: "59.3",
    qwen36: "59.3",
  },
  {
    metric: "SkillsBench Avg5",
    qwen35: "30.0",
    claude: "45.3",
    qwen36: "48.2",
  },
  {
    metric: "QwenWebBench",
    qwen35: "1186",
    claude: "1536",
    qwen36: "1487",
  },
  {
    metric: "NL2Repo",
    qwen35: "32.2",
    claude: "43.2",
    qwen36: "36.2",
  },
  {
    metric: "Claw-Eval Avg",
    qwen35: "70.7",
    claude: "76.6",
    qwen36: "72.4",
  },
  {
    metric: "Claw-Eval Pass^3",
    qwen35: "48.1",
    claude: "59.6",
    qwen36: "60.6",
  },
  {
    metric: "QwenClawBench",
    qwen35: "51.8",
    claude: "52.3",
    qwen36: "53.4",
  },
];
---

<main class="relative z-10">
  <section class="relative overflow-hidden bg-gray-50 min-h-[40vh] flex items-center">
    <div class="relative z-10 container-custom pt-28 pb-20 lg:pt-32 lg:pb-24">
      <div class="max-w-3xl mx-auto text-center">
        <div class="fade-in-up inline-flex items-center px-4 py-2 mb-6 bg-blue-100 text-blue-800 rounded-full text-sm font-medium">
          飞致云匠心出品
        </div>
        <h1 class="fade-in-up text-4xl md:text-5xl lg:text-6xl font-bold leading-tight mb-8" style="animation-delay: 0.2s;">
          <span class="block text-gray-800 mb-4">1Panel AI 编程一体机</span>
        </h1>
        <p class="fade-in-up text-xl sm:text-2xl text-gray-500 mb-10 leading-relaxed" style="animation-delay: 0.4s;">
          轻松满足 10-20 人的内网 AI 编程需求，彻底告别 Token 焦虑！
        </p>
        <div class="fade-in-up flex flex-col sm:flex-row gap-4 justify-center" style="animation-delay: 0.5s;">
          <a href="#contact" class="btn-primary text-lg px-8 py-4 inline-flex items-center justify-center">
            微信扫码咨询
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="section-padding bg-white border-t border-gray-100">
    <div class="container-custom">
      <div class="text-center mb-12">
        <h2 class="section-title text-4xl lg:text-5xl font-bold text-gray-800 mb-6">
          内网环境下的<span class="text-1panel-gradient">编程效率革命者</span>
        </h2>
        <p class="section-subtitle text-xl text-gray-600 max-w-3xl mx-auto leading-relaxed">
          面向政府/军工内网开发、金融级安全研发、能源/制造涉密项目、企业核心代码开发等需纯内网隔离的场景。
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8">
        {
          strengths.map((item) => (
            <div class="rounded-2xl bg-gray-100/80 border border-gray-100 p-6 lg:p-8 transition-all duration-200 hover:border-indigo-100 hover:shadow-md flex flex-col">
              <div class="flex items-center gap-3 mb-4">
                <span aria-hidden="true" class="flex-shrink-0 w-8 h-8 rounded-full bg-green-100 flex items-center justify-center text-green-600 font-bold text-sm">✓</span>
                <h3 class="text-lg font-bold text-gray-900">{item.title}</h3>
              </div>
              <p class="text-gray-600 leading-relaxed flex-1">{item.description}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section-padding bg-gradient-to-b from-gray-50 to-white">
    <div class="container-custom">
      <div class="text-center mb-11">
        <h2 class="text-4xl lg:text-5xl font-bold text-gray-800 mb-6">
          从算力底座到<span class="text-1panel-gradient">应用开发</span>
        </h2>
        <p class="text-xl text-gray-600 max-w-2xl mx-auto leading-relaxed">
          从算力底座、模型能力到 DevOps 工具链，一站式满足内网 AI 编程需求。
        </p>
      </div>

      <div class="rounded-3xl bg-white border border-gray-100 shadow-sm shadow-gray-200/60 overflow-hidden">
        <div class="grid grid-cols-1 lg:grid-cols-[280px_minmax(0,1fr)_280px] gap-0 p-7 sm:p-9">

          <!-- 左列：安全合规 -->
          <div class="flex flex-col pr-4 lg:pr-8">
            <div class="flex items-center gap-3 mb-6">
              <div class="w-11 h-11 rounded-xl bg-blue-50 flex items-center justify-center flex-shrink-0">
                <svg class="w-5 h-5 text-1panel" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
                </svg>
              </div>
              <h3 class="text-xl font-bold text-gray-900">安全合规</h3>
            </div>
            <ul class="space-y-4">
              <li class="flex items-start gap-2.5">
                <span class="flex-shrink-0 w-5 h-5 rounded-full bg-green-50 flex items-center justify-center mt-0.5">
                  <svg class="w-3 h-3 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path>
                  </svg>
                </span>
                <span class="text-gray-600 leading-relaxed">100% 纯内网私有化部署；</span>
              </li>
              <li class="flex items-start gap-2.5">
                <span class="flex-shrink-0 w-5 h-5 rounded-full bg-green-50 flex items-center justify-center mt-0.5">
                  <svg class="w-3 h-3 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path>
                  </svg>
                </span>
                <span class="text-gray-600 leading-relaxed">核心数据与代码不出域；</span>
              </li>
              <li class="flex items-start gap-2.5">
                <span class="flex-shrink-0 w-5 h-5 rounded-full bg-green-50 flex items-center justify-center mt-0.5">
                  <svg class="w-3 h-3 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path>
                  </svg>
                </span>
                <span class="text-gray-600 leading-relaxed">符合企业级安全审计标准。</span>
              </li>
            </ul>
          </div>

          <!-- 中列：架构图 -->
          <div class="border-x border-gray-100 px-4 lg:px-8 flex flex-col items-center">
            <div class="w-full bg-gray-50/80 rounded-2xl px-4 sm:px-6 py-5">
              <!-- 12 按钮网格 -->
              <div class="grid grid-cols-4 gap-1.5 sm:gap-2 w-full mb-5">
                <span class="text-[11px] sm:text-xs text-center py-2 px-1 rounded-lg bg-gray-100 text-gray-800 font-medium border border-gray-200">AI代理</span>
                <span class="text-[11px] sm:text-xs text-center py-2 px-1 rounded-lg bg-gray-100 text-gray-800 font-medium border border-gray-200">模型部署</span>
                <span class="text-[11px] sm:text-xs text-center py-2 px-1 rounded-lg bg-gray-100 text-gray-800 font-medium border border-gray-200">开发工具</span>
                <span class="text-[11px] sm:text-xs text-center py-2 px-1 rounded-lg bg-gray-100 text-gray-800 font-medium border border-gray-200">资源监控</span>
                <span class="text-[11px] sm:text-xs text-center py-2 px-1 rounded-lg bg-gray-100 text-gray-800 font-medium border border-gray-200">席位管理</span>
                <span class="text-[11px] sm:text-xs text-center py-2 px-1 rounded-lg bg-gray-100 text-gray-800 font-medium border border-gray-200">模型维护</span>
                <span class="text-[11px] sm:text-xs text-center py-2 px-1 rounded-lg bg-gray-100 text-gray-800 font-medium border border-gray-200">DevOps工具</span>
                <span class="text-[11px] sm:text-xs text-center py-2 px-1 rounded-lg bg-gray-100 text-gray-800 font-medium border border-gray-200">快速建站</span>
                <span class="text-[11px] sm:text-xs text-center py-2 px-1 rounded-lg bg-gray-100 text-gray-800 font-medium border border-gray-200">用量统计</span>
                <span class="text-[11px] sm:text-xs text-center py-2 px-1 rounded-lg bg-gray-100 text-gray-800 font-medium border border-gray-200">模型性能测试</span>
                <span class="text-[11px] sm:text-xs text-center py-2 px-1 rounded-lg bg-gray-100 text-gray-800 font-medium border border-gray-200">环境运行时</span>
                <span class="text-[11px] sm:text-xs text-center py-2 px-1 rounded-lg bg-gray-100 text-gray-800 font-medium border border-gray-200">WAF和备份</span>
              </div>

              <!-- 4 个分类标签 -->
              <div class="grid grid-cols-4 gap-1.5 sm:gap-2 w-full mb-5">
                <span class="text-xs sm:text-sm text-center py-3 rounded-md bg-gray-200 text-gray-800 font-bold">AI网关</span>
                <span class="text-xs sm:text-sm text-center py-3 rounded-md bg-gray-200 text-gray-800 font-bold">模型管理</span>
                <span class="text-xs sm:text-sm text-center py-3 rounded-md bg-gray-200 text-gray-800 font-bold">开发者商店</span>
                <span class="text-xs sm:text-sm text-center py-3 rounded-md bg-gray-200 text-gray-800 font-bold">运维管理</span>
              </div>

              <!-- 1Panel 企业版 -->
              <div class="w-full py-3 mb-3 text-center">
                <span class="text-base sm:text-lg font-bold text-1panel">1Panel 企业版</span>
              </div>

              <!-- Qwen 3.6 27B -->
              <div class="w-full py-3 px-4 mb-3 bg-emerald-50/60 rounded-xl border border-emerald-100 flex items-center justify-center gap-2.5">
                <div class="w-7 h-7 rounded-md bg-purple-100 flex items-center justify-center flex-shrink-0">
                  <svg class="w-4 h-4 text-purple-600" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z"></path>
                  </svg>
                </div>
                <span class="text-sm font-bold text-purple-700">Qwen3.6-27B</span>
              </div>

              <!-- 算力底座 -->
              <div class="w-full py-3 px-4 bg-blue-50/60 rounded-xl border border-blue-100">
                <div class="flex items-center justify-center gap-2 sm:gap-3 mb-2 flex-wrap">
                  <span class="text-[11px] sm:text-xs px-3 py-1.5 rounded-lg bg-white border border-blue-200 text-blue-700 font-medium shadow-sm">Intel Arc Pro B70</span>
                  <span class="text-[11px] sm:text-xs px-3 py-1.5 rounded-lg bg-white border border-blue-200 text-blue-700 font-medium shadow-sm">NVIDIA RTX Pro 5000</span>
                </div>
                <p class="text-sm font-bold text-center text-blue-600">高性能算力底座</p>
              </div>
            </div>
          </div>

          <!-- 右列：高效运维 -->
          <div class="flex flex-col pl-4 lg:pl-8">
            <div class="flex items-center gap-3 mb-6">
              <div class="w-11 h-11 rounded-xl bg-orange-50 flex items-center justify-center flex-shrink-0">
                <svg class="w-5 h-5 text-orange-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                </svg>
              </div>
              <h3 class="text-xl font-bold text-gray-900">高效运维</h3>
            </div>
            <ul class="space-y-4">
              <li class="flex items-start gap-2.5">
                <span class="flex-shrink-0 w-5 h-5 rounded-full bg-green-50 flex items-center justify-center mt-0.5">
                  <svg class="w-3 h-3 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path>
                  </svg>
                </span>
                <span class="text-gray-600 leading-relaxed">开箱即用，分钟级部署；</span>
              </li>
              <li class="flex items-start gap-2.5">
                <span class="flex-shrink-0 w-5 h-5 rounded-full bg-green-50 flex items-center justify-center mt-0.5">
                  <svg class="w-3 h-3 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path>
                  </svg>
                </span>
                <span class="text-gray-600 leading-relaxed">全图形化界面，易于管理；</span>
              </li>
              <li class="flex items-start gap-2.5">
                <span class="flex-shrink-0 w-5 h-5 rounded-full bg-green-50 flex items-center justify-center mt-0.5">
                  <svg class="w-3 h-3 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path>
                  </svg>
                </span>
                <span class="text-gray-600 leading-relaxed">彻底告别 Token 焦虑。</span>
              </li>
            </ul>
          </div>

        </div>

        <!-- 底部蓝色条 -->
        <div class="bg-1panel-gradient py-7 text-center">
          <h2 class="text-2xl sm:text-3xl font-bold text-white tracking-wide">软硬协同 · 全栈赋能</h2>
        </div>
      </div>
    </div>
  </section>

  <section id="capability" class="section-padding bg-white border-t border-gray-100">
    <div class="container-custom">
      <div class="text-center mb-12">
        <h2 class="section-title text-4xl lg:text-5xl font-bold text-gray-800 mb-6">AI 编程能力</h2>
        <p class="section-subtitle text-xl text-gray-600 max-w-3xl mx-auto leading-relaxed">
          Qwen3.6-27B 在多方面领先 Qwen3.5-397B-A17B，接近 Claude 4.5 Opus 的水平。
        </p>
      </div>

      <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
        {
          benchmarkHighlights.map((item) => (
            <div class="rounded-xl bg-gray-50 border border-gray-100 p-5 text-center">
              <div class="text-3xl font-bold text-1panel mb-2">{item.value}</div>
              <div class="text-sm text-gray-600">{item.label}</div>
            </div>
          ))
        }
      </div>

      <div class="rounded-2xl border border-gray-100 bg-white shadow-sm shadow-gray-200/60 overflow-x-auto">
        <table class="min-w-[760px] w-full border-collapse text-left">
          <thead>
            <tr class="bg-gray-50 text-sm text-gray-500">
              <th class="px-5 py-4 font-semibold">Coding Agent</th>
              <th class="px-5 py-4 font-semibold text-center">Qwen3.5-397B-A17B</th>
              <th class="px-5 py-4 font-semibold text-center">Claude 4.5 Opus</th>
              <th class="px-5 py-4 font-semibold text-center text-1panel">Qwen3.6-27B</th>
            </tr>
          </thead>
          <tbody>
            {
              benchmarkRows.map((row) => (
                <tr class="border-t border-gray-100 text-sm text-gray-700">
                  <td class="px-5 py-4 font-medium text-gray-900">{row.metric}</td>
                  <td class="px-5 py-4 text-center">{row.qwen35}</td>
                  <td class="px-5 py-4 text-center">{row.claude}</td>
                  <td class="px-5 py-4 text-center font-semibold text-gray-900">{row.qwen36}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section id="contact" class="section-padding bg-white">
    <div class="container-custom">
      <div class="rounded-2xl border border-gray-100 bg-indigo-50/40 p-8 shadow-lg flex flex-col md:flex-row gap-6 md:gap-0 md:items-center md:justify-center">
        <div class="flex flex-col items-center md:items-end md:pr-12 flex-1 md:max-w-[420px]">
          <div class="mb-5 flex items-center gap-3">
            <div class="flex h-11 w-11 items-center justify-center rounded-lg bg-indigo-50 text-indigo-600">
              <Icon name="carbon:purchase" class="h-6 w-6" />
            </div>
            <h2 class="text-3xl lg:text-4xl font-bold text-gray-900">限时特惠价格</h2>
          </div>
          <div class="flex flex-wrap items-end justify-center md:justify-end gap-3 mb-5">
            <span class="text-5xl font-bold text-gray-900">￥11.9万</span>
            <span class="pb-2 text-lg text-gray-500">含一年软硬件维保</span>
          </div>
          <p class="text-lg text-gray-600 leading-relaxed text-center md:text-right">
            通过微信扫码咨询，获取 AI Coding 一体机的详细性能参数与采购信息。
          </p>
        </div>

        <div class="hidden md:block h-36 w-px bg-gray-200 mx-12"></div>

        <div class="flex flex-col items-center flex-1 md:max-w-[320px]">
          <img
            src="/images/wecom-qrcode.png"
            alt="微信扫码咨询"
            class="w-32 h-32 rounded-lg border border-gray-200 shadow-sm bg-white p-2 mb-2"
            loading="lazy"
          />
          <p class="text-base font-semibold text-gray-800 text-center">微信扫码获取官方评测数据</p>
        </div>
      </div>
    </div>
  </section>
</main>
