---
import { Icon } from 'astro-icon/components';
import { t } from '../i18n/utils';
import type { TranslationDict } from '../i18n/utils';

interface Props {
  translations: TranslationDict;
  lang?: string;
  basePath?: string;
}

const { translations, lang = 'en', basePath = './' } = Astro.props;

const strengths = [
  {
    title: t(translations, 'aiAppliance.strengthEffortlessTitle'),
    description: t(translations, 'aiAppliance.strengthEffortlessDesc'),
    icon: "carbon:user-follow",
    tone: "text-amber-600",
    iconBg: "bg-amber-50",
    border: "hover:border-amber-100",
  },
  {
    title: t(translations, 'aiAppliance.strengthSecureTitle'),
    description: t(translations, 'aiAppliance.strengthSecureDesc'),
    icon: "carbon:security",
    tone: "text-emerald-600",
    iconBg: "bg-emerald-50",
    border: "hover:border-emerald-100",
  },
  {
    title: t(translations, 'aiAppliance.strengthFastTitle'),
    description: t(translations, 'aiAppliance.strengthFastDesc'),
    icon: "carbon:flash",
    tone: "text-blue-600",
    iconBg: "bg-blue-50",
    border: "hover:border-blue-100",
  },
  {
    title: t(translations, 'aiAppliance.strengthVersatileTitle'),
    description: t(translations, 'aiAppliance.strengthVersatileDesc'),
    icon: "carbon:ibm-watson-machine-learning",
    tone: "text-violet-600",
    iconBg: "bg-violet-50",
    border: "hover:border-violet-100",
  },
];

const securityPoints = [
  t(translations, 'aiAppliance.securityPoint1'),
  t(translations, 'aiAppliance.securityPoint2'),
  t(translations, 'aiAppliance.securityPoint3'),
];

const operationPoints = [
  t(translations, 'aiAppliance.operationPoint1'),
  t(translations, 'aiAppliance.operationPoint2'),
  t(translations, 'aiAppliance.operationPoint3'),
];

const architectureTilesRaw = (translations as Record<string, any>).aiAppliance?.architectureTiles;
const architectureTiles: string[] = Array.isArray(architectureTilesRaw)
  ? architectureTilesRaw
  : ['AI Agents', 'Model Deploy', 'AI Knowledge Base', 'Resource Monitor', 'Seat Management', 'Model Maintenance', 'AI Workflows', 'VM Management', 'Usage Stats', 'Model Benchmark', 'AI Coding', 'WAF & Backup', 'Smart Routing', 'Model Download', 'AI Office', 'Ops Reports'];

const architectureModulesRaw = (translations as Record<string, any>).aiAppliance?.architectureModules;
const architectureModules: string[] = Array.isArray(architectureModulesRaw)
  ? architectureModulesRaw
  : ['AI Gateway', 'Model Mgmt', 'AI Apps', 'Ops Mgmt'];

const salesMailto = 'mailto:sales@lxware.hk?subject=' + encodeURIComponent('1Panel AI General Appliance Inquiry');
---

<main class="relative z-10 bg-white text-gray-800">
  <section class="relative overflow-hidden bg-gradient-to-b from-blue-50/80 via-white to-white pt-24 pb-14 lg:pt-28 lg:pb-16">
    <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-blue-200 to-transparent"></div>
    <div class="relative z-10 container-custom">
      <div class="max-w-4xl mx-auto text-center">
        <div class="fade-in-up inline-flex items-center px-4 py-2 mb-6 rounded-full border border-blue-100 bg-white text-blue-800 shadow-sm text-sm font-semibold">
          {t(translations, 'aiAppliance.badge')}
        </div>
        <h1 class="fade-in-up text-4xl md:text-5xl lg:text-6xl font-bold leading-tight tracking-normal mb-8" style="animation-delay: 0.2s;">
          <span class="block text-gray-950 mb-4">{t(translations, 'aiAppliance.title')}</span>
        </h1>
        <p class="fade-in-up text-xl sm:text-2xl text-gray-600 mb-10 leading-relaxed" style="animation-delay: 0.4s;">
          {t(translations, 'aiAppliance.subtitle')}
        </p>
        <div class="fade-in-up flex flex-col sm:flex-row gap-4 justify-center" style="animation-delay: 0.5s;">
          <a href={salesMailto} class="btn-primary text-lg px-8 py-4 inline-flex items-center justify-center">
            {t(translations, 'aiAppliance.heroCta')}
            <Icon name="carbon:email" class="ml-2 h-5 w-5" />
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="section-padding bg-white border-t border-gray-100">
    <div class="container-custom">
      <div class="text-center mb-12">
        <h2 class="section-title text-4xl lg:text-5xl font-bold text-gray-800 mb-6">
          {t(translations, 'aiAppliance.section2Title')} <span class="text-1panel-gradient">{t(translations, 'aiAppliance.section2TitleHighlight')}</span> {t(translations, 'aiAppliance.section2TitleSuffix')}
        </h2>
        <p class="section-subtitle text-xl text-gray-600 max-w-4xl mx-auto leading-relaxed">
          {t(translations, 'aiAppliance.section2Subtitle')}
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8">
        {
          strengths.map((item, index) => (
            <article class={`fade-in-up rounded-lg bg-white border border-gray-100 p-6 lg:p-8 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-xl ${item.border} flex flex-col`} style={`animation-delay: ${index * 0.05}s;`}>
              <div class="flex items-center gap-3 mb-4">
                <span aria-hidden="true" class={`flex-shrink-0 w-11 h-11 rounded-lg ${item.iconBg} ${item.tone} flex items-center justify-center`}>
                  <Icon name={item.icon} class="h-5 w-5" />
                </span>
                <h3 class="text-lg font-bold text-gray-900">{item.title}</h3>
              </div>
              <p class="text-gray-600 leading-relaxed flex-1">{item.description}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section-padding bg-gradient-to-b from-gray-50 to-white">
    <div class="container-custom">
      <div class="text-center mb-11">
        <h2 class="text-4xl lg:text-5xl font-bold text-gray-800 mb-6">
          {t(translations, 'aiAppliance.section3Title')} <span class="text-1panel-gradient">{t(translations, 'aiAppliance.section3TitleHighlight')}</span>
        </h2>
        <p class="text-xl text-gray-600 max-w-4xl mx-auto leading-relaxed">
          {t(translations, 'aiAppliance.section3Subtitle')}
        </p>
      </div>

      <div class="overflow-hidden rounded-lg border border-blue-100 bg-white shadow-2xl shadow-blue-100/50">
        <div class="grid grid-cols-1 gap-8 p-6 sm:p-8 lg:grid-cols-[280px_minmax(0,1fr)_280px] lg:gap-0 lg:p-9">
          <div class="flex flex-col lg:pr-8">
            <div class="flex items-center gap-3 mb-6">
              <div class="w-11 h-11 rounded-lg bg-blue-50 flex items-center justify-center flex-shrink-0 text-1panel">
                <Icon name="carbon:security" class="h-5 w-5" />
              </div>
              <h3 class="text-xl font-bold text-gray-900">{t(translations, 'aiAppliance.secureCompliant')}</h3>
            </div>
            <ul class="space-y-4">
              {securityPoints.map((point) => (
                <li class="flex items-start gap-2.5">
                  <span class="mt-0.5 flex h-5 w-5 flex-shrink-0 items-center justify-center rounded-full bg-emerald-50 text-emerald-500">
                    <Icon name="carbon:checkmark" class="h-3.5 w-3.5" />
                  </span>
                  <span class="text-gray-600 leading-relaxed">{point}</span>
                </li>
              ))}
            </ul>
          </div>

          <div class="flex flex-col items-center border-y border-gray-100 py-8 lg:border-x lg:border-y-0 lg:px-8 lg:py-0">
            <div class="w-full rounded-lg border border-gray-100 bg-gray-50/80 px-4 py-5 sm:px-6">
              <div class="grid grid-cols-4 gap-1.5 sm:gap-2 w-full mb-5">
                {architectureTiles.map((tile) => (
                  <span class="flex min-h-10 items-center justify-center rounded-md border border-gray-200 bg-white px-1 py-2 text-center text-[11px] font-medium leading-snug text-gray-800 shadow-sm sm:text-xs">{tile}</span>
                ))}
              </div>

              <div class="grid grid-cols-4 gap-1.5 sm:gap-2 w-full mb-5">
                {architectureModules.map((module) => (
                  <span class="rounded-md bg-blue-50 px-1 py-3 text-center text-xs font-bold leading-snug text-1panel ring-1 ring-blue-100 sm:text-sm">{module}</span>
                ))}
              </div>

              <div class="w-full rounded-md bg-white py-3 mb-3 text-center shadow-sm ring-1 ring-gray-100">
                <span class="text-base sm:text-lg font-bold text-1panel">{t(translations, 'aiAppliance.panelEnterprise')}</span>
              </div>

              <div class="w-full py-3 px-4 mb-3 bg-blue-50/80 rounded-md border border-blue-100 flex items-center justify-center gap-2.5">
                <span class="h-8 w-11 overflow-hidden flex-shrink-0" aria-hidden="true">
                  <img
                    src="/images/enterprise-deepseek.png"
                    alt=""
                    class="h-8 w-auto max-w-none"
                  />
                </span>
                <span class="text-sm sm:text-base font-bold text-1panel">{t(translations, 'aiAppliance.panelModel')}</span>
              </div>

              <div class="w-full py-3 px-4 bg-blue-50/70 rounded-md border border-blue-100">
                <div class="flex items-center justify-center mb-2">
                  <span class="rounded-md border border-blue-200 bg-white px-3 py-1.5 text-[11px] font-medium text-blue-700 shadow-sm sm:text-xs">{t(translations, 'aiAppliance.panelGpu')}</span>
                </div>
                <p class="text-sm font-bold text-center text-blue-600">{t(translations, 'aiAppliance.panelComputeBase')}</p>
              </div>
            </div>
          </div>

          <div class="flex flex-col lg:pl-8">
            <div class="flex items-center gap-3 mb-6">
              <div class="w-11 h-11 rounded-lg bg-amber-50 flex items-center justify-center flex-shrink-0 text-amber-600">
                <Icon name="carbon:flash" class="h-5 w-5" />
              </div>
              <h3 class="text-xl font-bold text-gray-900">{t(translations, 'aiAppliance.efficientOps')}</h3>
            </div>
            <ul class="space-y-4">
              {operationPoints.map((point) => (
                <li class="flex items-start gap-2.5">
                  <span class="mt-0.5 flex h-5 w-5 flex-shrink-0 items-center justify-center rounded-full bg-emerald-50 text-emerald-500">
                    <Icon name="carbon:checkmark" class="h-3.5 w-3.5" />
                  </span>
                  <span class="text-gray-600 leading-relaxed">{point}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>

        <div class="bg-1panel-gradient py-7 text-center">
          <h2 class="text-2xl sm:text-3xl font-bold text-white tracking-wide">{t(translations, 'aiAppliance.bannerText')}</h2>
        </div>
      </div>
    </div>
  </section>

  <section id="pricing" class="section-padding bg-white">
    <div class="container-custom">
      <div class="text-center mb-16">
        <h2 class="section-title text-4xl lg:text-5xl font-bold text-gray-800">
          <span class="text-1panel-gradient">{t(translations, 'aiAppliance.applianceDetails')}</span>
        </h2>
      </div>

      <div class="flex flex-col md:flex-row md:justify-between gap-6 mb-12">
        <div class="flex-1 flex flex-col items-center text-center rounded-2xl border-2 border-indigo-100 bg-white p-6 shadow hover:border-indigo-200 transition min-w-[220px]">
          <div class="w-14 h-14 mb-4 rounded-xl bg-indigo-50 flex items-center justify-center text-indigo-600 font-bold text-xl">
            {t(translations, 'aiAppliance.hwLabel')}
          </div>
          <h3 class="text-lg font-bold text-gray-900 mb-2">{t(translations, 'aiAppliance.hwTitle')}</h3>
          <p class="text-sm text-gray-500 mb-1">{t(translations, 'aiAppliance.hwDesc1')}</p>
          <p class="text-sm text-gray-500 mb-1">{t(translations, 'aiAppliance.hwDesc2')}</p>
        </div>

        <div class="flex-1 flex flex-col items-center text-center rounded-2xl border-2 border-indigo-100 bg-white p-6 shadow hover:border-indigo-200 transition min-w-[220px]">
          <div class="w-14 h-14 mb-4 rounded-xl bg-indigo-50 flex items-center justify-center text-indigo-600 font-bold text-xl">
            {t(translations, 'aiAppliance.swLabel')}
          </div>
          <p class="text-lg font-bold text-gray-900 mb-2">{t(translations, 'aiAppliance.swTitle')}</p>
          <p class="text-sm text-gray-500 mb-1">
            <a href="/enterprise" class="inline-flex items-center hover:underline">
              <span>{t(translations, 'aiAppliance.swDesc1')}</span>
              <Icon name="carbon:arrow-right" class="ml-1 h-3.5 w-3.5" />
            </a>
          </p>
          <p class="text-sm text-gray-500">
            <span>{t(translations, 'aiAppliance.swDesc2')}</span>
          </p>
        </div>

        <div class="flex-1 flex flex-col items-center text-center rounded-2xl border-2 border-purple-100 bg-white p-6 shadow hover:border-purple-200 transition min-w-[220px]">
          <div class="w-14 h-14 mb-4 rounded-xl bg-purple-50 flex items-center justify-center text-purple-600 font-bold text-xl">
            {t(translations, 'aiAppliance.svcLabel')}
          </div>
          <h3 class="text-lg font-bold text-gray-900 mb-2">{t(translations, 'aiAppliance.svcTitle')}</h3>
          <p class="text-sm text-gray-500 mb-1">{t(translations, 'aiAppliance.svcDesc1')}</p>
          <p class="text-sm text-gray-500 mb-1">{t(translations, 'aiAppliance.svcDesc2')}</p>
        </div>
      </div>

      <div class="rounded-2xl border border-gray-100 bg-indigo-50/40 p-8 shadow-lg text-center">
        <h3 class="text-2xl font-bold text-gray-900 mb-4">{t(translations, 'aiAppliance.ctaTitle')}</h3>
        <p class="text-lg text-gray-600 mb-8 max-w-2xl mx-auto">
          {t(translations, 'aiAppliance.ctaDesc')}
        </p>
        <a
          href={salesMailto}
          class="btn-primary inline-flex items-center justify-center rounded-lg px-10 py-4 text-lg font-semibold shadow-lg shadow-indigo-500/25 transition hover:shadow-xl hover:shadow-indigo-500/30"
        >
          {t(translations, 'aiAppliance.ctaButton')}
          <Icon name="carbon:email" class="ml-2 h-5 w-5" />
        </a>
      </div>
    </div>
  </section>
</main>
