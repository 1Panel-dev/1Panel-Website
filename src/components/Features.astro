---
// Features section for 1Panel website — compact 4-card layout
import { Icon } from 'astro-icon/components'
import { t, getTranslations } from '../i18n/utils';
import type { TranslationDict } from '../i18n/utils';

interface Props {
  lang?: string;
  basePath?: string;
  translations?: TranslationDict;
}

const { basePath = './', translations: rawTranslations } = Astro.props;
const translations = rawTranslations && Object.keys(rawTranslations || {}).length > 0 ? rawTranslations! : getTranslations('en');

// 4 feature cards in 2x2 grid
const cards = [
  {
    key: 'ai',
    icon: 'carbon:ai',
  },
  {
    key: 'ops',
    icon: 'mdi:chart-bar',
  },
  {
    key: 'site',
    icon: 'mdi:rocket-launch',
  },
  {
    key: 'security',
    icon: 'carbon:security',
  },
] as const;
---

<section id="features" class="section-padding bg-gradient-to-br from-gray-50 to-white">
  <div class="container-custom">
    <!-- Section Header -->
    <div class="text-center mb-16">
      <h2 class="fade-in-up text-4xl lg:text-5xl font-bold text-gray-800 mb-6">
        {t(translations, 'features.title')}
        <span class="text-1panel-gradient">{t(translations, 'features.titleHighlight')}</span>
      </h2>
      <p class="fade-in-up text-xl text-gray-600 max-w-3xl mx-auto" style="animation-delay: 0.2s;">
        {t(translations, 'features.subtitle')}
      </p>
    </div>

    <!-- 4 Feature Cards in 2x2 Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {cards.map((card, index) => (
        <div class="fade-in-up card group hover:scale-105 transition-transform duration-300" style={`animation-delay: ${0.1 + index * 0.1}s;`}>
          <div class="flex items-start space-x-4">
            <div class="w-16 h-16 rounded-xl flex items-center justify-center bg-1panel-gradient group-hover:scale-110 transition-transform duration-300 flex-shrink-0">
              <Icon name={card.icon} class="w-8 h-8 text-white" />
            </div>
            <div class="flex-1">
              <h3 class="text-xl font-bold text-gray-800 mb-2">
                {t(translations, `features.cards.${card.key}.title`)}
              </h3>
              <p class="text-gray-600 leading-relaxed">
                {t(translations, `features.cards.${card.key}.desc`)}
              </p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  @keyframes pulse {
    0%, 100% {
      opacity: 0.3;
      transform: scale(1);
    }
    50% {
      opacity: 0.6;
      transform: scale(1.1);
    }
  }

  .animate-pulse {
    animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
  }
</style>
