---
// Features section for 1Panel website
import { Icon } from 'astro-icon/components'

const features = [
  {
    title: '全栈 AI 管理',
    description:
      '提供从底层硬件到智能体（Metal-to-Agent）的统一管理平台，集成 AI 门户、AI 网关、Skills Hub，并支持对智能体与模型的集中化管理。',
    icon: 'carbon:machine-learning-model',
  },
  {
    title: '高效可视化运维',
    description:
      '通过 Web 图形界面，轻松实现主机监控、文件管理、数据库管理、容器管理等功能，让 Linux 服务器管理化繁为简。',
    icon: 'carbon:dashboard',
  },
  {
    title: '快速建站部署',
    description:
      '深度集成 WordPress 与 Halo 等主流建站程序，一键完成域名绑定、SSL 证书配置，大幅降低建站门槛。',
    icon: 'carbon:rocket',
  },
  {
    title: '企业级安全和备份',
    description:
      '提供 WAF 防火墙、日志审计等安全功能，全方位保障服务器安全；支持一键备份与恢复，并可对接多种云端存储，确保数据安全，永不丢失。',
    icon: 'carbon:security',
  },
]
---

<section
  id="features"
  class="section-padding bg-gradient-to-br from-gray-50 to-white"
>
  <div class="container-custom">
    <!-- Section Header -->
    <div class="text-center mb-16 lg:mb-20">
      <h2 class="fade-in-up text-4xl lg:text-5xl font-bold text-gray-800 mb-6">
        强大的
        <span class="text-1panel-gradient">功能特性</span>
      </h2>
      <p
        class="fade-in-up text-xl text-gray-600 max-w-3xl mx-auto"
        style="animation-delay: 0.2s;"
      >
        1Panel 是一款现代化的开源 Linux 服务器运维管理面板，也是轻量级的 AI 管理平台。
      </p>
    </div>

    <!-- Feature Cards Grid: 2 rows x 3 columns -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-6xl mx-auto">
      {
        features.map((feature, i) => (
          <div
            class="fade-in-up card group hover:scale-[1.03] transition-transform duration-300"
            style={`animation-delay: ${(i + 1) * 0.1}s;`}
          >
            <!-- Icon -->
            <div
              class="w-16 h-16 rounded-xl flex items-center justify-center bg-1panel-gradient group-hover:scale-110 transition-transform duration-300 mb-6"
            >
              <Icon name={feature.icon} class="w-8 h-8 text-white" />
            </div>
            <!-- Title -->
            <h3 class="text-xl font-bold text-gray-800 mb-3">
              {feature.title}
            </h3>
            <!-- Description -->
            <p class="text-gray-600 leading-relaxed">
              {feature.description}
            </p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('animate')
          }
        })
      },
      { threshold: 0.1 },
    )

    document
      .querySelectorAll('.fade-in-up, .fade-in-left, .fade-in-right')
      .forEach((el) => observer.observe(el))
  })
</script>
