---
import Statistics from '../Statistics.astro';
import Header from '../Header.astro';
import Footer from '../Footer.astro';
import Layout from '../../layouts/Layout.astro';
import type { ComparisonSeoConfig } from '../../lib/comparisonSeo';
import '../../styles/global.css';
import '../../styles/comparisons.css';

interface Props {
  seo: ComparisonSeoConfig;
}

const { seo } = Astro.props;
---

<Layout
  title={seo.title}
  socialTitle={seo.title}
  schemaName={seo.title}
  description={seo.description}
  canonical={seo.canonical}
  keywords={seo.keywords}
  image={seo.image}
  imageAlt={seo.imageAlt}
  ogType={seo.ogType}
  publishedTime={seo.publishedTime}
  modifiedTime={seo.modifiedTime}
  section="产品对比"
  tags={seo.keywords}
  structuredData={seo.structuredData}
>
  <Statistics slot="head" />
  <Fragment slot="main">
    <Header />
    <slot />
    <section class="comparison-disclaimer border-b px-4 py-8 text-center">
      <p class="mx-auto max-w-5xl text-sm leading-relaxed">
        注：本白皮书由 1Panel 团队根据公开信息编写，我们尽力使其客观、公正。如果您发现错误或功能缺失，请电邮至 support@fit2cloud.com 我们将更新本文档。
        我们的目标是不断更新，尽可能做到准确无误。
      </p>
    </section>
    <Footer />
  </Fragment>
</Layout>
