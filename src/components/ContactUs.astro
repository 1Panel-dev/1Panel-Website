---

<section id="contact-us" class="relative py-16 lg:py-20" aria-labelledby="contact-us-title">
  <div class="container-custom">
    <div class="mx-auto max-w-3xl text-center">
      <div class="mx-auto mb-4 h-1 w-12 rounded-full bg-1panel"></div>
      <h2 id="contact-us-title" class="text-3xl font-bold tracking-normal text-gray-950 lg:text-4xl">联系我们</h2>
      <p class="mt-4 text-base leading-relaxed text-gray-500">无论您使用哪个版本，我们都在这里为您提供支持</p>
    </div>

    <div class="mt-10 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4">
      <article class="group flex h-full flex-col rounded-xl border border-white/80 bg-gradient-to-b from-white/80 via-white/55 to-blue-50/60 p-5 shadow-lg shadow-blue-900/5 ring-1 ring-blue-100/70 backdrop-blur transition-all duration-300 hover:-translate-y-1 hover:border-blue-200 hover:shadow-xl hover:shadow-blue-900/10 lg:p-6">
        <div class="flex items-center gap-3 border-b border-blue-100/70 pb-4">
          <div class="flex h-11 w-11 flex-shrink-0 items-center justify-center rounded-lg bg-white/80 text-1panel ring-1 ring-blue-100 transition-colors duration-300 group-hover:bg-1panel group-hover:text-white">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={iconPaths.qr} />
            </svg>
          </div>
          <h3 class="w-[100px] whitespace-nowrap text-xl font-bold text-gray-950">技术交流群</h3>
        </div>

        <div class="relative flex min-h-48 flex-1 items-center justify-start overflow-hidden pl-14 pt-4">
          <div aria-hidden="true" class="community-qr-pattern pointer-events-none absolute inset-0"></div>
          <div aria-hidden="true" class="pointer-events-none absolute left-3 top-1/2 flex -translate-y-1/2 items-center">
            <span class="h-2 w-2 rounded-full bg-blue-300/80 shadow-sm shadow-blue-500/30"></span>
            <span class="h-px w-8 bg-gradient-to-r from-blue-300/70 to-transparent"></span>
          </div>
          <div aria-hidden="true" class="pointer-events-none absolute right-3 top-1/2 flex -translate-y-1/2 items-center">
            <span class="h-px w-8 bg-gradient-to-l from-blue-300/70 to-transparent"></span>
            <span class="h-2 w-2 rounded-full bg-blue-300/80 shadow-sm shadow-blue-500/30"></span>
          </div>
          <span aria-hidden="true" class="pointer-events-none absolute left-5 top-7 h-1.5 w-1.5 rounded-full bg-blue-200"></span>
          <span aria-hidden="true" class="pointer-events-none absolute right-6 top-9 h-2 w-2 rounded-full bg-blue-200/80"></span>
          <span aria-hidden="true" class="pointer-events-none absolute bottom-7 left-7 h-2 w-2 rounded-full bg-blue-200/80"></span>
          <span aria-hidden="true" class="pointer-events-none absolute bottom-9 right-5 h-1.5 w-1.5 rounded-full bg-blue-200"></span>
          <a
            href={communityQrCode}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="查看 1Panel 技术交流群二维码原图"
            class="relative z-10 block transition-transform duration-300 hover:scale-[1.03] focus:outline-none focus-visible:ring-2 focus-visible:ring-[#005eeb] focus-visible:ring-offset-4"
          >
            <img
              src={communityQrCode}
              width="300"
              height="300"
              alt="微信扫码加入 1Panel 技术交流群"
              loading="lazy"
              decoding="async"
              class="h-[100px] w-[100px]"
            />
          </a>
        </div>
      </article>

      {
        contactGroups.map((group) => (
          <article class="group flex h-full flex-col rounded-xl border border-white/80 bg-gradient-to-b from-white/80 via-white/55 to-blue-50/60 p-5 shadow-lg shadow-blue-900/5 ring-1 ring-blue-100/70 backdrop-blur transition-all duration-300 hover:-translate-y-1 hover:border-blue-200 hover:shadow-xl hover:shadow-blue-900/10 lg:p-6">
            <div class="flex items-center gap-3 border-b border-blue-100/70 pb-4">
              <div class="flex h-11 w-11 flex-shrink-0 items-center justify-center rounded-lg bg-white/80 text-1panel ring-1 ring-blue-100 transition-colors duration-300 group-hover:bg-1panel group-hover:text-white">
                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={iconPaths[group.icon]} />
                </svg>
              </div>
              <h3 class="text-xl font-bold text-gray-950">{group.title}</h3>
            </div>

            <ul class="mt-4 flex flex-1 flex-col gap-2 rounded-lg bg-white/30 p-2 ring-1 ring-white/60">
              {group.items.map((item) => {
                const content = (
                  <>
                    <span class="flex h-8 w-8 flex-shrink-0 items-center justify-center rounded-md bg-white/70 text-gray-500 transition-colors duration-300 group-hover/link:bg-white group-hover/link:text-1panel">
                      <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={iconPaths[item.icon]} />
                      </svg>
                    </span>
                    <span class={`${item.strong ? "font-semibold text-1panel" : "font-medium text-gray-600 transition-colors duration-300 group-hover/link:text-1panel"}`}>
                      {item.label}
                    </span>
                  </>
                );

                return (
                  <li>
                    {item.href ? (
                      <a
                        href={item.href}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="group/link flex min-h-12 items-center gap-3 rounded-md px-2.5 py-2 transition-colors duration-300 hover:bg-white/90"
                      >
                        {content}
                      </a>
                    ) : (
                      <span class="flex min-h-12 items-center gap-3 rounded-md px-2.5 py-2">
                        {content}
                      </span>
                    )}
                  </li>
                );
              })}
            </ul>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .community-qr-pattern {
    background-image: radial-gradient(circle at 1px 1px, rgb(0 94 235 / 0.2) 1px, transparent 0);
    background-size: 15px 15px;
    opacity: 0.65;
    -webkit-mask-image: radial-gradient(ellipse at center, #000 0%, transparent 72%);
    mask-image: radial-gradient(ellipse at center, #000 0%, transparent 72%);
  }
</style>
