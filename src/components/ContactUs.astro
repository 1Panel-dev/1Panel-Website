---

<section id="contact-us" class="relative py-16 lg:py-20">
  <div class="container-custom">
    <div class="mx-auto max-w-3xl text-center">
      <div class="mx-auto mb-4 h-1 w-12 rounded-full bg-1panel"></div>
      <h2 class="text-3xl font-bold tracking-normal text-gray-950 lg:text-4xl">联系我们</h2>
      <p class="mt-4 text-base leading-relaxed text-gray-500">无论您使用哪个版本，我们都在这里为您提供支持</p>
    </div>

    <div class="mt-10 overflow-hidden rounded-lg border border-white/70 bg-white/50 shadow-xl shadow-blue-900/10 ring-1 ring-blue-100/70 backdrop-blur">
      <div class="grid grid-cols-1 divide-y divide-blue-100/80 md:grid-cols-3 md:divide-x md:divide-y-0">
        {
          contactGroups.map((group) => (
            <article class="group flex h-full flex-col bg-gradient-to-b from-white/70 via-white/45 to-blue-50/50 p-6 transition-colors duration-300 hover:bg-white/65 lg:p-7">
              <div class="flex items-center gap-3 border-b border-blue-100/70 pb-5">
                <div class="flex h-11 w-11 flex-shrink-0 items-center justify-center rounded-lg bg-white/80 text-1panel ring-1 ring-blue-100 transition-colors duration-300 group-hover:bg-1panel group-hover:text-white">
                  <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={iconPaths[group.icon]} />
                  </svg>
                </div>
                <h3 class="text-xl font-bold text-gray-950">{group.title}</h3>
              </div>

              <ul class="mt-5 flex flex-1 flex-col gap-2 rounded-lg bg-white/25 p-2 ring-1 ring-white/50">
                {group.items.map((item) => {
                  const content = (
                    <>
                      <span class="flex h-8 w-8 flex-shrink-0 items-center justify-center rounded-md bg-white/65 text-gray-500 transition-colors duration-300 group-hover/link:bg-white group-hover/link:text-1panel">
                        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={iconPaths[item.icon]} />
                        </svg>
                      </span>
                      <span class={`${item.strong ? "font-semibold text-1panel" : "font-medium text-gray-600 transition-colors duration-300 group-hover/link:text-1panel"}`}>
                        {item.label}
                      </span>
                    </>
                  );

                  return (
                    <li>
                      {item.href ? (
                        <a
                          href={item.href}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="group/link flex min-h-12 items-center gap-3 rounded-md px-2.5 py-2 transition-colors duration-300 hover:bg-white/80"
                        >
                          {content}
                        </a>
                      ) : (
                        <span class="flex min-h-12 items-center gap-3 rounded-md px-2.5 py-2">
                          {content}
                        </span>
                      )}
                    </li>
                  );
                })}
              </ul>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>
