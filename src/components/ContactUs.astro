---
// ContactUs component - displayed above Footer on every page
---

<section class="bg-white border-t border-gray-100 py-16">
  <div class="container-custom">
    <!-- Section Title -->
    <div class="text-center mb-12">
      <h2 class="text-3xl font-bold text-gray-900 mb-3">联系我们</h2>
      <p class="text-gray-500">无论您使用哪个版本，我们都在这里为您提供支持</p>
    </div>

    <!-- Three Columns -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-10 lg:gap-14">
      <!-- Column 1: Community Edition -->
      <div>
        <div class="flex items-center space-x-2 mb-6">
          <div class="w-10 h-10 rounded-lg bg-blue-50 flex items-center justify-center">
            <svg class="w-5 h-5 text-1panel" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"></path>
            </svg>
          </div>
          <h3 class="text-xl font-bold text-gray-900">社区版</h3>
        </div>
        <ul class="space-y-4">
          <li>
            <a href="https://github.com/1Panel-dev/1Panel" target="_blank" rel="noopener noreferrer"
               class="group flex items-center text-gray-600 hover:text-1panel transition-colors duration-300">
              <svg class="w-4 h-4 mr-2 flex-shrink-0 group-hover:text-1panel transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"></path>
              </svg>
              GitHub 地址
            </a>
          </li>
          <li>
            <a href="https://bbs.fit2cloud.com/c/1p/7" target="_blank" rel="noopener noreferrer"
               class="group flex items-center text-gray-600 hover:text-1panel transition-colors duration-300">
              <svg class="w-4 h-4 mr-2 flex-shrink-0 group-hover:text-1panel transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path>
              </svg>
              社区论坛
            </a>
          </li>
          <li>
            <a href="https://1panel.cn/docs/v2/" target="_blank" rel="noopener noreferrer"
               class="group flex items-center text-gray-600 hover:text-1panel transition-colors duration-300">
              <svg class="w-4 h-4 mr-2 flex-shrink-0 group-hover:text-1panel transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
              </svg>
              在线文档
            </a>
          </li>
        </ul>
      </div>

      <!-- Column 2: Professional Edition -->
      <div>
        <div class="flex items-center space-x-2 mb-6">
          <div class="w-10 h-10 rounded-lg bg-blue-50 flex items-center justify-center">
            <svg class="w-5 h-5 text-1panel" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
            </svg>
          </div>
          <h3 class="text-xl font-bold text-gray-900">专业版</h3>
        </div>
        <ul class="space-y-4">
          <li>
            <a href="https://www.lxware.cn/1panel" target="_blank" rel="noopener noreferrer"
               class="group flex items-center text-gray-600 hover:text-1panel transition-colors duration-300">
              <svg class="w-4 h-4 mr-2 flex-shrink-0 group-hover:text-1panel transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 100 4 2 2 0 000-4z"></path>
              </svg>
              购买地址
            </a>
          </li>
          <li>
            <a href="https://www.lxware.cn/categories/kb" target="_blank" rel="noopener noreferrer"
               class="group flex items-center text-gray-600 hover:text-1panel transition-colors duration-300">
              <svg class="w-4 h-4 mr-2 flex-shrink-0 group-hover:text-1panel transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
              </svg>
              帮助文档
            </a>
          </li>
          <li>
            <a href="https://space.bilibili.com/3493261769443630/lists/4275997" target="_blank" rel="noopener noreferrer"
               class="group flex items-center text-gray-600 hover:text-1panel transition-colors duration-300">
              <svg class="w-4 h-4 mr-2 flex-shrink-0 group-hover:text-1panel transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
              </svg>
              视频演示
            </a>
          </li>
        </ul>
      </div>

      <!-- Column 3: Enterprise Edition -->
      <div>
        <div class="flex items-center space-x-2 mb-6">
          <div class="w-10 h-10 rounded-lg bg-blue-50 flex items-center justify-center">
            <svg class="w-5 h-5 text-1panel" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
            </svg>
          </div>
          <h3 class="text-xl font-bold text-gray-900">企业版</h3>
        </div>
        <ul class="space-y-4">
          <li>
            <a href="https://fit2cloud.com/1panel/download/introduce-1panel_2026.pdf" target="_blank" rel="noopener noreferrer"
               class="group flex items-center text-gray-600 hover:text-1panel transition-colors duration-300">
              <svg class="w-4 h-4 mr-2 flex-shrink-0 group-hover:text-1panel transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
              </svg>
              产品资料
            </a>
          </li>
          <li>
            <span class="flex items-center text-gray-600">
              <svg class="w-4 h-4 mr-2 flex-shrink-0 text-1panel" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
              </svg>
              <strong class="ml-1 text-1panel font-semibold">400-052-0755</strong>
            </span>
          </li>
          <li>
            <a href="https://jsj.top/f/umuYtv" target="_blank" rel="noopener noreferrer"
               class="group flex items-center text-gray-600 hover:text-1panel transition-colors duration-300">
              <svg class="w-4 h-4 mr-2 flex-shrink-0 group-hover:text-1panel transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
              </svg>
              申请试用
            </a>
          </li>
        </ul>
      </div>
    </div>
  </div>
</section>
